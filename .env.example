# ==============================================================================
# REMBRANDT STUDIO · VARIABLES DE ENTORNO
# ==============================================================================

# Clave de Web3Forms para recepción de formularios (https://web3forms.com)
# Opcional en desarrollo local: si está vacía, el formulario canaliza vía mailto directo.
PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4 Measurement ID (ej: G-XXXXXXXXXX)
# Opcional: solo se carga si se configura un ID y el usuario otorga consentimiento expreso.
PUBLIC_GA_ID=

# ------------------------------------------------------------------------------
# Avisos a Farid por WhatsApp (functions/api/appointment.ts y lead.ts → rembrandt-agent)
# NO van en este archivo con valores reales ni en el código:
#   - Producción: Cloudflare Pages > rembrandtstudio > Settings > Variables and Secrets
#   - Local (wrangler pages dev): archivo .dev.vars, que está en .gitignore
# URL HTTPS de la ruta del bot publicada por Cloudflare Tunnel
NOTIFY_LEAD_URL=
# Secreto compartido con la VM (mismo valor que NOTIFY_LEAD_SECRET en su .env), tipo Secret
NOTIFY_LEAD_SECRET=
