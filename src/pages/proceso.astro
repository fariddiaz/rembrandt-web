---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { waLink, waSections } from '../config/site';

const wa = waSections.proceso;

const steps = [
  {
    num: '01',
    day: 'Día 1',
    title: 'Diagnóstico Comercial & Redacción de Copys',
    desc: 'Coordinamos contigo en 15 minutos por WhatsApp o videollamada. Nos cuentas qué vendes, cuál es tu cliente ideal y qué servicios quieres priorizar. No te preocupes si no tienes textos listos: nuestro equipo redacta los mensajes comerciales por ti.',
    deliverable: 'Estructura de secciones y redacción comercial aprobada.',
  },
  {
    num: '02',
    day: 'Día 2 y 3',
    title: 'Diseño Editorial de Autor en Claroscuro',
    desc: 'Creamos una propuesta visual personalizada con los colores y la esencia de tu negocio. Aplicamos nuestra firma estética: fondos oscuros profundos, tipografía Gloock y tarjetas en Liquid Glass. Nada de plantillas genéricas hechas con IA.',
    deliverable: 'Prototipo visual interactivo listo para tus comentarios.',
  },
  {
    num: '03',
    day: 'Día 4 y 5',
    title: 'Ingeniería Digital & Pruebas en Dispositivos Reales',
    desc: 'Programamos tu sitio con tecnología moderna (Astro + Tailwind CSS) para que cargue en 0.7 segundos. Si tu proyecto incluye automatizaciones, configuramos las respuestas de WhatsApp 24/7 y probamos en iPhones, Android y monitores.',
    deliverable: 'Sitio completamente funcional probado y optimizado al 100%.',
  },
  {
    num: '04',
    day: 'Día 6',
    title: 'Lanzamiento Oficial & Conexión de Dominio',
    desc: 'Conectamos tu dominio propio (.com, .co, .net), activamos el certificado de seguridad SSL verde y damos de alta tu página en Google. Tu negocio queda oficialmente abierto al mundo y listo para recibir clientes por WhatsApp.',
    deliverable: 'Página web en vivo y funcionando al 100%. Código fuente tuyo.',
  },
];
---
<Layout
  title="Nuestro Proceso de Trabajo · Rembrandt Studio | Webs Rápidas y Perfectas"
  description="Conoce el proceso paso a paso de Rembrandt Studio: entregas ágiles de 4 a 6 días hábiles en planes express, sin reuniones eternas y con tiempos realistas."
>
  <Header activePath="/proceso" />

  <main class="relative z-[2] pt-28 pb-24 md:pt-36 md:pb-32">
    <!-- Fondo claroscuro de arte: El Molino (1645) -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden opacity-10" aria-hidden="true">
      <img
        src="/art/mill.jpg"
        alt=""
        class="size-full object-cover filter grayscale contrast-125 brightness-75"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-carbon via-carbon/90 to-carbon"></div>
    </div>

    <div class="mx-auto w-[min(1240px,calc(100%-2.5rem))]">
      
      <!-- Encabezado Editorial -->
      <header class="mb-16 md:mb-20 max-w-3xl">
        <p class="text-xs uppercase tracking-[0.22em] text-mute font-medium">
          Metodología Ágil & Sin Burocracia
        </p>
        <h1 class="mt-4 font-display text-[clamp(2.6rem,5.5vw,5rem)] leading-[0.98] text-light">
          Rápido y perfecto. En los plazos que tu negocio necesita.
        </h1>
        <p class="mt-6 text-lg md:text-xl leading-relaxed text-mute">
          La idea no es solo entregar rápido: es entregar rápido y sin fallos. Las agencias tradicionales tardan meses en burocracia, mientras que otros improvisan cosas rotas. En Rembrandt definimos tiempos realistas según las funciones exactas de tu web.
        </p>
      </header>

      <!-- Los 4 Pasos del Proceso en Liquid Glass -->
      <section class="mb-24" aria-label="Fases del desarrollo">
        <div class="grid gap-6 md:grid-cols-2">
          {steps.map((s) => (
            <article class="glass relative flex flex-col justify-between overflow-hidden rounded-[2rem] p-8 md:p-10 border border-white/10 shadow-2xl">
              <div>
                <div class="flex items-center justify-between">
                  <span class="rounded-md border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-amber-200/90">
                    {s.day}
                  </span>
                </div>

                <h2 class="mt-4 font-display text-2xl md:text-3xl text-light leading-tight">
                  {s.title}
                </h2>

                <p class="mt-4 text-sm md:text-base leading-relaxed text-mute">
                  {s.desc}
                </p>
              </div>

              <div class="mt-8 border-t border-white/10 pt-4 flex items-center gap-2 text-xs text-light/80">
                <span class="size-2 rounded-full bg-emerald-400"></span>
                <span><strong>Entregable:</strong> {s.deliverable}</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Comparativa: Por qué nuestro modelo supera a la agencia tradicional -->
      <section class="mb-24" aria-labelledby="comparison-title">
        <div class="text-center mb-12 max-w-2xl mx-auto">
          <p class="text-xs uppercase tracking-[0.2em] text-mute font-medium">Diferencia Real</p>
          <h2 id="comparison-title" class="mt-2 font-display text-3xl md:text-4xl text-light">
            Rembrandt Studio vs. Agencia Tradicional
          </h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          <!-- Modelo Rembrandt -->
          <div class="glass rounded-[2rem] p-8 md:p-10 border border-violet/30 bg-violet/[0.02]">
            <p class="text-xs uppercase tracking-[0.2em] text-violet-300 font-semibold">El Enfoque Rembrandt Studio</p>
            <h3 class="mt-2 font-display text-2xl text-light">Rápido, claro y enfocado en ventas</h3>
            
            <ul class="mt-6 space-y-4 text-sm text-light/90">
              <li class="flex items-start gap-3">
                <span class="mt-1 size-1.5 shrink-0 rounded-full bg-emerald-400"></span>
                <span><strong>Entrega en 4 a 6 días:</strong> Tu landing express funcionando sin demoras ni errores.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1 size-1.5 shrink-0 rounded-full bg-emerald-400"></span>
                <span><strong>Precios cerrados desde $249 USD:</strong> Sin costos sorpresa ni presupuestos inflados.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1 size-1.5 shrink-0 rounded-full bg-emerald-400"></span>
                <span><strong>Comunicación directa por WhatsApp:</strong> Respuestas en minutos, sin tickets lentos.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1 size-1.5 shrink-0 rounded-full bg-emerald-400"></span>
                <span><strong>Propiedad 100% tuya:</strong> El código, el dominio y los accesos son de tu propiedad.</span>
              </li>
            </ul>
          </div>

          <!-- Modelo Tradicional -->
          <div class="glass rounded-[2rem] p-8 md:p-10 border border-white/5 opacity-80">
            <p class="text-xs uppercase tracking-[0.2em] text-mute font-semibold">Agencia Web Tradicional</p>
            <h3 class="mt-2 font-display text-2xl text-light/80">Lenta, costosa y burocrática</h3>
            
            <ul class="mt-6 space-y-4 text-sm text-mute">
              <li class="flex items-start gap-3">
                <span class="mt-1 size-1.5 shrink-0 rounded-full bg-rose-400"></span>
                <span><strong>Tiempos de 2 a 3 meses:</strong> Semanas de retraso mientras pierdes ventas.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1 size-1.5 shrink-0 rounded-full bg-rose-400"></span>
                <span><strong>Precios inflados ($1.500+ USD):</strong> Cargan costos de oficinas y personal sobrante.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1 size-1.5 shrink-0 rounded-full bg-rose-400"></span>
                <span><strong>Reuniones interminables:</strong> Días enteros perdidos en llamadas sin avances reales.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1 size-1.5 shrink-0 rounded-full bg-rose-400"></span>
                <span><strong>Contratos de permanencia:</strong> Te atan a mensualidades obligatorias para no perder tu web.</span>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Lo que necesitamos de ti vs. Lo que hacemos nosotros -->
      <section class="glass mb-24 rounded-[2.5rem] p-8 md:p-14 border border-white/10" aria-label="Responsabilidades claras">
        <div class="max-w-3xl">
          <p class="text-xs uppercase tracking-[0.2em] text-mute font-medium">Trabajo sin Estrés</p>
          <h2 class="mt-2 font-display text-3xl md:text-4xl text-light">
            ¿Qué tienes que hacer tú? Casi nada.
          </h2>
          <p class="mt-3 text-base text-mute">
            Sabemos que tienes un negocio que dirigir. Por eso diseñamos un flujo donde tu esfuerzo es mínimo:
          </p>
        </div>

        <div class="mt-10 grid gap-8 md:grid-cols-2">
          <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-6">
            <p class="font-sans font-semibold text-light text-base mb-4">Lo único que necesitamos de ti:</p>
            <ul class="space-y-3 text-sm text-mute">
              <li class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-violet-400"></span>
                <span>Tu logotipo (si tienes uno, si no, te preparamos una tipografía elegante).</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-violet-400"></span>
                <span>Explicarnos brevemente tus servicios o productos por mensaje de audio o WhatsApp.</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-violet-400"></span>
                <span>Tus datos de contacto (teléfono, ciudad, correo).</span>
              </li>
            </ul>
          </div>

          <div class="rounded-2xl border border-violet/20 bg-violet/5 p-6">
            <p class="font-sans font-semibold text-light text-base mb-4">De lo que nos encargamos nosotros al 100%:</p>
            <ul class="space-y-3 text-sm text-light/90">
              <li class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-emerald-400"></span>
                <span>Redacción de los textos comerciales persuasivos.</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-emerald-400"></span>
                <span>Selección y retoque de fotografías profesionales de stock.</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-emerald-400"></span>
                <span>Programación, optimización móvil y velocidad extrema.</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-emerald-400"></span>
                <span>Configuración técnica de dominio, correos corporativos y Google.</span>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- CTA de Cierre hacia Contacto -->
      <section class="glass rounded-[2.5rem] p-8 md:p-14 text-center border border-white/10">
        <h2 class="font-display text-3xl md:text-5xl text-light">
          ¿Empezamos hoy mismo?
        </h2>
        <p class="mt-4 max-w-xl mx-auto text-base text-mute">
          Tu página web profesional puede estar lista y vendiendo en los próximos 4 a 6 días hábiles.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a
            href="/contacto"
            class="btn btn-light"
            data-magnetic="0.3"
          >
            Iniciar Proyecto
          </a>
          <a
            href={waLink(wa.message)}
            target="_blank"
            rel="noopener"
            class="btn btn-ghost"
            data-magnetic="0.3"
          >
            Escribir por WhatsApp
          </a>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
