---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { plans, maintenancePackages, onDemandMaintenance, plansFaq, waLink, waSections, CONTACT_EMAIL } from '../config/site';

const wa = waSections.planes;

// Dividimos los 5 planes en dos niveles armónicos y perfectamente simétricos:
// Fila 1: La tríada comercial esencial (3 columnas balanceadas de igual proporción)
const corePlans = plans.slice(0, 3);
// Fila 2: Soluciones avanzadas de alto impacto (2 columnas simétricas 50% / 50%)
const advancedPlans = plans.slice(3, 5);
---
<Layout
  title="Planes y Precios · Rembrandt Studio | Webs de Alto Rendimiento y Automatización"
  description="Planes web claros, precios cerrados y sin letras chicas. Entrega express en 4 a 6 días y webs con automatización de WhatsApp 24/7 para empresarios."
>
  <Header activePath="/planes" />

  <main class="relative z-[2] pt-28 pb-24 md:pt-36 md:pb-32">
    <!-- Fondo claroscuro de arte: Aristóteles con el busto de Homero (1653) -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden opacity-10" aria-hidden="true">
      <img
        src="/art/aristotle.jpg"
        alt=""
        class="size-full object-cover filter grayscale contrast-125 brightness-75"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-carbon via-carbon/90 to-carbon"></div>
    </div>

    <div class="mx-auto w-[min(1240px,calc(100%-2.5rem))]">
      
      <!-- Encabezado Editorial con el Sello de Autor "Rembrandt f." -->
      <header class="mb-12 max-w-3xl">
        <div class="flex items-center gap-3">
          <p class="text-xs uppercase tracking-[0.22em] text-mute font-medium">
            Inversión Comercial & Retorno Real
          </p>
          <span class="font-serif italic text-xs tracking-[0.25em] text-amber-200/50">Rembrandt f.</span>
        </div>
        <h1 class="mt-4 font-display text-[clamp(2.4rem,5vw,4.4rem)] leading-[1.02] text-light">
          Planes claros. Tu negocio vendiendo las 24 horas.
        </h1>
        <p class="mt-4 text-base md:text-lg leading-relaxed text-mute">
          Sin términos técnicos confusos ni cobros ocultos. Diseñamos herramientas comerciales hechas para captar clientes, posicionar tu marca con autoridad y responder al instante por WhatsApp mientras te enfocas en operar tu empresa.
        </p>
      </header>

      <!-- Cinta de Compromisos de Autor (Sutil, delgada y elegante, sin diapositivas gigantes) -->
      <div class="glass mb-14 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-white/10 px-6 py-3.5 text-xs text-mute backdrop-blur-md">
        <div class="flex items-center gap-2">
          <span class="size-1.5 rounded-full bg-emerald-400"></span>
          <span><strong class="text-light font-medium">4 a 6 días</strong> · Entrega express garantizada</span>
        </div>
        <div class="hidden sm:block h-3 w-px bg-white/10"></div>
        <div class="flex items-center gap-2">
          <span class="size-1.5 rounded-full bg-amber-400"></span>
          <span><strong class="text-light font-medium">WhatsApp 24/7</strong> · Asistente con respuesta inmediata</span>
        </div>
        <div class="hidden md:block h-3 w-px bg-white/10"></div>
        <div class="flex items-center gap-2">
          <span class="size-1.5 rounded-full bg-violet-400"></span>
          <span><strong class="text-light font-medium">Propiedad 100%</strong> · Código y dominio tuyos</span>
        </div>
        <div class="hidden lg:block h-3 w-px bg-white/10"></div>
        <div class="flex items-center gap-2">
          <span class="size-1.5 rounded-full bg-light"></span>
          <span><strong class="text-light font-medium">0.7s</strong> · Carga instantánea en celulares</span>
        </div>
      </div>

      <!-- Fila 1: La Tríada Comercial (3 Columnas con Simetría y Altura Exactas) -->
      <section class="mb-6" aria-label="Planes principales de presencia y conversión">
        <div class="grid gap-6 md:grid-cols-3 items-stretch">
          {corePlans.map((plan) => {
            const isFeatured = plan.featured;
            return (
              <article
                class:list={[
                  'flex flex-col justify-between rounded-[2rem] p-7 md:p-8 transition-all duration-300',
                  isFeatured
                    ? 'glass-rembrandt border-amber-400/30 bg-amber-950/10 shadow-2xl relative'
                    : 'glass border-white/10 hover:border-white/20',
                ]}
                aria-labelledby={`plan-title-${plan.id}`}
              >
                <div>
                  <div class="flex items-center justify-between gap-2 min-h-[1.75rem]">
                    <span class="text-xs uppercase tracking-wider text-amber-200/90 font-medium">
                      {plan.badge}
                    </span>
                    {isFeatured && (
                      <span class="rounded-md border border-amber-400/30 bg-amber-400/10 px-2.5 py-0.5 text-[0.7rem] font-medium text-amber-200">
                        Recomendado
                      </span>
                    )}
                  </div>

                  <h2 id={`plan-title-${plan.id}`} class="mt-3 font-display text-2xl text-light leading-snug">
                    {plan.name}
                  </h2>

                  <p class="mt-2 text-xs md:text-sm text-mute leading-relaxed min-h-[3.6rem]">
                    {plan.audience}
                  </p>

                  <!-- Precio y Plazo -->
                  <div class="mt-6 border-y border-white/10 py-4">
                    <div class="flex items-baseline gap-2">
                      <span class="font-display text-3xl md:text-4xl text-light leading-none">
                        {plan.priceUsd}
                      </span>
                      {plan.priceCop && (
                        <span class="text-xs text-mute font-sans">{plan.priceCop}</span>
                      )}
                    </div>
                    <p class="mt-2 flex items-center gap-1.5 text-xs text-light/80">
                      <span class="size-1.5 rounded-full bg-emerald-400"></span>
                      {plan.delivery}
                    </p>
                  </div>

                  <!-- Entregables -->
                  <ul class="mt-6 space-y-2.5 text-xs text-light/90">
                    {plan.features.map((f) => (
                      <li class="flex items-start gap-2 leading-relaxed">
                        <span class="mt-[0.35em] size-1.5 shrink-0 rounded-full bg-amber-300/80"></span>
                        <span>{f}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Botón CTA alineado en la base -->
                <div class="mt-8 pt-5 border-t border-white/10 flex flex-col gap-2.5">
                  <a
                    href={waLink(plan.message)}
                    target="_blank"
                    rel="noopener"
                    class:list={[
                      'btn w-full justify-center text-center !py-2.5 text-sm',
                      isFeatured ? 'btn-light' : 'btn-ghost',
                    ]}
                    data-magnetic="0.2"
                  >
                    {plan.cta}
                  </a>
                  <a
                    href={`/contacto?plan=${plan.id}`}
                    class="text-center text-[0.72rem] text-mute hover:text-light transition-colors underline underline-offset-4"
                  >
                    O cotizar por formulario →
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <!-- Fila 2: Soluciones Especializadas (2 Columnas Simétricas 50% / 50%) -->
      <section class="mb-24" aria-label="Soluciones especializadas y a medida">
        <div class="grid gap-6 md:grid-cols-2 items-stretch">
          {advancedPlans.map((plan) => (
            <article
              class="glass flex flex-col justify-between rounded-[2rem] p-7 md:p-8 border border-white/10 hover:border-white/20 transition-all duration-300"
              aria-labelledby={`plan-title-${plan.id}`}
            >
              <div>
                <div class="flex items-center justify-between gap-2 min-h-[1.75rem]">
                  <span class="text-xs uppercase tracking-wider text-amber-200/90 font-medium">
                    {plan.badge}
                  </span>
                  <span class="rounded-md border border-white/10 bg-white/5 px-2.5 py-0.5 text-[0.7rem] text-mute">
                    Solución Avanzada
                  </span>
                </div>

                <h2 id={`plan-title-${plan.id}`} class="mt-3 font-display text-2xl text-light leading-snug">
                  {plan.name}
                </h2>

                <p class="mt-2 text-xs md:text-sm text-mute leading-relaxed min-h-[3rem]">
                  {plan.audience}
                </p>

                <!-- Precio y Plazo -->
                <div class="mt-6 border-y border-white/10 py-4">
                  <div class="flex items-baseline gap-2">
                    <span class="font-display text-3xl md:text-4xl text-light leading-none">
                      {plan.priceUsd}
                    </span>
                    {plan.priceCop && (
                      <span class="text-xs text-mute font-sans">{plan.priceCop}</span>
                    )}
                  </div>
                  <p class="mt-2 flex items-center gap-1.5 text-xs text-light/80">
                    <span class="size-1.5 rounded-full bg-emerald-400"></span>
                    {plan.delivery}
                  </p>
                </div>

                <!-- Entregables -->
                <ul class="mt-6 space-y-2.5 text-xs text-light/90">
                  {plan.features.map((f) => (
                    <li class="flex items-start gap-2 leading-relaxed">
                      <span class="mt-[0.35em] size-1.5 shrink-0 rounded-full bg-amber-300/80"></span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Botón CTA alineado en la base -->
              <div class="mt-8 pt-5 border-t border-white/10 flex flex-col gap-2.5">
                <a
                  href={waLink(plan.message)}
                  target="_blank"
                  rel="noopener"
                  class="btn btn-ghost w-full justify-center text-center !py-2.5 text-sm"
                  data-magnetic="0.2"
                >
                  {plan.cta}
                </a>
                <a
                  href={`/contacto?plan=${plan.id}`}
                  class="text-center text-[0.72rem] text-mute hover:text-light transition-colors underline underline-offset-4"
                >
                  O cotizar por formulario →
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Sección Especial: Flujo de la Automatización de WhatsApp (Hitos Narrativos Elegantes) -->
      <section class="glass-rembrandt mb-24 overflow-hidden rounded-[2.5rem] p-8 md:p-12 border border-amber-400/20" aria-labelledby="automation-flow">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-5">
            <p class="text-xs uppercase tracking-[0.2em] text-amber-200/90 font-medium">
              Ingeniería Comercial
            </p>
            <h2 id="automation-flow" class="mt-3 font-display text-[clamp(1.9rem,3.4vw,2.8rem)] leading-tight text-light">
              ¿Cómo funciona la Automatización de WhatsApp para tu empresa?
            </h2>
            <p class="mt-4 text-sm text-mute leading-relaxed">
              El 70% de las ventas en internet se pierden cuando un cliente escribe y tarda más de 5 minutos en recibir respuesta. Nuestro sistema conecta tu página web con un asistente virtual inteligente en tu WhatsApp Business que opera las 24 horas del día.
            </p>

            <div class="mt-6 space-y-2.5 text-xs text-light/90">
              <div class="flex items-center gap-2.5">
                <span class="size-1.5 rounded-full bg-emerald-400"></span>
                <span>Cero comisiones mensuales por mensaje de nuestra parte</span>
              </div>
              <div class="flex items-center gap-2.5">
                <span class="size-1.5 rounded-full bg-emerald-400"></span>
                <span>Configurado con tu tono de voz y respuestas reales de tu negocio</span>
              </div>
              <div class="flex items-center gap-2.5">
                <span class="size-1.5 rounded-full bg-emerald-400"></span>
                <span>Notificación instantánea a tu móvil cuando el cliente quiere pagar</span>
              </div>
            </div>

            <a
              href={waLink('Hola Rembrandt Studio, quiero ver una demostración de la Automatización de WhatsApp para mi negocio.')}
              target="_blank"
              rel="noopener"
              class="btn btn-light mt-8 !py-2.5 !px-6 text-sm"
              data-magnetic="0.3"
            >
              Ver demostración en vivo
            </a>
          </div>

          <!-- Cuatro Hitos de Atención Comercial (Sin PASO 01, con diseño simétrico) -->
          <div class="space-y-3.5 lg:col-span-7">
            <div class="rounded-2xl border border-white/10 bg-carbon-2/80 p-4 sm:p-5 backdrop-blur-md">
              <div class="flex items-center justify-between text-xs text-mute">
                <span class="font-medium text-amber-200/90 tracking-wide">El Clic de Interés</span>
                <span>Inmediatez: 0s</span>
              </div>
              <p class="mt-2 text-sm font-semibold text-light">
                El cliente entra a tu web y solicita información
              </p>
              <p class="mt-1 text-xs text-mute leading-relaxed">
                Llega directamente a tu WhatsApp con un mensaje estructurado indicando el servicio o producto exacto de su interés.
              </p>
            </div>

            <div class="rounded-2xl border border-amber-400/20 bg-amber-400/[0.03] p-4 sm:p-5 backdrop-blur-md">
              <div class="flex items-center justify-between text-xs text-amber-300">
                <span class="font-medium tracking-wide">Acogida Inmediata 24/7</span>
                <span>Respuesta: &lt; 3s</span>
              </div>
              <p class="mt-2 text-sm font-semibold text-light">
                El asistente virtual saluda con la voz de tu marca
              </p>
              <p class="mt-1 text-xs text-mute leading-relaxed">
                "¡Hola! Bienvenido a [Tu Empresa]. Con gusto te asesoramos: (1) Ver tarifas y catálogo, (2) Agendar videollamada, (3) Hablar con un especialista".
              </p>
            </div>

            <div class="rounded-2xl border border-white/10 bg-carbon-2/80 p-4 sm:p-5 backdrop-blur-md">
              <div class="flex items-center justify-between text-xs text-mute">
                <span class="font-medium text-rose-300 tracking-wide">Filtro de Alto Valor</span>
                <span>Calificación automática</span>
              </div>
              <p class="mt-2 text-sm font-semibold text-light">
                Filtra curiosos y recopila los datos clave
              </p>
              <p class="mt-1 text-xs text-mute leading-relaxed">
                Identifica ciudad, tipo de requerimiento y presupuesto. Si está listo para comprar, le despacha tu catálogo o enlace de pago directo.
              </p>
            </div>

            <div class="rounded-2xl border border-emerald-500/20 bg-emerald-500/[0.03] p-4 sm:p-5 backdrop-blur-md">
              <div class="flex items-center justify-between text-xs text-emerald-300">
                <span class="font-medium tracking-wide">El Encuentro de Cierre</span>
                <span>Resultado: Venta asistida</span>
              </div>
              <p class="mt-2 text-sm font-semibold text-light">
                Cita agendada o alerta a tu WhatsApp personal
              </p>
              <p class="mt-1 text-xs text-mute leading-relaxed">
                El prospecto agenda en tu calendario (Google Calendar o Cal.com) y tú recibes una alerta en tu móvil con todo el resumen del cliente.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Paquetes de Mantenimiento Mensual Sutil & Opción a Demanda -->
      <section class="mb-24" aria-labelledby="maintenance-section-title">
        <div class="mb-10 text-center max-w-2xl mx-auto">
          <p class="text-xs uppercase tracking-[0.2em] text-mute font-medium">
            Soporte Continuo & Tranquilidad Técnica
          </p>
          <h2 id="maintenance-section-title" class="mt-2 font-display text-3xl md:text-4xl text-light">
            Mantenimiento mensual para que tu web nunca se detenga
          </h2>
          <p class="mt-3 text-sm text-mute leading-relaxed">
            Un servicio opcional y accesible diseñado para que tu web siga cargando rápido, segura y con tus contenidos al día sin tener que lidiar con problemas técnicos ni pagar mensualidades abusivas.
          </p>
        </div>

        <!-- Grid Armónico de 3 Columnas para Paquetes Mensuales -->
        <div class="grid gap-6 md:grid-cols-3 items-stretch">
          {maintenancePackages.map((pkg) => (
            <article
              class:list={[
                'flex flex-col justify-between rounded-[2rem] p-7 transition-all duration-300',
                pkg.featured
                  ? 'glass-rembrandt border-amber-400/30 bg-amber-950/10 shadow-xl'
                  : 'glass border-white/10 hover:border-white/20',
              ]}
            >
              <div>
                <div class="flex items-center justify-between gap-2 min-h-[1.5rem]">
                  <span class="text-xs font-medium uppercase tracking-wider text-amber-200/90">
                    {pkg.badge}
                  </span>
                  {pkg.featured && (
                    <span class="rounded-md border border-amber-400/30 bg-amber-400/10 px-2 py-0.5 text-[0.68rem] text-amber-200">
                      Más Elegido
                    </span>
                  )}
                </div>

                <h3 class="mt-3 font-display text-xl text-light">{pkg.name}</h3>
                <p class="mt-2 text-xs text-mute leading-relaxed min-h-[2.5rem]">{pkg.audience}</p>

                <div class="mt-5 border-y border-white/10 py-3.5">
                  <div class="flex items-baseline gap-1">
                    <span class="font-display text-3xl text-light leading-none">{pkg.priceUsd}</span>
                    <span class="text-xs text-mute font-sans">{pkg.period}</span>
                  </div>
                  <p class="mt-1 text-xs text-mute">{pkg.priceCop}</p>
                  {pkg.annualDiscount && (
                    <p class="mt-1.5 text-[0.7rem] text-emerald-400 font-medium">{pkg.annualDiscount}</p>
                  )}
                </div>

                <ul class="mt-5 space-y-2 text-xs text-light/90">
                  {pkg.features.map((feat) => (
                    <li class="flex items-start gap-2 leading-snug">
                      <span class="mt-1 size-1.5 shrink-0 rounded-full bg-amber-300/80"></span>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-7 pt-4 border-t border-white/10">
                <a
                  href={waLink(pkg.message)}
                  target="_blank"
                  rel="noopener"
                  class:list={[
                    'btn w-full justify-center text-center !py-2 text-xs font-medium',
                    pkg.featured ? 'btn-light' : 'btn-ghost',
                  ]}
                  data-magnetic="0.2"
                >
                  {pkg.cta}
                </a>
              </div>
            </article>
          ))}
        </div>

        <!-- Opción Sin Mensualidad (Pago Único / A Demanda) -->
        <aside class="glass mt-6 rounded-[2rem] p-6 sm:p-8 border border-white/10" aria-label="Opción a demanda">
          <div class="grid gap-6 md:grid-cols-12 md:items-center">
            <div class="md:col-span-7">
              <p class="text-xs uppercase tracking-[0.2em] text-mute font-medium">Libertad Total</p>
              <h3 class="mt-1 font-display text-xl text-light">
                {onDemandMaintenance.title}
              </h3>
              <p class="mt-2 text-xs text-mute leading-relaxed">
                {onDemandMaintenance.desc}
              </p>
            </div>

            <div class="md:col-span-5 space-y-2 border-t border-white/10 pt-4 md:border-t-0 md:pt-0">
              <p class="text-xs font-semibold uppercase tracking-wider text-light/80 mb-1">Tarifas de ajustes puntuales:</p>
              {onDemandMaintenance.rates.map((rate) => (
                <div class="flex items-center justify-between rounded-xl border border-white/5 bg-white/[0.02] p-2.5 text-xs">
                  <span class="text-mute pr-2">{rate.task}</span>
                  <span class="font-mono font-bold text-light whitespace-nowrap">{rate.price}</span>
                </div>
              ))}
            </div>
          </div>
        </aside>
      </section>

      <!-- Tabla Comparativa de Planes (Tipografía Balanceada y Simetría Exacta) -->
      <section class="mb-24" aria-labelledby="table-title">
        <div class="mb-8 text-center max-w-2xl mx-auto">
          <p class="text-xs uppercase tracking-[0.2em] text-mute font-medium">Comparativa Detallada</p>
          <h2 id="table-title" class="mt-2 font-display text-3xl md:text-4xl text-light">
            Todo lo que incluye cada opción frente a frente
          </h2>
        </div>

        <div class="glass overflow-x-auto rounded-2xl border border-white/10 p-4 md:p-6 shadow-2xl">
          <table class="w-full text-left text-xs md:text-sm">
            <thead>
              <tr class="border-b border-white/10 text-mute uppercase font-mono text-[0.72rem]">
                <th class="py-4 pr-4">Característica</th>
                <th class="py-4 px-3 text-center">Express</th>
                <th class="py-4 px-3 text-center">Corporativa</th>
                <th class="py-4 px-3 text-center text-amber-200 font-bold bg-white/[0.03] rounded-t-xl">Web + Auto WhatsApp</th>
                <th class="py-4 px-3 text-center">Tienda Ágil</th>
                <th class="py-4 px-3 text-center">Signature 3D</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-light/90">
              <tr>
                <td class="py-3.5 pr-4 font-medium text-light">Tiempo de Entrega</td>
                <td class="py-3.5 px-3 text-center font-mono">4–6 días</td>
                <td class="py-3.5 px-3 text-center font-mono">8–12 días</td>
                <td class="py-3.5 px-3 text-center font-mono text-amber-200 font-bold bg-white/[0.03]">12–15 días</td>
                <td class="py-3.5 px-3 text-center font-mono">15–20 días</td>
                <td class="py-3.5 px-3 text-center font-mono">3–5 semanas</td>
              </tr>
              <tr>
                <td class="py-3.5 pr-4 font-medium text-light">Estructura</td>
                <td class="py-3.5 px-3 text-center">Landing Page</td>
                <td class="py-3.5 px-3 text-center">3–5 Páginas</td>
                <td class="py-3.5 px-3 text-center text-amber-200 bg-white/[0.03]">3–5 Páginas</td>
                <td class="py-3.5 px-3 text-center">Catálogo + Carrito</td>
                <td class="py-3.5 px-3 text-center">Experiencia 3D</td>
              </tr>
              <tr>
                <td class="py-3.5 pr-4 font-medium text-light">Botón Directo WhatsApp</td>
                <td class="py-3.5 px-3 text-center text-emerald-400">✓</td>
                <td class="py-3.5 px-3 text-center text-emerald-400">✓</td>
                <td class="py-3.5 px-3 text-center text-emerald-400 font-bold bg-white/[0.03]">✓</td>
                <td class="py-3.5 px-3 text-center text-emerald-400">✓</td>
                <td class="py-3.5 px-3 text-center text-emerald-400">✓</td>
              </tr>
              <tr>
                <td class="py-3.5 pr-4 font-medium text-light">Chatbot Automatizado 24/7</td>
                <td class="py-3.5 px-3 text-center text-mute">—</td>
                <td class="py-3.5 px-3 text-center text-mute">—</td>
                <td class="py-3.5 px-3 text-center text-emerald-400 font-bold bg-white/[0.03]">✓ Incluido</td>
                <td class="py-3.5 px-3 text-center text-mute">—</td>
                <td class="py-3.5 px-3 text-center text-emerald-400">Opcional</td>
              </tr>
              <tr>
                <td class="py-3.5 pr-4 font-medium text-light">Agendamiento Automático de Citas</td>
                <td class="py-3.5 px-3 text-center text-mute">—</td>
