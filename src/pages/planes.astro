---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { plans, maintenancePackages, onDemandMaintenance, plansFaq, waLink, waSections, CONTACT_EMAIL } from '../config/site';

const wa = waSections.planes;
---
<Layout
  title="Planes y Precios · Rembrandt Studio | Webs que Venden y Automatización WhatsApp"
  description="Planes web claros, precios cerrados y sin letras chicas. Landing express en 4 a 6 días y webs con automatización de WhatsApp 24/7 para empresarios."
>
  <Header activePath="/planes" />

  <main class="relative z-[2] pt-28 pb-24 md:pt-36 md:pb-32">
    <!-- Fondo claroscuro de arte: Aristóteles con el busto de Homero (1653) -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden opacity-10" aria-hidden="true">
      <img
        src="/art/aristotle.jpg"
        alt=""
        class="size-full object-cover filter grayscale contrast-125 brightness-75"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-carbon via-carbon/90 to-carbon"></div>
    </div>

    <div class="mx-auto w-[min(1240px,calc(100%-2.5rem))]">
      
      <!-- Encabezado Editorial de la Página de Planes -->
      <header class="mb-16 md:mb-20 max-w-3xl">
        <p class="text-xs uppercase tracking-[0.22em] text-mute font-medium">
          Inversión Comercial & Retorno de Inversión
        </p>
        <h1 class="mt-4 font-display text-[clamp(2.6rem,5.5vw,5rem)] leading-[0.98] text-light">
          Planes claros. Tu negocio vendiendo las 24 horas.
        </h1>
        <p class="mt-6 text-lg md:text-xl leading-relaxed text-mute">
          Sin términos técnicos confusos ni costos ocultos. Diseñamos herramientas comerciales hechas para captar clientes, posicionar tu marca con autoridad y responder al instante por WhatsApp mientras te enfocas en operar tu empresa.
        </p>
      </header>

      <!-- Pilares de Confianza en Liquid Glass -->
      <section class="mb-20 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Compromisos clave">
        <div class="glass rounded-2xl p-6">
          <p class="font-display text-2xl text-light">4 a 6 días</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-violet-300">Entrega Rápida & Perfecta</p>
          <p class="mt-2 text-xs leading-relaxed text-mute">
            Garantía estricta en planes express. El tiempo exacto para maquetar, afinar y entregar sin fallos.
          </p>
        </div>

        <div class="glass rounded-2xl p-6">
          <p class="font-display text-2xl text-light">24/7</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-rose-300">WhatsApp Inteligente</p>
          <p class="mt-2 text-xs leading-relaxed text-mute">
            Automatización que saluda, califica prospectos, comparte tu catálogo y agenda reuniones día y noche.
          </p>
        </div>

        <div class="glass rounded-2xl p-6">
          <p class="font-display text-2xl text-light">100% Tuya</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-emerald-300">Propiedad Total</p>
          <p class="mt-2 text-xs leading-relaxed text-mute">
            Sin mensualidades obligatorias ni plataformas cerradas. El código fuente y tu dominio te pertenecen.
          </p>
        </div>

        <div class="glass rounded-2xl p-6">
          <p class="font-display text-2xl text-light">0.7s</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-amber-300">Velocidad Extrema</p>
          <p class="mt-2 text-xs leading-relaxed text-mute">
            Astro + Tailwind. Carga instantánea en cualquier celular para no perder ni un solo cliente potencial.
          </p>
        </div>
      </section>
          <p class="mt-2 text-xs leading-relaxed text-mute">
            Automatización que saluda, califica prospectos, comparte tu catálogo y agenda reuniones día y noche.
          </p>
        </div>

        <div class="glass rounded-2xl p-6">
          <p class="font-display text-2xl text-light">100% Tuya</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-emerald-300">Propiedad Total</p>
          <p class="mt-2 text-xs leading-relaxed text-mute">
            Sin mensualidades obligatorias ni plataformas cerradas. El código fuente y tu dominio te pertenecen.
          </p>
        </div>

        <div class="glass rounded-2xl p-6">
          <p class="font-display text-2xl text-light">0.7s</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-amber-300">Velocidad Extrema</p>
          <p class="mt-2 text-xs leading-relaxed text-mute">
            Astro + Tailwind. Carga instantánea en cualquier celular para no perder ni un solo cliente potencial.
          </p>
        </div>
      </section>

      <!-- Grid Principal de los 5 Planes en Liquid Glass -->
      <section class="mb-24" aria-label="Catálogo de planes">
        <div class="grid gap-8 lg:grid-cols-3">
          {plans.map((plan, i) => {
            const isFeatured = plan.featured;
            return (
              <article
                class:list={[
                  'glass flex flex-col justify-between rounded-[2rem] p-7 md:p-9 transition-all duration-300',
                  isFeatured
                    ? 'border-violet/40 bg-white/[0.04] lg:-translate-y-2 shadow-2xl relative ring-1 ring-violet/30'
                    : 'border-white/10',
                ]}
                aria-labelledby={`plan-title-${plan.id}`}
              >
                <div>
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-mono text-xs uppercase tracking-wider text-mute">
                      Plan {String(i + 1).padStart(2, '0')}
                    </span>
                    {isFeatured && (
                      <span class="rounded-md border border-white/20 bg-white/10 px-3 py-0.5 text-[0.72rem] font-medium text-light backdrop-blur-md">
                        Recomendado para Empresas
                      </span>
                    )}
                  </div>

                  <h2 id={`plan-title-${plan.id}`} class="mt-4 font-display text-2xl md:text-3xl text-light">
                    {plan.name}
                  </h2>

                  <p class="mt-2 text-xs font-medium uppercase tracking-wider text-violet-300/90">
                    {plan.badge}
                  </p>

                  <p class="mt-4 text-sm leading-relaxed text-mute">
                    {plan.audience}
                  </p>

                  <!-- Precio y Entrega -->
                  <div class="mt-6 border-y border-white/10 py-5">
                    <p class="font-display text-4xl leading-none text-light">
                      {plan.priceUsd}
                    </p>
                    {plan.priceCop && (
                      <p class="mt-1 text-sm text-mute">{plan.priceCop}</p>
                    )}
                    <p class="mt-3 flex items-center gap-2 text-xs text-light/80">
                      <span class="size-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
                      {plan.delivery}
                    </p>
                  </div>

                  <!-- Lista de Beneficios para el Empresario -->
                  <div class="mt-6">
                    <p class="text-xs font-semibold uppercase tracking-wider text-light/70 mb-3">
                      Lo que incluye tu inversión:
                    </p>
                    <ul class="space-y-3 text-xs md:text-sm text-light/90">
                      {plan.features.map((f) => (
                        <li class="flex items-start gap-2.5 leading-snug">
                          <span class="mt-[0.35em] size-1.5 shrink-0 rounded-full bg-violet-400" aria-hidden="true"></span>
                          <span>{f}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <!-- Botones de Acción -->
                <div class="mt-8 pt-6 border-t border-white/10 flex flex-col gap-3">
                  <a
                    href={waLink(plan.message)}
                    target="_blank"
                    rel="noopener"
                    class:list={[
                      'btn w-full justify-center text-center !py-3 text-sm',
                      isFeatured ? 'btn-light' : 'btn-ghost',
                    ]}
                    data-magnetic="0.2"
                  >
                    {plan.cta}
                  </a>
                  <a
                    href={`/contacto?plan=${plan.id}`}
                    class="text-center text-xs text-mute hover:text-light transition-colors underline underline-offset-4"
                  >
                    O solicitar propuesta formal por correo →
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <!-- Sección Destacada: ¿Cómo Funciona la Automatización de WhatsApp? -->
      <section class="glass mb-24 overflow-hidden rounded-[2.5rem] p-8 md:p-14 border border-violet/20" aria-labelledby="automation-flow">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-5">
            <p class="text-xs uppercase tracking-[0.2em] text-violet-300 font-medium">
              Tecnología Comercial de Vanguardia
            </p>
            <h2 id="automation-flow" class="mt-3 font-display text-[clamp(2rem,3.8vw,3.2rem)] leading-tight text-light">
              ¿Cómo funciona la Automatización de WhatsApp para tu empresa?
            </h2>
            <p class="mt-4 text-base text-mute leading-relaxed">
              El 70% de las ventas en internet se pierden cuando un cliente escribe y tarda más de 5 minutos en recibir respuesta. Nuestro sistema conecta tu página web con un asistente virtual inteligente en tu WhatsApp Business que opera las 24 horas.
            </p>

            <div class="mt-6 space-y-3">
              <div class="flex items-center gap-3 text-sm text-light">
                <span class="size-2 rounded-full bg-emerald-400"></span>
                <span>Cero comisiones mensuales por mensaje de nuestra parte</span>
              </div>
              <div class="flex items-center gap-3 text-sm text-light">
                <span class="size-2 rounded-full bg-emerald-400"></span>
                <span>Configurado con tu tono de voz y tus respuestas reales</span>
              </div>
              <div class="flex items-center gap-3 text-sm text-light">
                <span class="size-2 rounded-full bg-emerald-400"></span>
                <span>Notificación instantánea a tu móvil cuando el cliente quiere pagar</span>
              </div>
            </div>

            <a
              href={waLink('Hola Rembrandt Studio, quiero saber más sobre la Automatización de WhatsApp para mi negocio.')}
              target="_blank"
              rel="noopener"
              class="btn btn-light mt-8"
              data-magnetic="0.3"
            >
              Ver demostración por WhatsApp
            </a>
          </div>

          <!-- Diagrama de Flujo Paso a Paso en Liquid Glass -->
          <div class="space-y-4 lg:col-span-7">
            <div class="rounded-2xl border border-white/10 bg-carbon-2/80 p-5 backdrop-blur-md">
              <div class="flex items-center justify-between text-xs text-mute">
                <span class="font-mono text-violet-300 font-semibold">Momento I · El Clic de Interés</span>
                <span>Inmediatez: 0s</span>
              </div>
              <p class="mt-2 text-sm font-semibold text-light">
                El cliente entra a tu web y solicita información
              </p>
              <p class="mt-1 text-xs text-mute">
                Llega directamente a tu WhatsApp con un mensaje estructurado indicando el servicio o producto exacto de su interés.
              </p>
            </div>

            <div class="rounded-2xl border border-violet/30 bg-violet/5 p-5 backdrop-blur-md">
              <div class="flex items-center justify-between text-xs text-violet-300">
                <span class="font-mono font-semibold">Momento II · Acogida Inmediata 24/7</span>
                <span>Respuesta: &lt; 3 segundos</span>
              </div>
              <p class="mt-2 text-sm font-semibold text-light">
                El asistente virtual saluda con la voz de tu marca
              </p>
              <p class="mt-1 text-xs text-mute">
                "¡Hola! Bienvenido a [Tu Empresa]. Con gusto te asesoramos: (1) Ver tarifas y catálogo, (2) Agendar videollamada, (3) Hablar con un especialista".
              </p>
            </div>

            <div class="rounded-2xl border border-white/10 bg-carbon-2/80 p-5 backdrop-blur-md">
              <div class="flex items-center justify-between text-xs text-mute">
                <span class="font-mono text-rose-300 font-semibold">Momento III · Filtro de Alto Valor</span>
                <span>Proceso: Calificación en vivo</span>
              </div>
              <p class="mt-2 text-sm font-semibold text-light">
                Filtra curiosos y recopila los datos clave
              </p>
              <p class="mt-1 text-xs text-mute">
                Identifica ciudad, tipo de requerimiento y presupuesto disponible. Si está listo para comprar, le despacha tu catálogo o enlace de pago directo.
              </p>
            </div>

            <div class="rounded-2xl border border-emerald-500/30 bg-emerald-500/5 p-5 backdrop-blur-md">
              <div class="flex items-center justify-between text-xs text-emerald-300">
                <span class="font-mono font-semibold">Momento IV · El Encuentro de Cierre</span>
                <span>Resultado: Venta asistida</span>
              </div>
              <p class="mt-2 text-sm font-semibold text-light">
                Cita agendada o alerta a tu WhatsApp personal
              </p>
              <p class="mt-1 text-xs text-mute">
                El prospecto agenda en tu calendario (Google Calendar o Cal.com) y tú recibes una alerta prioritaria en tu móvil con todo el resumen del cliente.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Servicios de Mantenimiento Mensual en Paquetes & Opción a Demanda -->
      <section class="mb-24" aria-labelledby="maintenance-section-title">
        <div class="mb-12 text-center max-w-3xl mx-auto">
          <p class="text-xs uppercase tracking-[0.2em] text-mute font-medium">
            Soporte Continuo & Tranquilidad Post-Lanzamiento
          </p>
          <h2 id="maintenance-section-title" class="mt-2 font-display text-3xl md:text-5xl text-light">
            Mantenimiento mensual para que tu web nunca se detenga
          </h2>
          <p class="mt-4 text-base md:text-lg text-mute leading-relaxed">
            Un servicio opcional y accesible diseñado para que tu web siga cargando rápido, segura y con tus contenidos al día sin que tengas que lidiar con problemas técnicos ni pagar mensualidades abusivas.
          </p>
        </div>

        <!-- Grid de los 3 Paquetes de Mantenimiento -->
        <div class="grid gap-6 lg:grid-cols-3">
          {maintenancePackages.map((pkg) => (
            <article
              class:list={[
                'glass flex flex-col justify-between rounded-[2rem] p-7 md:p-8 transition-all duration-300',
                pkg.featured
                  ? 'border-violet/40 bg-white/[0.04] lg:-translate-y-2 shadow-2xl ring-1 ring-violet/30'
                  : 'border-white/10',
              ]}
            >
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs font-semibold uppercase tracking-wider text-violet-300">
                    {pkg.badge}
                  </span>
                  {pkg.featured && (
                    <span class="rounded-md border border-white/20 bg-white/10 px-2.5 py-0.5 text-[0.68rem] font-medium text-light">
                      Más Elegido
                    </span>
                  )}
                </div>

                <h3 class="mt-3 font-display text-2xl text-light">{pkg.name}</h3>
                <p class="mt-2 text-xs text-mute leading-relaxed">{pkg.audience}</p>

                <div class="mt-6 border-y border-white/10 py-4">
                  <div class="flex items-baseline gap-1">
                    <span class="font-display text-4xl text-light leading-none">{pkg.priceUsd}</span>
                    <span class="text-xs text-mute font-sans">{pkg.period}</span>
                  </div>
                  <p class="mt-1 text-xs text-mute">{pkg.priceCop}</p>
                  {pkg.annualDiscount && (
                    <p class="mt-2 text-[0.72rem] text-emerald-400 font-medium">{pkg.annualDiscount}</p>
                  )}
                </div>

                <ul class="mt-6 space-y-2.5 text-xs text-light/90">
                  {pkg.features.map((feat) => (
                    <li class="flex items-start gap-2">
                      <span class="mt-1 size-1.5 shrink-0 rounded-full bg-violet-400"></span>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-8 pt-5 border-t border-white/10">
                <a
                  href={waLink(pkg.message)}
                  target="_blank"
                  rel="noopener"
                  class:list={[
                    'btn w-full justify-center text-center !py-2.5 text-xs font-medium',
                    pkg.featured ? 'btn-light' : 'btn-ghost',
                  ]}
                  data-magnetic="0.2"
                >
                  {pkg.cta}
                </a>
              </div>
            </article>
          ))}
        </div>

        <!-- Opción Sin Mensualidad (Pago Único / A Demanda) -->
        <aside class="glass mt-8 rounded-[2rem] p-7 md:p-10 border border-white/10" aria-label="Opción a demanda">
          <div class="grid gap-6 md:grid-cols-12 md:items-center">
            <div class="md:col-span-7">
              <p class="text-xs uppercase tracking-[0.2em] text-mute font-medium">Libertad Total</p>
              <h3 class="mt-1 font-display text-2xl text-light">
                {onDemandMaintenance.title}
              </h3>
              <p class="mt-3 text-xs md:text-sm text-mute leading-relaxed">
                {onDemandMaintenance.desc}
              </p>
            </div>

            <div class="md:col-span-5 space-y-2.5 border-t border-white/10 pt-5 md:border-t-0 md:pt-0">
              <p class="text-xs font-semibold uppercase tracking-wider text-light/80 mb-2">Tarifas de ajustes puntuales:</p>
              {onDemandMaintenance.rates.map((rate) => (
                <div class="flex items-center justify-between rounded-xl border border-white/5 bg-white/[0.02] p-3 text-xs">
                  <span class="text-mute pr-2">{rate.task}</span>
                  <span class="font-mono font-bold text-light whitespace-nowrap">{rate.price}</span>
                </div>
              ))}
            </div>
          </div>
        </aside>
      </section>

      <!-- Tabla Comparativa de Planes -->
      <section class="mb-24" aria-labelledby="table-title">
        <div class="mb-8 text-center max-w-2xl mx-auto">
          <p class="text-xs uppercase tracking-[0.2em] text-mute font-medium">Comparativa Detallada</p>
          <h2 id="table-title" class="mt-2 font-display text-3xl md:text-4xl text-light">
            Todo lo que incluye cada opción frente a frente
          </h2>
        </div>

        <div class="glass overflow-x-auto rounded-2xl border border-white/10 p-4 md:p-6 shadow-2xl">
          <table class="w-full text-left text-xs md:text-sm">
            <thead>
              <tr class="border-b border-white/10 text-mute uppercase font-mono text-[0.72rem]">
                <th class="py-4 pr-4">Característica</th>
                <th class="py-4 px-3 text-center">Express</th>
                <th class="py-4 px-3 text-center">Corporativa</th>
                <th class="py-4 px-3 text-center text-violet-300 font-bold bg-white/[0.03] rounded-t-xl">Web + Auto WhatsApp</th>
                <th class="py-4 px-3 text-center">Tienda Ágil</th>
                <th class="py-4 px-3 text-center">Signature 3D</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-light/90">
              <tr>
                <td class="py-3.5 pr-4 font-medium text-light">Tiempo de Entrega (Rápido & Perfecto)</td>
                <td class="py-3.5 px-3 text-center font-mono font-medium">4–6 días</td>
                <td class="py-3.5 px-3 text-center font-mono font-medium">8–12 días</td>
                <td class="py-3.5 px-3 text-center font-mono text-violet-300 font-bold bg-white/[0.03]">12–15 días</td>
                <td class="py-3.5 px-3 text-center font-mono font-medium">15–20 días</td>
                <td class="py-3.5 px-3 text-center font-mono font-medium">3–5 semanas</td>
              </tr>
              <tr>
                <td class="py-3.5 pr-4 font-medium text-light">Estructura</td>
                <td class="py-3.5 px-3 text-center">Landing Page</td>
                <td class="py-3.5 px-3 text-center">3–5 Páginas</td>
                <td class="py-3.5 px-3 text-center text-violet-300 bg-white/[0.03]">3–5 Páginas</td>
                <td class="py-3.5 px-3 text-center">Catálogo + Carrito</td>
                <td class="py-3.5 px-3 text-center">Experiencia 3D</td>
              </tr>
              <tr>
                <td class="py-3.5 pr-4 font-medium text-light">Botón Directo WhatsApp</td>
                <td class="py-3.5 px-3 text-center text-emerald-400">✓</td>
                <td class="py-3.5 px-3 text-center text-emerald-400">✓</td>
                <td class="py-3.5 px-3 text-center text-emerald-400 font-bold bg-white/[0.03]">✓</td>
                <td class="py-3.5 px-3 text-center text-emerald-400">✓</td>
                <td class="py-3.5 px-3 text-center text-emerald-400">✓</td>
              </tr>
              <tr>
                <td class="py-3.5 pr-4 font-medium text-light">Chatbot Automatizado 24/7</td>
                <td class="py-3.5 px-3 text-center text-mute">—</td>
                <td class="py-3.5 px-3 text-center text-mute">—</td>
                <td class="py-3.5 px-3 text-center text-emerald-400 font-bold bg-white/[0.03]">✓ Incluido</td>
                <td class="py-3.5 px-3 text-center text-mute">—</td>
                <td class="py-3.5 px-3 text-center text-emerald-400">Opcional</td>
              </tr>
              <tr>
                <td class="py-3.5 pr-4 font-medium text-light">Agendamiento Automático de Citas</td>
                <td class="py-3.5 px-3 text-center text-mute">—</td>
                <td class="py-3.5 px-3 text-center text-mute">—</td>
                <td class="py-3.5 px-3 text-center text-emerald-400 font-bold bg-white/[0.03]">✓ Incluido</td>
                <td class="py-3.5 px-3 text-center text-mute">—</td>
                <td class="py-3.5 px-3 text-center text-emerald-400">✓</td>
              </tr>
              <tr>
                <td class="py-3.5 pr-4 font-medium text-light">Pasarela de Pagos (Stripe / PSE / Bold)</td>
                <td class="py-3.5 px-3 text-center text-mute">—</td>
                <td class="py-3.5 px-3 text-center text-mute">—</td>
                <td class="py-3.5 px-3 text-center text-mute bg-white/[0.03]">—</td>
                <td class="py-3.5 px-3 text-center text-emerald-400 font-bold">✓ Incluido</td>
                <td class="py-3.5 px-3 text-center text-emerald-400">Opcional</td>
              </tr>
              <tr>
                <td class="py-3.5 pr-4 font-medium text-light">Correos Corporativos con Dominio</td>
                <td class="py-3.5 px-3 text-center text-mute">Opcional</td>
                <td class="py-3.5 px-3 text-center text-emerald-400">✓ Hasta 3</td>
                <td class="py-3.5 px-3 text-center text-emerald-400 font-bold bg-white/[0.03]">✓ Hasta 5</td>
                <td class="py-3.5 px-3 text-center text-emerald-400">✓ Hasta 5</td>
                <td class="py-3.5 px-3 text-center text-emerald-400">✓ Ilimitados</td>
              </tr>
              <tr>
                <td class="py-3.5 pr-4 font-medium text-light">Inversión Aproximada</td>
                <td class="py-3.5 px-3 text-center font-bold text-light">$249 USD</td>
                <td class="py-3.5 px-3 text-center font-bold text-light">$399 USD</td>
                <td class="py-3.5 px-3 text-center font-bold text-violet-300 bg-white/[0.03]">$490 USD</td>
                <td class="py-3.5 px-3 text-center font-bold text-light">$590 USD</td>
                <td class="py-3.5 px-3 text-center font-bold text-light">Desde $950 USD</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Preguntas Frecuentes para Empresarios (FAQ) -->
      <section class="mb-24 max-w-3xl mx-auto" aria-labelledby="faq-title">
        <div class="text-center mb-10">
          <p class="text-xs uppercase tracking-[0.2em] text-mute font-medium">Dudas Resueltas</p>
          <h2 id="faq-title" class="mt-2 font-display text-3xl md:text-4xl text-light">
            Preguntas habituales antes de contratar
          </h2>
        </div>

        <div class="space-y-4">
          {plansFaq.map((faq, idx) => (
            <details class="glass group rounded-2xl border border-white/10 p-5 sm:p-6 transition-all duration-200 open:bg-white/[0.04]">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-sans text-base sm:text-lg font-semibold text-light list-none">
                <span>{faq.q}</span>
                <span class="size-6 shrink-0 rounded-full border border-white/10 flex items-center justify-center text-xs text-mute transition-transform group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 text-sm leading-relaxed text-mute border-t border-white/10 pt-4">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <!-- CTA de Cierre -->
      <section class="glass rounded-[2.5rem] p-8 md:p-14 text-center border border-white/10" aria-label="Llamado a la acción">
        <h2 class="font-display text-3xl md:text-5xl text-light">
          ¿No tienes claro cuál es el plan para tu negocio?
        </h2>
        <p class="mt-4 max-w-xl mx-auto text-base text-mute">
          Escríbenos por WhatsApp o déjanos un mensaje. En 10 minutos evaluamos tu caso y te recomendamos exactamente lo que necesitas sin gastar de más.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a
            href={waLink('Hola Rembrandt Studio, quiero asesoría para elegir el plan ideal para mi negocio.')}
            target="_blank"
            rel="noopener"
            class="btn btn-light"
            data-magnetic="0.3"
          >
            Consultar por WhatsApp
          </a>
          <a
            href="/contacto"
            class="btn btn-ghost"
            data-magnetic="0.3"
          >
            Ir a formulario de contacto
          </a>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
