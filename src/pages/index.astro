---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero3D from '../components/Hero3D.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';

// Casos de éxito seleccionados (Obras de Alto Impacto)
const featuredWorks = [
  {
    title: 'Kroma Studio',
    category: 'Fintech & Consultoría Tech',
    challenge: 'Rebranding completo y experiencia web inmersiva para levantar ronda Serie A.',
    result: '+42% en demos cualificadas y premio mención de honor de diseño.',
    tech: ['Astro', 'Three.js 3D', 'GSAP', 'Tailwind'],
    gradient: 'from-purple-900/40 via-purple-950/20 to-black',
    accentColor: '#8b5cf6',
  },
  {
    title: 'Vértice Arquitectura',
    category: 'Estudio de Arquitectura & Lujo',
    challenge: 'Sustituir una web lenta en WordPress por un portafolio fotográfico editorial ultrarrápido.',
    result: 'Carga en 0.6s (antes 4.2s), 100/100 Core Web Vitals y +180% en solicitudes de proyecto.',
    tech: ['Astro', 'Decap CMS', 'Tailwind CSS'],
    gradient: 'from-indigo-950/40 via-purple-950/20 to-black',
    accentColor: '#a855f7',
  },
  {
    title: 'Aura Botanics',
    category: 'E-Commerce de Cosmética de Autor',
    challenge: 'Tienda online de ticket alto con experiencia sensorial y pasarelas de pago local e internacional.',
    result: '+35% tasa de conversión en checkout durante los primeros 60 días.',
    tech: ['Shopify Headless', 'Astro', 'Wompi & Stripe'],
    gradient: 'from-fuchsia-950/40 via-purple-950/20 to-black',
    accentColor: '#c084fc',
  },
];

// Escalera de valor (Planes comerciales con entrega ágil internacional)
const valueLadder = [
  {
    tier: 'Nivel 1 &bull; Volumen',
    name: 'Landing Express',
    badge: '⚡ Entrega en 24–48h',
    price: '$249 USD',
    priceCop: '~$990.000 COP',
    forWhom: 'Negocios locales, pymes, profesionales y marcas que necesitan captar clientes inmediatamente sin semanas de espera.',
    includes: [
      'Página única de aterrizaje diseñada con foco en conversión directa',
      'Entrega garantizada en 24 a 48 horas hábiles',
      'Botón flotante directo a WhatsApp & formulario de captación',
      'Hosting cloud ultraveloz + dominio .com incluido por 1 año',
      '100/100 Core Web Vitals (carga instantánea en móvil y desktop)',
      '1 ronda de revisión ágil y puesta en marcha inmediata',
    ],
    ctaText: 'Pedir Landing Express (24–48h)',
    ctaLink: '/express',
    featured: false,
  },
  {
    tier: 'Nivel 2 &bull; Autoridad',
    name: 'Web Corporativa Multi-Sección',
    badge: '★ El más solicitado',
    price: '$399 USD',
    priceCop: '~$1.590.000 COP',
    forWhom: 'Empresas y marcas de servicios que necesitan proyectar estatus, múltiples páginas y posicionamiento en Google.',
    includes: [
      'Sitio web completo: Inicio, Servicios, Nosotros, Portafolio y Contacto',
      'Entrega en 3 a 5 días hábiles',
      'Estructura SEO optimizada para búsquedas en Google',
      'Diseño exclusivo con paleta y tipografía adaptadas a tu marca',
      'Integración con CRM, analítica GA4 y WhatsApp Business',
      '2 rondas de revisión por fase y soporte post-lanzamiento',
    ],
    ctaText: 'Iniciar Web Corporativa',
    ctaLink: '#contacto',
    featured: true,
  },
  {
    tier: 'Nivel 3 &bull; Escala',
    name: 'Catálogo / Tienda Ágil / 3D',
    badge: 'Alta Fidelidad',
    price: '$690 – $1.490 USD',
    priceCop: '~$2.7M – $5.9M COP',
    forWhom: 'Marcas con catálogo de productos, venta online directa o proyectos que buscan experiencias interactivas 3D de autor.',
    includes: [
      'Catálogo interactivo o tienda con pasarela de pago (Wompi, Stripe, PayPal)',
      'Integración 3D Spline / WebGL interactiva de autor',
      'Automatización de pedidos con alerta inmediata a WhatsApp y correo',
      'Entrega en 7 a 10 días hábiles',
      'Optimización extrema de velocidad y tasa de conversión',
      'Capacitación para autogestionar productos y precios',
    ],
    ctaText: 'Cotizar Proyecto a Medida',
    ctaLink: '#contacto',
    featured: false,
  },
];

// Proceso de trabajo
const steps = [
  {
    number: '01',
    title: 'Discovery & Estrategia',
    text: 'Entendemos tu modelo de negocio, tu cliente ideal y los números que la web debe mover antes de trazar un solo pixel.',
  },
  {
    number: '02',
    title: 'Dirección de Arte & Figma',
    text: 'Diseñamos una interfaz única que proyecta autoridad y estatus. Revisamos juntos el prototipo interactivo antes de programar.',
  },
  {
    number: '03',
    title: 'Ingeniería, 3D & Rendimiento',
    text: 'Construimos con código limpio en Astro y WebGL. Cero plugins innecesarios, máxima seguridad y velocidad instantánea.',
  },
  {
    number: '04',
    title: 'QA, Lanzamiento & Cuidado',
    text: 'Pruebas rigurosas en dispositivos móviles reales, indexación en Google y activación del plan de mantenimiento continuo.',
  },
];
---

<BaseLayout
  title="Rembrandt Studio | Diseño Web de Alto Impacto, 3D & Digital Craft"
  description="Estudio de diseño y desarrollo web. Experiencias inmersivas 3D, ingeniería ultraligera y webs orientadas a negocio que transmiten confianza."
>
  <Header theme="dark" />

  <main id="contenido" class="bg-[#0a0a0d] text-white">
    {/* 1. Hero Asimétrico 3D inspirado en AgentAI */}
    <Hero3D />

    {/* 2. Manifiesto Editorial (Como en la referencia) */}
    <section class="mx-auto max-w-5xl px-6 py-20 sm:py-28 text-center sm:text-left border-b border-white/10 relative">
      <div class="inline-flex items-center gap-2 rounded-full border border-accent/40 bg-accent/10 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-accent mb-6 shadow-[0_0_12px_rgba(139,92,246,0.2)]">
        <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse"></span>
        <span>Manifiesto del Taller</span>
      </div>
      <h2 class="font-display text-2xl sm:text-4xl md:text-5xl font-medium tracking-tight text-white leading-snug text-balance">
        Diseñamos y programamos <span class="text-accent underline decoration-accent/40 decoration-wavy">soluciones web</span> con foco en las personas, garantizando que cada <span class="bg-gradient-to-r from-violet-400 via-fuchsia-400 to-purple-500 bg-clip-text text-transparent font-bold">sistema e interacción</span> eleve la conversión y el estatus real de tu marca.
      </h2>
    </section>

    {/* 3. Bento Grid Principal (About, Ubicación Global & Confianza de Autor) */}
    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        {/* Bento Card Grande Izquierda */}
        <div class="lg:col-span-7 rounded-3xl border border-white/10 bg-[#121217]/80 p-8 sm:p-10 flex flex-col justify-between backdrop-blur-xl relative overflow-hidden group shadow-2xl">
          <div class="pointer-events-none absolute -right-20 -bottom-20 h-72 w-72 rounded-full bg-accent/15 blur-3xl group-hover:bg-accent/25 transition-all"></div>
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-white/70 mb-5">
              <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Disponible para proyectos inmediatos</span>
            </div>
            <h3 class="text-2xl sm:text-4xl font-bold text-white leading-tight">
              Basado en <span class="text-accent">Colombia</span> &bull; Despliegue Global
            </h3>
            <p class="mt-4 text-sm sm:text-base text-white/60 max-w-lg leading-relaxed font-light">
              Operamos como un taller de alta ingeniería digital. Sin burocracia, sin reuniones eternas y con entregas récord desde 24 a 48 horas en Astro, Tailwind y 3D WebGL.
            </p>
          </div>

          <div class="mt-10 rounded-2xl bg-gradient-to-r from-purple-950/40 via-violet-950/20 to-black border border-white/10 p-6 flex items-center justify-between">
            <div>
              <span class="text-xs uppercase font-mono text-accent font-semibold block">Entrega Express</span>
              <span class="text-lg font-bold text-white">¿Necesitas lanzar esta semana?</span>
            </div>
            <a
              href="/express"
              class="rounded-full bg-accent px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-lg shadow-accent/30 hover:bg-accent-strong transition-all shrink-0"
            >
              Ver Express &rarr;
            </a>
          </div>
        </div>

        {/* Bento Columna Derecha: Métricas y Cita de Autor */}
        <div class="lg:col-span-5 flex flex-col gap-6">
          {/* Card 1: Métricas de satisfacción */}
          <div class="rounded-3xl border border-white/10 bg-[#121217]/80 p-8 backdrop-blur-xl flex flex-col justify-between shadow-2xl">
            <span class="text-xs text-white/60 leading-relaxed block">
              Confiado por clientes y marcas en 4 industrias &bull; Desplegando desde la idea a producción en 24–48 horas.
            </span>
            <div class="mt-6 flex items-baseline justify-between pt-4 border-t border-white/10">
              <div class="flex items-center gap-1 text-amber-400 text-lg">
                ★★★★★
              </div>
              <span class="font-display text-5xl font-extrabold text-white tracking-tight">100%</span>
            </div>
          </div>

          {/* Card 2: Testimonio con Foto/Quote estilo AgentAI */}
          <div class="rounded-3xl border border-white/10 bg-[#121217]/80 p-6 sm:p-8 backdrop-blur-xl flex items-center gap-5 shadow-2xl">
            <div class="h-16 w-16 shrink-0 rounded-2xl bg-gradient-to-tr from-accent to-purple-900 border border-white/20 flex items-center justify-center font-display text-2xl font-bold text-white shadow-[0_0_15px_rgba(139,92,246,0.4)]">
              FD
            </div>
            <div>
              <p class="text-xs sm:text-sm italic text-white/80 leading-relaxed font-light">
                "El buen software y el diseño de autor parecen obvios — porque todo el trabajo complejo de ingeniería queda oculto."
              </p>
              <div class="mt-2 text-xs">
                <strong class="text-white">Farid Diaz</strong>
                <span class="text-white/40"> &bull; Rembrandt Lead Engineer</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 4. Cinta Marquee de Tecnologías (Logo Ribbon) */}
    <section class="border-y border-white/10 bg-black/60 py-6 overflow-hidden">
      <div class="mx-auto max-w-6xl px-6 flex flex-wrap items-center justify-between gap-6 text-xs uppercase tracking-widest text-white/40 font-mono">
        <span class="text-white/60 font-semibold">Tecnologías de Autor:</span>
        <span class="hover:text-accent transition-colors">Astro v5</span>
        <span class="hover:text-accent transition-colors">Tailwind CSS</span>
        <span class="hover:text-accent transition-colors">WebGL / Three.js</span>
        <span class="hover:text-accent transition-colors">Spline 3D</span>
        <span class="hover:text-accent transition-colors">TypeScript</span>
        <span class="hover:text-accent transition-colors">Vercel Edge</span>
      </div>
    </section>

    {/* 3. Obras Seleccionadas (Portafolio de Alto Impacto) */}
    <section id="obras" class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-16">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.3em] text-accent">
            Portafolio Seleccionado
          </span>
          <h2 class="mt-2 text-3xl sm:text-5xl font-bold tracking-tight text-white">
            Obras que generan resultados.
          </h2>
        </div>
        <p class="max-w-md text-sm text-white/60 leading-relaxed">
          No creamos catálogos genéricos. Cada proyecto resuelve un reto comercial concreto y eleva la percepción de valor de la marca.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-3">
        {
          featuredWorks.map((work) => (
            <article
              data-claroscuro-card
              class="claroscuro-card group relative rounded-2xl border border-white/10 p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 hover:border-accent/60 hover:-translate-y-1 overflow-hidden"
            >
              <div class="relative z-10">
                <div class="flex items-center justify-between gap-2 mb-4">
                  <span class="text-xs font-mono uppercase tracking-wider text-accent font-medium">
                    {work.category}
                  </span>
                  <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent shadow-[0_0_6px_#8b5cf6]"></span>
                </div>

                <h3 class="text-2xl font-bold text-white group-hover:text-accent transition-colors">
                  {work.title}
                </h3>

                <p class="mt-4 text-sm text-white/70 leading-relaxed">
                  <strong class="text-white/90 block mb-1">El reto:</strong>
                  {work.challenge}
                </p>

                <div class="mt-5 rounded-lg border border-accent/20 bg-accent/10 p-3">
                  <span class="text-xs font-semibold text-accent block">Impacto medible:</span>
                  <p class="text-xs text-white/90 mt-1 font-medium">{work.result}</p>
                </div>
              </div>

              <div class="mt-8 pt-6 border-t border-white/10 relative z-10">
                <div class="flex flex-wrap gap-2 mb-5">
                  {work.tech.map((t) => (
                    <span class="rounded-full bg-white/5 border border-white/10 px-2.5 py-0.5 text-[11px] font-mono text-white/60">
                      {t}
                    </span>
                  ))}
                </div>

                <a
                  href="#contacto"
                  class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-white hover:text-accent transition-colors"
                >
                  <span>Quiero un proyecto similar</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {/* 4. Selector de Camino & Escalera de Valor */}
    <section id="escalera" class="border-y border-white/10 bg-[#0d0d12] py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <div class="text-center max-w-3xl mx-auto mb-20">
          <span class="text-xs font-semibold uppercase tracking-[0.3em] text-accent">
            La Escalera de Valor
          </span>
          <h2 class="mt-3 text-3xl sm:text-5xl font-bold tracking-tight text-white">
            Un nivel para cada etapa de tu negocio.
          </h2>
          <p class="mt-4 text-sm sm:text-base text-white/60 leading-relaxed">
            Desde soluciones express listas para vender en 7 días hasta experiencias 3D inmersivas de alta costura digital. Tú eliges el alcance, nosotros garantizamos la excelencia.
          </p>
        </div>

        <div class="grid gap-8 lg:grid-cols-3 items-stretch">
          {
            valueLadder.map((plan) => (
              <div
                data-claroscuro-card
                class={
                  plan.featured
                    ? 'claroscuro-card relative rounded-2xl border-2 border-accent p-8 flex flex-col justify-between shadow-2xl shadow-accent/20 overflow-hidden'
                    : 'claroscuro-card relative rounded-2xl border border-white/10 p-8 flex flex-col justify-between hover:border-white/20 transition-all overflow-hidden'
                }
              >
                {plan.featured && (
                  <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-accent px-4 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-[0_0_15px_#8b5cf6] z-20">
                    {plan.badge}
                  </span>
                )}

                <div class="relative z-10">
                  <div class="flex items-center justify-between gap-2">
                    <span class="text-xs font-mono uppercase tracking-widest text-white/50">
                      {plan.tier}
                    </span>
                    {!plan.featured && (
                      <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-white/5 text-white/60 border border-white/5">
                        {plan.badge}
                      </span>
                    )}
                  </div>

                  <h3 class="mt-3 text-2xl font-bold text-white">{plan.name}</h3>

                  <div class="mt-4 pb-5 border-b border-white/10">
                    <span class="text-2xl sm:text-3xl font-extrabold text-white block">
                      {plan.price}
                    </span>
                    <span class="text-xs font-mono text-white/50">{plan.priceCop}</span>
                  </div>

                  <p class="mt-5 text-xs sm:text-sm text-white/70 leading-relaxed">
                    {plan.forWhom}
                  </p>

                  <ul class="mt-6 space-y-3 text-xs text-white/80">
                    {plan.includes.map((item) => (
                      <li class="flex items-start gap-2.5">
                        <svg class="h-4 w-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mt-8 pt-6 border-t border-white/10 relative z-10">
                  <a
                    href={plan.ctaLink}
                    class={
                      plan.featured
                        ? 'btn-firma group relative inline-flex flex-col items-center justify-center w-full rounded-lg bg-accent py-3.5 text-center text-xs font-bold uppercase tracking-wider text-white transition-all hover:bg-accent-strong shadow-lg shadow-accent/30 overflow-hidden'
                        : 'group relative inline-flex flex-col items-center justify-center w-full rounded-lg border border-white/20 bg-white/5 py-3.5 text-center text-xs font-semibold uppercase tracking-wider text-white transition-all hover:bg-white/10 overflow-hidden'
                    }
                  >
                    <span>{plan.ctaText}</span>
                    <svg class="firma-stroke absolute bottom-1 h-2 w-20 pointer-events-none" viewBox="0 0 320 60" aria-hidden="true">
                      <path pathLength="1" d="M10 42 C 38 12, 65 52, 98 28 S 145 18, 180 38 C 215 52, 235 18, 265 25 C 290 30, 302 44, 314 28" />
                    </svg>
                  </a>
                </div>
              </div>
            ))
          }
        </div>

        {/* Mención especial del Plan Cuidado Recurrente */}
        <div class="mt-12 rounded-xl border border-white/10 bg-white/[0.02] p-6 text-center max-w-2xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-left">
            <h4 class="text-sm font-semibold text-white">¿Tienes ya una web o quieres soporte continuo?</h4>
            <p class="text-xs text-white/60 mt-0.5">Plan Cuidado desde $19 USD/mes (~$79.000 COP/mes) &bull; Hosting ultraveloz, soporte técnico y copias de seguridad.</p>
          </div>
          <a href="#contacto" class="text-xs uppercase font-semibold text-accent hover:underline shrink-0">
            Consultar mantenimiento &rarr;
          </a>
        </div>
      </div>
    </section>

    {/* 5. Cómo Trabajamos (Proceso transparente) */}
    <section id="proceso" class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-semibold uppercase tracking-[0.3em] text-accent">
          Certeza & Control
        </span>
        <h2 class="mt-3 text-3xl sm:text-5xl font-bold tracking-tight text-white">
          Cómo trabajamos: sin sorpresas ni retrasos.
        </h2>
        <p class="mt-3 text-sm text-white/60">
          Un proceso ágil con entregas por fases, comunicación directa y calendario cerrado.
        </p>
      </div>

      <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((step) => (
            <li class="relative rounded-xl border border-white/10 bg-[#111116] p-6 flex flex-col justify-between">
              <div>
                <span class="font-mono text-xs font-bold text-accent px-2 py-1 rounded bg-accent/10 border border-accent/20">
                  {step.number}
                </span>
                <h3 class="mt-4 text-lg font-bold text-white">{step.title}</h3>
                <p class="mt-2 text-xs leading-relaxed text-white/60">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {/* 6. Testimonio / Social Proof */}
    <section class="border-y border-white/10 bg-gradient-to-r from-purple-950/20 via-black to-indigo-950/20 py-20">
      <div class="mx-auto max-w-4xl px-6 text-center">
        <div class="inline-flex items-center gap-1 text-accent mb-6">
          {Array.from({ length: 5 }).map(() => (
            <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <blockquote class="font-display text-xl sm:text-3xl font-medium tracking-tight text-white leading-snug">
          &ldquo;Rembrandt no nos hizo una plantilla común de agencia: transformó nuestra presencia web en una herramienta que cierra clientes antes de que abramos la boca. La inversión se pagó sola en el primer trimestre.&rdquo;
        </blockquote>
        <div class="mt-6">
          <p class="font-semibold text-sm text-white">Dirección General</p>
          <p class="text-xs text-white/50">Kroma Advisory &bull; Cliente Corporativo</p>
        </div>
      </div>
    </section>

    {/* 7. Formulario de Contacto / Intake */}
    <section id="contacto" class="border-t border-white/10 bg-[#0a0a0d]">
      <div class="mx-auto grid max-w-6xl gap-12 px-6 py-24 sm:py-32 lg:grid-cols-2">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.3em] text-accent">
            Iniciemos una conversación
          </span>
          <h2 class="mt-2 text-3xl sm:text-5xl font-bold tracking-tight text-white">
            Cuéntanos tu proyecto.
          </h2>
          <p class="mt-4 text-sm sm:text-base text-white/60 leading-relaxed">
            Completa el formulario en menos de 1 minuto. Evaluamos tu necesidad técnica y te contestamos con una propuesta clara y transparente en 24–48 horas.
          </p>

          <dl class="mt-10 space-y-4 text-xs sm:text-sm text-white/70">
            <div class="flex items-center gap-3">
              <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <dt class="font-medium text-white">WhatsApp directo:</dt>
              <dd>
                <a
                  href="https://wa.me/573147714202?text=Hola%20Rembrandt%20Studio%2C%20quiero%20cotizar%20un%20proyecto%20web"
