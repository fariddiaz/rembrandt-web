---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Plans from '../components/Plans.astro';
import Work from '../components/Work.astro';
import Process from '../components/Process.astro';
import CarePlan from '../components/CarePlan.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="Rembrandt Studio · Webs de Alto Rendimiento, Tiendas & 3D que Venden"
  description="Estudio de ingeniería digital y diseño web de autor. Entregamos páginas web express en 4 a 6 días hábiles, soluciones corporativas con automatización en WhatsApp y experiencias 3D interactivas."
>
  <Header />
  <main class="relative z-[2]">
    <Hero />
    <Manifesto />
    <Plans />
    <Work />
    <Process />
    <CarePlan />
    <Contact />
  </main>
  <Footer />
</Layout>
