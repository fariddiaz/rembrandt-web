---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import { waLink, waSections, CONTACT_EMAIL, CALENDLY_LINK } from '../config/site';

const wa = waSections.contacto;
---
<Layout
  title="Contacto y Cotización · Rembrandt Studio | WhatsApp, Llamada o Correo"
  description="Cotiza tu página web profesional en minutos. Atención personalizada en Colombia, EE.UU. e internacional vía WhatsApp, videollamada o correo."
>
  <Header activePath="/contacto" />

  <main class="relative z-[2] pt-28 pb-24 md:pt-36 md:pb-32">
    <!-- Fondo claroscuro de arte: Autorretrato con dos círculos (1665) -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden opacity-10" aria-hidden="true">
      <img
        src="/art/selfportrait.webp"
        alt=""
        class="size-full object-cover filter grayscale contrast-125 brightness-75"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-carbon via-carbon/90 to-carbon"></div>
    </div>

    <div class="mx-auto w-[min(1240px,calc(100%-2.5rem))]">
      
      <!-- Encabezado Editorial -->
      <header class="mb-14 md:mb-16 text-center max-w-3xl mx-auto">
        <p class="text-xs uppercase tracking-[0.22em] text-mute font-medium">
          Atención Global · Colombia, EE.UU. & Internacional
        </p>
        <h1 class="mt-4 font-display text-[clamp(2.6rem,5.5vw,5rem)] leading-[0.98] text-light max-sm:text-[2.3rem]">
          Hablemos de tu proyecto.<br />
          <span class="text-gold">
            Cotiza en minutos.
          </span>
        </h1>
        <p class="mt-5 text-base md:text-lg leading-relaxed text-mute">
          Selecciona el método de contacto que prefieras: escríbenos directamente por WhatsApp para una respuesta inmediata, agenda una videollamada de 15 minutos o completa el formulario express.
        </p>
      </header>

      <!-- Bento Grid de Contacto Internacional: Canales Directos (izq) + Formulario Express (der) -->
      <div class="grid gap-8 lg:grid-cols-12 lg:items-start">
        
        <!-- Columna Izquierda (5 cols): Canales Directos & Compromisos -->
        <div class="flex flex-col gap-4 lg:col-span-5">
          
          <!-- Canal 1: WhatsApp Business (Inmediatez) -->
          <a
            href={waLink(wa.message)}
            target="_blank"
            rel="noopener"
            class="glass group relative flex items-start gap-4 rounded-2xl p-5 sm:p-6 transition-all duration-300 hover:border-violet/40 hover:bg-white/[0.04] max-md:active:scale-[0.98]"
            data-magnetic="0.2"
          >
            <div class="grid size-12 shrink-0 place-items-center rounded-xl bg-emerald-500/10 text-emerald-300 ring-1 ring-emerald-500/30 group-hover:bg-emerald-500/20 transition-colors">
              <svg class="size-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.585 1.961.947 2.801.947h.005c3.18 0 5.767-2.586 5.768-5.766 0-1.54-.599-2.989-1.688-4.079-1.09-1.089-2.54-1.687-4.08-1.687m0-2c3.729 0 7.228 2.914 7.228 7.766 0 4.853-3.499 7.766-7.228 7.766-.99 0-2.148-.278-3.093-.787l-4.938 1.294 1.319-4.819c-.645-1.055-.957-2.222-.956-3.454 0-4.852 3.499-7.766 7.228-7.766" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h2 class="font-semibold text-light text-base group-hover:text-emerald-300 transition-colors">WhatsApp Business</h2>
                <span class="rounded-md border border-emerald-500/20 bg-emerald-500/5 px-2 py-0.5 text-[0.68rem] text-emerald-300 font-mono">Respuesta &lt; 5 min</span>
              </div>
              <p class="mt-1 text-xs text-mute leading-relaxed">
                Ideal para consultas rápidas, dudas sobre planes o envío de referencias por audio y fotos.
              </p>
              <span class="mt-2.5 inline-flex items-center gap-1.5 text-xs font-semibold text-light group-hover:text-emerald-300">
                Escribir al WhatsApp oficial <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>

          <!-- Canal 2: Videollamada de 15 Minutos (Cal.com / Google Meet) -->
          <a
            href={CALENDLY_LINK}
            class="glass group relative flex items-start gap-4 rounded-2xl p-5 sm:p-6 transition-all duration-300 hover:border-violet/40 hover:bg-white/[0.04] max-md:active:scale-[0.98]"
            data-magnetic="0.2"
          >
            <div class="grid size-12 shrink-0 place-items-center rounded-xl bg-violet-500/10 text-violet-300 ring-1 ring-violet-500/30 group-hover:bg-violet-500/20 transition-colors">
              <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 9v7.5" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h2 class="font-semibold text-light text-base group-hover:text-violet-300 transition-colors">Videollamada de 15 min</h2>
                <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 text-[0.68rem] text-violet-300 font-mono">Google Meet / Zoom</span>
              </div>
              <p class="mt-1 text-xs text-mute leading-relaxed">
                Excelente para clientes de EE.UU. o empresas que deseen evaluar requerimientos específicos y alinear alcance.
              </p>
              <span class="mt-2.5 inline-flex items-center gap-1.5 text-xs font-semibold text-light group-hover:text-violet-300">
                Agendar videollamada en línea <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>

          <!-- Canal 3: Correo Corporativo Oficial -->
          <a
            href={`mailto:${CONTACT_EMAIL}?subject=Cotización%20Proyecto%20Web%20-%20Rembrandt%20Studio`}
            class="glass group relative flex items-start gap-4 rounded-2xl p-5 sm:p-6 transition-all duration-300 hover:border-violet/40 hover:bg-white/[0.04] max-md:active:scale-[0.98]"
            data-magnetic="0.2"
          >
            <div class="grid size-12 shrink-0 place-items-center rounded-xl bg-amber-500/10 text-amber-300 ring-1 ring-amber-500/30 group-hover:bg-amber-500/20 transition-colors">
              <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h2 class="font-semibold text-light text-base group-hover:text-amber-300 transition-colors">Correo Corporativo</h2>
                <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 text-[0.68rem] text-mute font-mono">Global</span>
              </div>
              <p class="mt-1 text-xs text-mute leading-relaxed">
                Para pliegos de condiciones, solicitudes de propuesta formal (RFP) o facturación corporativa.
              </p>
              <span class="mt-2.5 inline-flex items-center gap-1.5 text-xs font-mono font-medium text-amber-300 group-hover:text-light transition-colors">
                {CONTACT_EMAIL} <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>

          <!-- Bloque de Garantías Rembrandt -->
          <div class="glass rounded-2xl border border-white/10 p-5 backdrop-blur-md">
            <p class="text-xs font-semibold uppercase tracking-wider text-light/80 mb-3">Compromisos Rembrandt Studio</p>
            <ul class="space-y-2 text-xs text-mute">
              <li class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-violet-400"></span>
                <span><strong>Entrega de 4 a 6 días:</strong> Garantía estricta en planes express (rápido y perfecto).</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-violet-400"></span>
                <span><strong>Pagos Internacionales:</strong> Facturación en USD o COP vía Stripe, Bold o PSE.</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-violet-400"></span>
                <span><strong>Código 100% tuyo:</strong> Sin contratos de permanencia ni plataformas cautivas.</span>
              </li>
            </ul>
          </div>

        </div>

        <!-- Columna Derecha (7 cols): Formulario Express en Liquid Glass -->
        <div class="lg:col-span-7">
          <ContactForm />
        </div>

      </div>

    </div>
  </main>

  <Footer />
</Layout>
