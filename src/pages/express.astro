---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Número de WhatsApp oficial
const WHATSAPP_PHONE = '573147714202';
const baseWaUrl = `https://wa.me/${WHATSAPP_PHONE}`;

const expressPlans = [
  {
    name: 'Landing Express',
    tag: '⚡ 3 a 5 Días',
    priceUsd: '$249 USD',
    priceCop: '~$990.000 COP',
    forWhom: 'Profesionales, pymes y campañas de pauta que necesitan captar clientes inmediatamente sin semanas de espera.',
    features: [
      'Página única (One-Page) con arquitectura de alta conversión',
      'Entrega garantizada en 3 a 5 días hábiles',
      'Botón flotante directo a tu WhatsApp + formulario de captación',
      'Dominio .com + Hosting SSL ultraveloz gratis por 1 año',
      'Puntuación 100/100 en Google PageSpeed (carga en <0.8s)',
      '1 ronda de revisión y puesta en marcha inmediata',
    ],
    waMessage: 'Hola Rembrandt Studio, me interesa el paquete Landing Express ($249 USD / $990.000 COP) con entrega en 3 a 5 días.',
    featured: false,
  },
  {
    name: 'Web Multi-Sección',
    tag: '★ El más solicitado',
    priceUsd: '$399 USD',
    priceCop: '~$1.590.000 COP',
    forWhom: 'Empresas y marcas de servicios que necesitan proyectar estatus, autoridad y posicionarse en Google.',
    features: [
      'Sitio completo: Inicio, Servicios, Nosotros, Portafolio y Contacto',
      'Entrega garantizada en 3 a 5 días hábiles',
      'Estructura SEO avanzada para búsquedas en Google',
      'Diseño exclusivo adaptado a los colores y tipografía de tu marca',
      'Integración con CRM, analítica GA4 y WhatsApp Business',
      '2 rondas de revisión por fase y soporte post-lanzamiento',
    ],
    waMessage: 'Hola Rembrandt Studio, me interesa la Web Multi-Sección ($399 USD / $1.590.000 COP).',
    featured: true,
  },
  {
    name: 'Catálogo & Tienda Ágil',
    tag: '🛍️ Venta Directa',
    priceUsd: '$590 USD',
    priceCop: '~$2.390.000 COP',
    forWhom: 'Comercios, restaurantes o marcas que quieren vender productos y recibir pedidos automáticos por WhatsApp o tarjeta.',
    features: [
      'Catálogo interactivo con hasta 25 productos categorizados',
      'Entrega en 5 a 7 días hábiles',
      'Pasarela de pago local e internacional (Wompi, Stripe, PSE)',
      'Botón de pedido directo a WhatsApp con resumen de compra',
      'Panel ágil para actualizar precios, productos y fotos',
      'Optimización extrema de velocidad para compra móvil',
    ],
    waMessage: 'Hola Rembrandt Studio, me interesa el Catálogo / Tienda Ágil ($590 USD / $2.390.000 COP).',
    featured: false,
  },
];

const faqs = [
  {
    q: '¿Cómo pueden entregar una web profesional en solo 3 a 5 días?',
    a: 'Porque eliminamos toda la burocracia que engorda a las agencias tradicionales. Usamos arquitectura modular de código limpio en Astro, componentes optimizados y un proceso estandarizado sin reuniones de 3 horas. Tú nos das los datos en 5 minutos y nosotros construimos sin distracciones.',
  },
  {
    q: '¿Qué pasa si no tengo fotos o textos listos?',
    a: 'No te preocupes. Redactamos textos comerciales persuasivos adaptados a tu nicho y utilizamos fotografía profesional de alta calidad de bancos de imágenes con licencia comercial incluida.',
  },
  {
    q: '¿Cómo es el proceso de pago?',
    a: 'Cobramos un 50% de anticipo para asegurar tu fecha de inicio en el taller y el 50% restante únicamente cuando revises tu web terminada y des tu aprobación final antes del lanzamiento.',
  },
  {
    q: '¿Qué medios de pago aceptan en Colombia e internacionalmente?',
    a: 'Para Colombia: Bancolombia, Nequi, Daviplata o PSE. Para clientes internacionales (EE.UU., España, México, Latam): Stripe, Tarjeta de Crédito/Débito y PayPal.',
  },
  {
    q: '¿Qué incluye el mantenimiento después de la entrega?',
    a: 'Tu primer año de hosting y dominio ya está cubierto. Adicionalmente ofrecemos el Plan Cuidado opcional por solo $19 USD/mes (~$79.000 COP/mes) para que nunca tengas que preocuparte por copias de seguridad, actualizaciones técnicas o soporte.',
  },
];
---

<BaseLayout
  title="Boceto Express | Tu Web Lista en 3 a 5 Días | Rembrandt Studio"
  description="Páginas web profesionales para pymes y emprendedores entregadas en 3 a 5 días. Velocidad 100/100, dominio, hosting y WhatsApp incluidos desde $249 USD."
>
  <Header theme="dark" />

  <main id="contenido" class="bg-[#0a0a0d] text-white">
    {/* 1. Hero Express Directo a la Venta */}
    <section class="relative isolate overflow-hidden border-b border-white/10 px-6 pt-20 pb-24 sm:pt-28 sm:pb-32 text-center">
      {/* Halo de luz claroscuro */}
      <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_25%,rgba(139,92,246,0.22)_0%,rgba(10,10,13,0.95)_65%,#0a0a0d_100%)]"></div>

      <div class="mx-auto max-w-4xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-accent/40 bg-accent/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-accent mb-6 shadow-[0_0_15px_rgba(139,92,246,0.3)]">
          <span class="inline-block h-2 w-2 rounded-full bg-accent animate-pulse"></span>
          <span>Entrega Garantizada en 3 a 5 Días &bull; Cobertura Global</span>
        </div>

        <h1 class="font-display text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-white leading-tight">
          Tu página web lista para vender en <span class="text-accent underline decoration-accent/40 decoration-wavy">3 a 5 días.</span>
        </h1>

        <p class="mt-6 text-base sm:text-xl text-white/70 max-w-2xl mx-auto leading-relaxed">
          Sin reuniones de 3 horas. Sin presupuestos inflados. Código ultraveloz, diseño que genera confianza, dominio, hosting y WhatsApp directo incluidos.
        </p>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href="#planes"
            class="btn-firma group relative inline-flex flex-col items-center justify-center rounded-full bg-paper px-8 py-4 text-xs font-bold uppercase tracking-wider text-ink transition-all hover:bg-accent hover:text-white hover:scale-105 shadow-[0_0_25px_rgba(139,92,246,0.35)] overflow-hidden"
          >
            <span>Ver Planes desde $249 USD</span>
            <svg class="firma-stroke absolute bottom-1 h-2.5 w-24 pointer-events-none" viewBox="0 0 320 60" aria-hidden="true">
              <path pathLength="1" d="M10 42 C 38 12, 65 52, 98 28 S 145 18, 180 38 C 215 52, 235 18, 265 25 C 290 30, 302 44, 314 28" />
            </svg>
          </a>

          <a
            href={`${baseWaUrl}?text=${encodeURIComponent('Hola Rembrandt Studio, quiero hablar con ustedes sobre una web express.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-white/20 bg-white/5 px-8 py-4 text-xs font-semibold uppercase tracking-wider text-white backdrop-blur-sm transition-all hover:border-emerald-500/50 hover:bg-emerald-500/10 flex items-center gap-2"
          >
            <span class="inline-block h-2 w-2 rounded-full bg-emerald-400"></span>
            <span>Hablar por WhatsApp &rarr;</span>
          </a>
        </div>

        {/* Garantías de confianza */}
        <div class="mt-14 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs text-white/60">
          <div class="flex items-center gap-2">
            <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Dominio & Hosting incluido por 1 año</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>100/100 Core Web Vitals en Google</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>50% anticipo / 50% contra entrega</span>
          </div>
        </div>
      </div>
    </section>

    {/* 2. Planes Express Clave */}
    <section id="planes" class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-semibold uppercase tracking-[0.3em] text-accent">
          Precios Claros & Sin Letra Chica
        </span>
        <h2 class="mt-3 text-3xl sm:text-5xl font-bold tracking-tight text-white">
          Elige el plan ideal para tu negocio.
        </h2>
        <p class="mt-3 text-sm text-white/60">
          Precios transparentes en USD para clientes internacionales y en pesos colombianos (COP).
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-3 items-stretch">
        {
          expressPlans.map((plan) => (
            <div
              data-claroscuro-card
              class={
                plan.featured
                  ? 'claroscuro-card relative rounded-2xl border-2 border-accent p-8 flex flex-col justify-between shadow-2xl shadow-accent/20 overflow-hidden'
                  : 'claroscuro-card relative rounded-2xl border border-white/10 p-8 flex flex-col justify-between hover:border-white/20 transition-all overflow-hidden'
              }
            >
              {plan.featured && (
                <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-accent px-4 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-[0_0_15px_#8b5cf6] z-20">
                  {plan.tag}
                </span>
              )}

              <div class="relative z-10">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="text-2xl font-bold text-white">{plan.name}</h3>
                  {!plan.featured && (
                    <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-white/5 text-accent border border-accent/20">
                      {plan.tag}
                    </span>
                  )}
                </div>

                <div class="mt-4 pb-5 border-b border-white/10">
                  <span class="text-3xl sm:text-4xl font-extrabold text-white block">
                    {plan.priceUsd}
                  </span>
                  <span class="text-xs font-mono text-white/50">{plan.priceCop}</span>
                </div>

                <p class="mt-4 text-xs sm:text-sm text-white/70 leading-relaxed">
                  {plan.forWhom}
                </p>

                <ul class="mt-6 space-y-3 text-xs text-white/80">
                  {plan.features.map((feat) => (
                    <li class="flex items-start gap-2.5">
                      <svg class="h-4 w-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-8 pt-6 border-t border-white/10 relative z-10">
                <a
                  href={`${baseWaUrl}?text=${encodeURIComponent(plan.waMessage)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={
                    plan.featured
                      ? 'btn-firma group relative inline-flex flex-col items-center justify-center w-full rounded-lg bg-accent py-3.5 text-center text-xs font-bold uppercase tracking-wider text-white transition-all hover:bg-accent-strong shadow-lg shadow-accent/30 overflow-hidden'
                      : 'group relative inline-flex flex-col items-center justify-center w-full rounded-lg border border-white/20 bg-white/5 py-3.5 text-center text-xs font-semibold uppercase tracking-wider text-white transition-all hover:bg-white/10 overflow-hidden'
                  }
                >
                  <span class="flex items-center gap-2">
                    <span>Pedir por WhatsApp</span>
                    <span>&rarr;</span>
                  </span>
                  <svg class="firma-stroke absolute bottom-1 h-2 w-20 pointer-events-none" viewBox="0 0 320 60" aria-hidden="true">
                    <path pathLength="1" d="M10 42 C 38 12, 65 52, 98 28 S 145 18, 180 38 C 215 52, 235 18, 265 25 C 290 30, 302 44, 314 28" />
                  </svg>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    {/* 3. Cómo Funciona en 3 Pasos */}
    <section class="border-y border-white/10 bg-[#0d0d12] py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="text-xs font-semibold uppercase tracking-[0.3em] text-accent">
            Flujo Sin Fricción
          </span>
          <h2 class="mt-3 text-3xl sm:text-5xl font-bold tracking-tight text-white">
            Así de fácil tienes tu web lista.
          </h2>
          <p class="mt-3 text-sm text-white/60">
            Olvídate de procesos que tardan dos meses. En Rembrandt todo está pensado para tu velocidad.
          </p>
        </div>

        <div class="grid gap-8 md:grid-cols-3">
          <div class="rounded-xl border border-white/10 bg-[#121217] p-8">
            <span class="font-mono text-sm font-bold text-accent px-3 py-1 rounded bg-accent/10 border border-accent/20">
              Paso 01
            </span>
            <h3 class="mt-6 text-xl font-bold text-white">Eliges tu plan y brief de 5 min</h3>
            <p class="mt-3 text-xs sm:text-sm text-white/60 leading-relaxed">
              Nos escribes por WhatsApp con el paquete de tu preferencia y nos envías tu logo, teléfono y los servicios o productos que vendes.
            </p>
          </div>

          <div class="rounded-xl border border-white/10 bg-[#121217] p-8">
            <span class="font-mono text-sm font-bold text-accent px-3 py-1 rounded bg-accent/10 border border-accent/20">
              Paso 02
            </span>
            <h3 class="mt-6 text-xl font-bold text-white">Construimos en 3 a 5 días</h3>
            <p class="mt-3 text-xs sm:text-sm text-white/60 leading-relaxed">
              Programamos tu sitio con código limpio en Astro, diseño responsive para celular y optimización de velocidad extrema para que cargue al instante.
            </p>
          </div>

          <div class="rounded-xl border border-white/10 bg-[#121217] p-8">
            <span class="font-mono text-sm font-bold text-accent px-3 py-1 rounded bg-accent/10 border border-accent/20">
              Paso 03
            </span>
            <h3 class="mt-6 text-xl font-bold text-white">Revisión y puesta en marcha</h3>
            <p class="mt-3 text-xs sm:text-sm text-white/60 leading-relaxed">
              Te entregamos un enlace privado para revisar. Si necesitas algún ajuste puntual de texto o foto, lo hacemos de inmediato, conectamos tu dominio y queda en vivo vendiendo.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* 4. Preguntas Frecuentes (Anti-objeciones) */}
    <section class="mx-auto max-w-4xl px-6 py-24 sm:py-32">
      <div class="text-center max-w-xl mx-auto mb-16">
        <span class="text-xs font-semibold uppercase tracking-[0.3em] text-accent">
          Certeza Total
        </span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-white">
          Preguntas frecuentes.
        </h2>
      </div>

      <div class="space-y-4">
        {
          faqs.map((faq) => (
            <details class="group rounded-xl border border-white/10 bg-[#111116] p-6 transition-all duration-200 open:border-accent/50 open:bg-[#14121c]">
              <summary class="flex cursor-pointer list-none items-center justify-between text-base font-semibold text-white">
                <span>{faq.q}</span>
                <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-white/20 text-xs transition-transform group-open:rotate-180">
                  &darr;
                </span>
              </summary>
              <p class="mt-4 text-xs sm:text-sm text-white/70 leading-relaxed">
                {faq.a}
              </p>
            </details>
          ))
        }
      </div>

      {/* Banner final de cierre */}
      <div class="mt-16 rounded-2xl border border-accent/40 bg-gradient-to-r from-accent/20 via-black to-accent/10 p-8 sm:p-12 text-center">
        <h3 class="text-2xl sm:text-3xl font-bold text-white">¿Listo para lanzar tu web en tiempo récord?</h3>
        <p class="mt-3 text-xs sm:text-sm text-white/70 max-w-lg mx-auto">
          Escríbenos directamente a WhatsApp. Te atendemos de inmediato para asegurar tu cupo de entrega.
        </p>
        <div class="mt-8">
          <a
            href={`${baseWaUrl}?text=${encodeURIComponent('Hola Rembrandt Studio, estoy listo para iniciar mi web express en 3 a 5 días.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-paper px-8 py-4 text-xs font-bold uppercase tracking-wider text-ink transition-all hover:bg-accent hover:text-white hover:scale-105 shadow-[0_0_25px_rgba(139,92,246,0.4)]"
          >
            <span>Iniciar por WhatsApp Ahora</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    // Efecto Claroscuro en Tarjetas
    const cards = document.querySelectorAll<HTMLElement>('[data-claroscuro-card]');
    cards.forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  </script>
</BaseLayout>
