---
// Preview interactiva interna de Eventos Leymar
// Se carga dentro del modal sin bloqueos de X-Frame-Options ni dependencias externas
---
<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Eventos Leymar · Wedding Planner Cartagena</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: 'Montserrat', -apple-system, sans-serif;
        background-color: #0c0b0e;
        color: #f7f4ee;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      .font-serif-luxury {
        font-family: 'Cormorant Garamond', Georgia, serif;
      }
      .gold-gradient {
        background: linear-gradient(135deg, #d4af37 0%, #f3e5ab 50%, #aa771c 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .gold-bg {
        background: linear-gradient(135deg, #d4af37 0%, #aa771c 100%);
        color: #0c0b0e;
      }
      .glass-card {
        background: rgba(22, 20, 26, 0.75);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(212, 175, 55, 0.2);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      }
      .leymar-logo {
        height: 38px;
        max-height: 38px;
        width: auto;
        max-width: 140px;
        object-fit: contain;
        display: block;
      }
      .container {
        width: min(1140px, calc(100% - 2.5rem));
        margin-inline: auto;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 1.75rem;
        border-radius: 9999px;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-decoration: none;
        transition: all 0.25s ease;
        cursor: pointer;
      }
      .btn-gold {
        background: linear-gradient(135deg, #d4af37 0%, #aa771c 100%);
        color: #0c0b0e;
        box-shadow: 0 4px 20px rgba(212, 175, 55, 0.3);
      }
      .btn-gold:hover {
        filter: brightness(1.1);
        transform: translateY(-1px);
      }
      .btn-outline {
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.05);
        color: #ffffff;
      }
      .btn-outline:hover {
        background: rgba(255, 255, 255, 0.12);
      }
      /* Header styling */
      header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(12, 11, 14, 0.92);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding: 0.85rem 0;
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.75rem;
        list-style: none;
      }
      .nav-links a {
        color: #a3a1a8;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        text-decoration: none;
        transition: color 0.2s;
      }
      .nav-links a:hover {
        color: #d4af37;
      }
      @media (max-width: 768px) {
        .nav-links { display: none; }
      }
      /* Hero styling */
      .hero-sec {
        position: relative;
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 5rem 0 4rem;
        overflow: hidden;
      }
      .hero-glow {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at center, rgba(212, 175, 55, 0.12) 0%, transparent 68%);
        pointer-events: none;
      }
      .badge-gold {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 1rem;
        border-radius: 9999px;
        background: rgba(212, 175, 55, 0.1);
        border: 1px solid rgba(212, 175, 55, 0.35);
        color: #f3e5ab;
        font-size: 0.72rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
      }
      .hero-title {
        font-size: clamp(2.2rem, 5vw, 4.2rem);
        font-weight: 300;
        line-height: 1.08;
        letter-spacing: -0.02em;
        margin-bottom: 1.25rem;
      }
      .hero-subtitle {
        max-width: 620px;
        margin-inline: auto;
        color: #a3a1a8;
        font-size: clamp(0.95rem, 1.2vw, 1.05rem);
        margin-bottom: 2rem;
      }
      .cta-group {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 1rem;
      }
      /* Cards Grid */
      .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 2.5rem;
      }
      .service-card {
        padding: 2rem;
        border-radius: 1.25rem;
      }
      /* Directora section */
      .director-sec {
        background: rgba(16, 15, 20, 0.7);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding: 4.5rem 0;
      }
      .director-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
        align-items: center;
      }
      @media (min-width: 768px) {
        .director-grid {
          grid-template-columns: 0.9fr 1.3fr;
        }
      }
      .director-photo-wrap {
        position: relative;
        width: 100%;
        max-width: 290px;
        aspect-ratio: 4/5;
        border-radius: 1.25rem;
        overflow: hidden;
        margin-inline: auto;
        border: 1px solid rgba(212, 175, 55, 0.3);
        box-shadow: 0 20px 40px rgba(0,0,0,0.6);
      }
      .director-photo-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
      }
      .director-caption {
        position: absolute;
        bottom: 0;
        inset-x: 0;
        padding: 1.5rem 1rem 1rem;
        background: linear-gradient(to top, rgba(0,0,0,0.88), transparent);
        text-align: center;
      }
      .stats-row {
        display: flex;
        gap: 2.5rem;
        margin-top: 1.75rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }
      footer {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding: 2rem 0;
        text-align: center;
        font-size: 0.75rem;
        color: #6d6b75;
      }
    </style>
  </head>
  <body>

    <!-- Header de Eventos Leymar -->
    <header>
      <div class="container header-inner">
        <div style="display:flex; align-items:center; gap:0.75rem;">
          <img
            src="/preview-assets/logo-leymar.svg"
            alt="Eventos Leymar Logo"
            class="leymar-logo"
            style="height: 38px; max-height: 38px; width: auto; max-width: 140px; object-fit: contain; display: block;"
          />
        </div>

        <ul class="nav-links">
          <li><a href="#bodas">Bodas Destino</a></li>
          <li><a href="#servicios">Servicios</a></li>
          <li><a href="#directora">Leidys Lascarro</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>

        <a
          href="https://wa.me/573147714202?text=Hola%20Eventos%20Leymar,%20deseo%20cotizar%20mi%20boda"
          target="_blank"
          rel="noopener"
          class="btn btn-gold"
          style="padding: 0.55rem 1.25rem; font-size: 0.72rem;"
        >
          Cotizar Boda
        </a>
      </div>
    </header>

    <!-- Hero de Eventos Leymar -->
    <section class="hero-sec">
      <div class="hero-glow"></div>
      <div class="container" style="position: relative; z-index: 2;">
        <div class="badge-gold">
          <span>✨</span> Wedding & Event Planner · Cartagena de Indias
        </div>

        <h1 class="hero-title font-serif-luxury">
          Momentos que trascienden el tiempo en la <span class="gold-gradient">Ciudad Heroica.</span>
        </h1>

        <p class="hero-subtitle">
          Diseñamos, coordinamos y producimos bodas destino de ensueño y recepciones de alta gama con más de 26 años de trayectoria impecable.
        </p>

        <div class="cta-group">
          <a
            href="https://wa.me/573147714202?text=Hola%20Eventos%20Leymar,%20deseo%20cotizar%20mi%20boda"
            target="_blank"
            rel="noopener"
            class="btn btn-gold"
          >
            Iniciar Asesoría Nupcial
          </a>
          <a href="#directora" class="btn btn-outline">
            Conocer a Leidys
          </a>
        </div>
      </div>
    </section>

    <!-- Especialidades -->
    <section id="servicios" style="padding: 4rem 0;">
      <div class="container">
        <div style="text-align: center; margin-bottom: 2.5rem;">
          <p style="font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: #d4af37; margin-bottom: 0.5rem; font-weight: 600;">
            Experiencias a la Medida
          </p>
          <h2 class="font-serif-luxury" style="font-size: clamp(1.8rem, 3.2vw, 2.6rem); color: #ffffff;">
            Nuestras Especialidades
          </h2>
        </div>

        <div class="services-grid">
          <div class="glass-card service-card">
            <div style="font-size: 1.75rem; margin-bottom: 0.75rem;">💍</div>
            <h3 class="font-serif-luxury" style="font-size: 1.4rem; color: #ffffff; margin-bottom: 0.5rem;">Bodas Destino</h3>
            <p style="font-size: 0.82rem; color: #a3a1a8; line-height: 1.6;">
              Coordinación integral para parejas de todo el mundo que eligen casarse en los baluartes, casonas coloniales y playas paradisíacas de Cartagena.
            </p>
          </div>

          <div class="glass-card service-card">
            <div style="font-size: 1.75rem; margin-bottom: 0.75rem;">🍸</div>
            <h3 class="font-serif-luxury" style="font-size: 1.4rem; color: #ffffff; margin-bottom: 0.5rem;">Eventos Corporativos</h3>
            <p style="font-size: 0.82rem; color: #a3a1a8; line-height: 1.6;">
              Cenas de gala, aniversarios empresariales y congresos ejecutivos con logística impecable y montaje de vanguardia.
            </p>
          </div>

          <div class="glass-card service-card">
            <div style="font-size: 1.75rem; margin-bottom: 0.75rem;">👑</div>
            <h3 class="font-serif-luxury" style="font-size: 1.4rem; color: #ffffff; margin-bottom: 0.5rem;">Quinceañeros & Sociales</h3>
            <p style="font-size: 0.82rem; color: #a3a1a8; line-height: 1.6;">
              Celebraciones exclusivas con ambientación temática, diseño floral sensorial y momentos inolvidables.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de la Directora: Leidys Lascarro -->
    <section id="directora" class="director-sec">
      <div class="container">
        <div class="director-grid">
          <div>
            <div class="director-photo-wrap">
              <img
                src="/preview-assets/leidys-lascarro.jpg"
                alt="Leidys Lascarro - Directora y Wedding Planner"
              />
              <div class="director-caption">
                <p class="font-serif-luxury" style="font-size: 1.15rem; color: #ffffff;">Leidys Lascarro</p>
                <p style="font-size: 0.65rem; color: #d4af37; letter-spacing: 0.15em; text-transform: uppercase;">Directora & Fundadora</p>
              </div>
            </div>
          </div>

          <div>
            <p style="font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: #d4af37; margin-bottom: 0.5rem; font-weight: 600;">
              Liderazgo & Trayectoria
            </p>
            <h2 class="font-serif-luxury" style="font-size: clamp(2rem, 3.5vw, 2.8rem); color: #ffffff; margin-bottom: 1rem; line-height: 1.1;">
              26 Años de Pasión por la Excelencia Nupcial
            </h2>
            <p style="font-size: 0.88rem; color: #cfccd6; line-height: 1.7; margin-bottom: 1rem;">
              "Cada evento es una historia única que merece ser contada con sofisticación, puntualidad y alma. En Eventos Leymar nos aseguramos de que los novios disfruten su gran día con absoluta tranquilidad."
            </p>
            <div class="stats-row">
              <div>
                <span class="font-serif-luxury" style="display: block; font-size: 1.8rem; color: #ffffff; font-weight: 600;">500+</span>
                <span style="font-size: 0.72rem; color: #a3a1a8;">Bodas Realizadas</span>
              </div>
              <div>
                <span class="font-serif-luxury" style="display: block; font-size: 1.8rem; color: #ffffff; font-weight: 600;">26+</span>
                <span style="font-size: 0.72rem; color: #a3a1a8;">Años de Trayectoria</span>
              </div>
              <div>
                <span class="font-serif-luxury" style="display: block; font-size: 1.8rem; color: #ffffff; font-weight: 600;">100%</span>
                <span style="font-size: 0.72rem; color: #a3a1a8;">Clientes Satisfechos</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer>
      <div class="container">
        <p>© Eventos Leymar · Cartagena de Indias, Colombia</p>
        <p style="margin-top: 0.35rem; color: rgba(212, 175, 55, 0.7); font-size: 0.7rem;">
          Diseño e ingeniería web de autor por Rembrandt Studio
        </p>
      </div>
    </footer>

  </body>
</html>
