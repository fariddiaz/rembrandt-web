---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { waLink, WHATSAPP_NUMBER } from '../config/site';

const waDefault =
  'Hola Farid, acabo de enviar una solicitud desde la web. Quedo atento a la propuesta.';
---

<Layout
  title="Mensaje Recibido · Rembrandt Studio"
  description="Hemos recibido tu solicitud de propuesta. Nuestro equipo revisará los detalles y te responderá en menos de 2 horas hábiles."
  noindex={true}
>
  <Header />

  <main class="relative z-[2] flex min-h-[80vh] items-center pt-28 pb-24 md:pt-36 md:pb-32">
    <!-- Fondo claroscuro de arte: El Retorno del Hijo Pródigo (1669) -->
    <div
      class="pointer-events-none fixed inset-0 -z-10 overflow-hidden opacity-10"
      aria-hidden="true"
    >
      <img
        src="/art/prodigalson.webp"
        alt=""
        class="size-full object-cover saturate-[0.85] brightness-75"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-carbon via-carbon/90 to-carbon"></div>
    </div>

    <div class="mx-auto w-[min(780px,calc(100%-2.5rem))] text-center">
      <!-- Icono de confirmación en cristal Rembrandt -->
      <span class="mx-auto mb-8 block h-px w-12 bg-gold" aria-hidden="true"></span>

      <p class="text-xs font-medium uppercase tracking-[0.22em] text-gold">Solicitud recibida</p>

      <h1 class="mt-4 font-display text-[clamp(2.4rem,4.5vw,3.6rem)] leading-[1.05] text-light">
        Hemos recibido los detalles de tu proyecto.
      </h1>

      <p class="mx-auto mt-5 max-w-xl text-base md:text-lg leading-relaxed text-mute">
        Analizaremos el alcance de tu negocio y te responderemos con una propuesta personalizada y
        cotización formal en menos de <strong class="text-light">2 horas hábiles</strong>.
      </p>

      <!-- Próximos pasos transparentes -->
      <div class="glass mx-auto mt-10 rounded-2xl border border-white/10 p-6 text-left max-w-lg">
        <p class="text-xs font-semibold uppercase tracking-wider text-light/80 mb-3 font-mono">
          ¿Qué ocurre a continuación?
        </p>
        <ol class="space-y-3 text-xs md:text-sm text-mute">
          <li class="flex items-start gap-2.5">
            <span class="font-mono text-amber-300 font-bold">1.</span>
            <span>Revisamos tus requerimientos, nicho de mercado y referencias estéticas.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="font-mono text-amber-300 font-bold">2.</span>
            <span>Te remitimos una propuesta con cotización cerrada, sin costos ocultos.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="font-mono text-amber-300 font-bold">3.</span>
            <span
              >Si deseas avanzar con urgencia, puedes escribirnos de inmediato por WhatsApp.</span
            >
          </li>
        </ol>
      </div>

      <!-- Acción preferente: confirmar la solicitud por WhatsApp en un clic -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href={waLink(waDefault)}
          target="_blank"
          rel="noopener"
          data-gracias-wa-btn
          class="btn btn-light flex items-center gap-2"
          data-magnetic="0.3"
        >
          <svg class="size-4 fill-current shrink-0" viewBox="0 0 24 24">
            <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"
            ></path>
          </svg>
          <span>Confirmar por WhatsApp</span>
        </a>

        <a href="/" class="btn btn-ghost" data-magnetic="0.3">Volver al inicio</a>
      </div>
    </div>
  </main>

  <script define:vars={{ waNumber: WHATSAPP_NUMBER }}>
    // Personaliza el mensaje con lo que guardó ContactForm en sessionStorage
    // (nunca en la URL). Sin datos queda el mensaje genérico del HTML.
    const waBtn = document.querySelector('[data-gracias-wa-btn]');
    let lead = null;
    try {
      lead = JSON.parse(sessionStorage.getItem('rs_lead') || 'null');
      sessionStorage.removeItem('rs_lead'); // de un solo uso: no reaparece en visitas posteriores
    } catch {
      lead = null;
    }
    if (waBtn && lead && (lead.name || lead.plan)) {
      const proyecto = lead.plan ? ` para el proyecto ${lead.plan}` : '';
      const nombre = lead.name ? ` Mi nombre es ${lead.name}.` : '';
      const msg = `Hola Farid, acabo de enviar una solicitud desde la web${proyecto}.${nombre} Quedo atento a la propuesta.`;
      waBtn.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;
    }
  </script>

  <Footer />
</Layout>
