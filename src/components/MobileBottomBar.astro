---
// Dock inferior móvil (< 768px), en la zona del pulgar.
// Navegación principal + una sola acción de conversión (WhatsApp), como una app
// nativa: se esconde al bajar, vuelve al subir y desaparece al final de la
// página para no tapar el footer legal. Etiquetas tipográficas en vez de
// paquetes de íconos; respuesta táctil visual (y vibración breve en Android).
import { waLink } from '../config/site';

const path = Astro.url.pathname.toLowerCase().replace(/\/$/, '') || '/';

const links = [
  { href: '/planes', label: 'Planes', match: ['/planes', '/express'] },
  { href: '/portafolio', label: 'Obras', match: ['/portafolio'] },
  { href: '/proceso', label: 'Proceso', match: ['/proceso'] },
];

const quote = waLink(
  'Hola Rembrandt Studio, estuve revisando su web desde el móvil y quiero cotizar una web para mi negocio.',
);
---

<nav class="dock md:hidden" aria-label="Navegación rápida" data-dock>
  <div class="dock__bar">
    {
      links.map(({ href, label, match }) => {
        const active = match.some((m) => path.startsWith(m));
        return (
          <a
            href={href}
            class:list={['dock__link', active && 'is-active']}
            aria-current={active ? 'page' : undefined}
            data-press
          >
            {label}
          </a>
        );
      })
    }
    <a
      href={quote}
      target="_blank"
      rel="noopener"
      class="dock__cta"
      data-press
      aria-label="Cotizar por WhatsApp"
    >
      Cotizar
    </a>
  </div>
</nav>

<script>
  const HIDE_AFTER_PX = 120;
  const END_MARGIN_PX = 100;
  const DELTA_PX = 6;
  const HAPTIC_MS = 8;

  const dock = document.querySelector<HTMLElement>('[data-dock]');
  if (dock) {
    let lastY = scrollY;
    let raf = 0;
    // Altura máxima de scroll en caché: no se lee el layout en cada frame.
    let maxScroll = 0;
    const measure = () => (maxScroll = document.documentElement.scrollHeight - innerHeight);
    measure();
    new ResizeObserver(measure).observe(document.body);

    // Oculto = fuera del orden de tabulación y del árbol de accesibilidad (inert).
    const setHidden = (hidden: boolean) => {
      dock.classList.toggle('is-hidden', hidden);
      dock.inert = hidden;
    };

    const update = () => {
      raf = 0;
      const y = scrollY;
      const atEnd = y > maxScroll - END_MARGIN_PX;
      const goingDown = y - lastY > DELTA_PX;
      const goingUp = lastY - y > DELTA_PX;
      if (atEnd || (goingDown && y > HIDE_AFTER_PX)) setHidden(true);
      else if (goingUp || y <= HIDE_AFTER_PX) setHidden(false);
      if (goingDown || goingUp) lastY = y;
    };
    addEventListener('scroll', () => raf || (raf = requestAnimationFrame(update)), {
      passive: true,
    });

    // Respuesta táctil: pulso visual inmediato y vibración corta donde exista.
    dock.querySelectorAll<HTMLElement>('[data-press]').forEach((el) => {
      el.addEventListener(
        'pointerdown',
        () => {
          el.classList.remove('is-pressed');
          void el.offsetWidth; // reinicia la animación del pulso
          el.classList.add('is-pressed');
          navigator.vibrate?.(HAPTIC_MS);
        },
        { passive: true },
      );
    });
  }
</script>

<style>
  .dock {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 40;
    padding: 0 0.75rem calc(0.6rem + env(safe-area-inset-bottom, 0px));
    pointer-events: none;
    transition:
      transform 0.45s var(--ease-cine),
      opacity 0.3s;
  }
  .dock.is-hidden {
    transform: translate3d(0, 120%, 0);
    opacity: 0;
  }

  .dock__bar {
    pointer-events: auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr) 1.25fr;
    align-items: stretch;
    max-width: 28rem;
    margin-inline: auto;
    padding: 0.35rem;
    border: 1px solid rgb(244 239 230 / 0.08);
    border-radius: var(--radius-lg);
    background: rgb(15 13 20 / 0.94);
    box-shadow: 0 18px 40px -18px rgb(7 6 9 / 0.95);
  }

  .dock__link,
  .dock__cta {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 48px;
    border-radius: var(--radius-md);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    -webkit-user-select: none;
    user-select: none;
    touch-action: manipulation;
    transition:
      transform 0.18s var(--ease-cine),
      color 0.2s;
  }
  .dock__link {
    color: rgb(244 239 230 / 0.62);
  }
  /* Activo: filete ámbar arriba, como el rótulo de una obra */
  .dock__link.is-active {
    color: var(--color-light);
  }
  .dock__link.is-active::before {
    content: '';
    position: absolute;
    top: 0.3rem;
    left: 50%;
    width: 1.1rem;
    height: 1px;
    background: var(--color-gold);
    translate: -50% 0;
  }
  .dock__cta {
    margin-left: 0.2rem;
    background: var(--color-light);
    color: var(--color-carbon);
    font-weight: 600;
  }

  .dock__link:active,
  .dock__cta:active {
    transform: scale(0.95);
  }

  /* Pulso háptico visual: anillo ámbar que se expande desde el toque */
  .dock__link::after,
  .dock__cta::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 0 1px rgb(217 119 6 / 0.7);
    opacity: 0;
    pointer-events: none;
  }
  .is-pressed::after {
    animation: press-pulse 0.5s var(--ease-cine);
  }
  @keyframes press-pulse {
    from {
      opacity: 1;
      transform: scale(0.94);
    }
    to {
      opacity: 0;
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock,
    .is-pressed::after {
      transition: none;
      animation: none;
    }
  }
</style>
