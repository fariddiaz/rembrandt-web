---
// Barra de Navegación Rápida Flotante para Móvil (Thumb-Zone Architecture)
// Inspirada en las mejores prácticas de Awwwards y diseño móvil de autor:
// Coloca las dos decisiones más importantes de negocio al alcance inmediato del pulgar.
import { waLink } from '../config/site';

const currentPath = Astro.url.pathname.toLowerCase().replace(/\/$/, '') || '/';
const isPlanesPage = currentPath.startsWith('/planes');
---

<aside
  class="fixed inset-x-0 bottom-3 z-40 px-3 md:hidden pointer-events-none transition-transform duration-300"
  aria-label="Acciones rápidas para móvil"
  id="mobile-bottom-dock"
>
  <div
    class="glass pointer-events-auto mx-auto flex max-w-sm items-center justify-between gap-2.5 rounded-full p-2 border border-violet/25 shadow-[0_16px_36px_-10px_rgba(0,0,0,0.85),0_0_24px_-8px_rgba(139,92,246,0.35)]"
    style="padding-bottom: calc(0.5rem + env(safe-area-inset-bottom, 0px));"
  >
    <!-- Botón 1: Explorar Planes o Ver Casos de Estudio -->
    <a
      href={isPlanesPage ? '/portafolio' : '/planes'}
      class="flex-1 rounded-full px-3.5 py-2.5 text-center text-xs font-medium text-light/90 transition-all hover:bg-white/10 active:scale-[0.96]"
    >
      <span class="flex items-center justify-center gap-1.5">
        <svg class="size-3.5 text-violet-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          {isPlanesPage ? (
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" />
          ) : (
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          )}
        </svg>
        <span>{isPlanesPage ? 'Ver Portafolio' : 'Ver Planes'}</span>
      </span>
    </a>

    <!-- Botón 2: Cotizar por WhatsApp con Levitación Flotante -->
    <a
      href={waLink('Hola Rembrandt Studio, estuve revisando su web desde el móvil y quiero cotizar una web para mi negocio.')}
      target="_blank"
      rel="noopener"
      class="btn-float flex-1 rounded-full bg-light px-4 py-2.5 text-center text-xs font-semibold text-carbon shadow-[0_10px_28px_-10px_rgba(139,92,246,0.55)] transition-transform active:scale-[0.96]"
      aria-label="Escribir por WhatsApp para cotización inmediata"
    >
      <span class="flex items-center justify-center gap-1.5">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
        </span>
        <span>Cotizar Ahora</span>
      </span>
    </a>
  </div>
</aside>

<script>
  // Ocultar suavemente la barra móvil cuando el usuario está en el formulario de contacto o al pie
  const dock = document.getElementById('mobile-bottom-dock');
  if (dock) {
    let ticking = false;

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
          // Ocultar si está a menos de 80px del final del documento para no tapar los enlaces legales
          if (scrollY > maxScroll - 100) {
            dock.style.transform = 'translateY(140%)';
            dock.style.opacity = '0';
          } else {
            dock.style.transform = 'translateY(0%)';
            dock.style.opacity = '1';
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }
</script>
