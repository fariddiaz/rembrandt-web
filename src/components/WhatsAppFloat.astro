---
import { waLink, waSections } from '../config/site';
const initial = waSections.hero;
---
<a
  href={waLink(initial.message)}
  target="_blank"
  rel="noopener"
  class="wa-float glass"
  data-wa-float
  data-magnetic="0.25"
  data-cursor="WHATSAPP"
  aria-label={`${initial.label}: abrir WhatsApp`}
>
  <span class="wa-icon" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="22" height="22" fill="currentColor">
      <path d="M16.04 3C8.85 3 3 8.83 3 16c0 2.29.6 4.53 1.75 6.5L3 29l6.68-1.74A13.03 13.03 0 0 0 16.04 29C23.22 29 29 23.17 29 16S23.22 3 16.04 3Zm0 23.8c-2.02 0-4-.54-5.72-1.57l-.41-.24-3.96 1.03 1.06-3.86-.27-.4A10.73 10.73 0 0 1 5.3 16c0-5.93 4.82-10.75 10.74-10.75 5.93 0 10.66 4.82 10.66 10.75 0 5.93-4.73 10.8-10.66 10.8Zm5.9-8.05c-.32-.16-1.91-.94-2.2-1.05-.3-.11-.51-.16-.73.16-.21.32-.83 1.05-1.02 1.27-.19.21-.38.24-.7.08-.32-.16-1.36-.5-2.59-1.6-.96-.85-1.6-1.9-1.79-2.22-.19-.32-.02-.5.14-.65.14-.15.32-.38.48-.56.16-.19.21-.32.32-.54.1-.21.05-.4-.03-.56-.08-.16-.72-1.74-.99-2.38-.26-.62-.53-.54-.73-.55h-.62c-.21 0-.56.08-.86.4-.3.32-1.13 1.1-1.13 2.69 0 1.58 1.16 3.12 1.32 3.33.16.21 2.28 3.48 5.53 4.88.77.33 1.37.53 1.84.68.78.25 1.48.21 2.04.13.62-.09 1.91-.78 2.18-1.53.27-.75.27-1.4.19-1.53-.08-.13-.29-.21-.61-.37Z"/>
    </svg>
  </span>
  <span class="wa-text" data-wa-text>{initial.label}</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: clamp(1rem, 2.5vw, 2rem);
    bottom: clamp(1rem, 2.5vw, 2rem);
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 1.15rem 0.55rem 0.55rem;
    border-radius: 999px;
    color: var(--color-light);
    font-weight: 600;
    font-size: 0.92rem;
    opacity: 0;
    translate: 0 1.5rem;
    pointer-events: none;
    transition: opacity 0.5s var(--ease-cine), translate 0.6s var(--ease-cine);
  }
  .wa-float:global(.is-visible) {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
  }
  .wa-icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    background: var(--color-violet-deep);
    box-shadow: 0 0 24px rgb(139 92 246 / 0.7);
  }
  .wa-text {
    display: inline-block;
    transition: opacity 0.18s, filter 0.18s, transform 0.3s var(--ease-cine);
  }
  .wa-text:global(.is-swapping) {
    opacity: 0;
    filter: blur(4px);
    transform: translateY(4px);
  }
  @media (max-width: 480px) {
    .wa-float { padding-right: 0.95rem; font-size: 0.85rem; }
  }
</style>
