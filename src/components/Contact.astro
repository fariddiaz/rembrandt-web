---
import { waLink, waSections } from '../config/site';
const wa = waSections.contacto;
---
<section
  id="contacto"
  class="relative overflow-hidden py-[18vh] text-center"
  data-wa-label={wa.label}
  data-wa-message={wa.message}
>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(45%_55%_at_50%_60%,rgb(124_58_237/0.35),transparent_70%)]"></div>
  <div class="mx-auto w-[min(980px,calc(100%-2.5rem))]">
    <h2 class="text-[clamp(2.6rem,7vw,6.2rem)] leading-[0.95]">Escríbenos hoy. En 48 horas ves tu web.</h2>
    <p class="mx-auto mt-8 max-w-[34rem] text-lg text-mute">
      Respondemos personalmente por WhatsApp al +57 314 771 4202.
    </p>
    <a
      href={waLink(wa.message)}
      target="_blank"
      rel="noopener"
      class="btn btn-light mt-12 !px-9 !py-5 text-lg"
      data-magnetic="0.45"
      data-cursor="WHATSAPP"
    >
      Abrir WhatsApp
    </a>
  </div>
</section>
