<div class="rs-cursor" aria-hidden="true">
  <div class="rs-cursor__ring"><span class="rs-cursor__label"></span></div>
  <div class="rs-cursor__dot"></div>
</div>

<style is:global>
  .rs-cursor {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    html.has-cursor,
    html.has-cursor a,
    html.has-cursor button {
      cursor: none !important;
    }

    .rs-cursor {
      display: block;
    }

    .rs-cursor > div {
      position: fixed;
      left: 0;
      top: 0;
      z-index: 9999;
      pointer-events: none;
      border-radius: 9999px;
      translate: -50% -50%;
    }

    .rs-cursor__dot {
      width: 6px;
      height: 6px;
      background: #fcfbfe;
      mix-blend-mode: difference;
    }

    .rs-cursor__ring {
      width: 38px;
      height: 38px;
      border: 1.5px solid rgba(139, 92, 246, 0.6);
      display: grid;
      place-items: center;
      transition:
        width 0.3s cubic-bezier(0.22, 1, 0.36, 1),
        height 0.3s cubic-bezier(0.22, 1, 0.36, 1),
        background-color 0.3s,
        border-color 0.3s;
    }

    .rs-cursor__ring.is-hover {
      width: 60px;
      height: 60px;
      border-color: #8b5cf6;
      background: rgba(139, 92, 246, 0.15);
    }

    .rs-cursor__ring.has-label {
      width: 84px;
      height: 84px;
      background: #8b5cf6;
      border-color: transparent;
      box-shadow: 0 0 25px rgba(139, 92, 246, 0.5);
    }

    .rs-cursor__label {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #fcfbfe;
      opacity: 0;
      transition: opacity 0.2s;
    }

    .has-label .rs-cursor__label {
      opacity: 1;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (fine) {
    document.documentElement.classList.add('has-cursor');
    const dot = document.querySelector<HTMLElement>('.rs-cursor__dot');
    const ring = document.querySelector<HTMLElement>('.rs-cursor__ring');
    const label = document.querySelector<HTMLElement>('.rs-cursor__label');

    if (dot && ring && label) {
      const dx = gsap.quickTo(dot, 'x', { duration: 0.08 });
      const dy = gsap.quickTo(dot, 'y', { duration: 0.08 });
      const rx = gsap.quickTo(ring, 'x', { duration: 0.38, ease: 'power3' });
      const ry = gsap.quickTo(ring, 'y', { duration: 0.38, ease: 'power3' });

      let mag: HTMLElement | null = null;
      const release = (el: HTMLElement) =>
        gsap.to(el, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.4)' });

      document.addEventListener('pointermove', (e) => {
        dx(e.clientX);
        dy(e.clientY);
        rx(e.clientX);
        ry(e.clientY);

        if (reduce) return;

        const el = (e.target as Element).closest<HTMLElement>('[data-magnetic]');
        if (el !== mag) {
          if (mag) release(mag);
          mag = el;
        }
        if (!el) return;
        const r = el.getBoundingClientRect();
        const s = Number(el.dataset.magnetic) || 0.25;
        gsap.to(el, {
          x: (e.clientX - (r.left + r.width / 2)) * s,
          y: (e.clientY - (r.top + r.height / 2)) * s,
          duration: 0.3,
          ease: 'power3.out',
        });
      }, { passive: true });

      document.addEventListener('pointerover', (e) => {
        const t = (e.target as Element).closest<HTMLElement>('a, button, [data-cursor]');
        const text = t?.dataset.cursor ?? '';
        ring.classList.toggle('is-hover', !!t);
        ring.classList.toggle('has-label', !!text);
        label.textContent = text;
      });
    }
  }
</script>
