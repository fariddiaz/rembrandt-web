---
interface Props {
  splineUrl?: string;
  modelUrl?: string;
}

const {
  splineUrl = 'https://prod.spline.design/kZDDjO5HuC9GJUM2/scene.splinecode',
  modelUrl,
} = Astro.props;
---

<section
  id="hero-3d"
  class="relative min-h-[92vh] w-full overflow-hidden bg-[#0d0d0d] text-white flex items-center justify-center select-none"
  data-spline-url={splineUrl}
  data-model-url={modelUrl}
>
  {/* Capa 1: Fondo Rembrandt Dark - Iluminación radial violeta/púrpura eléctrico */}
  <div
    id="hero-radial-bg"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,rgba(139,92,246,0.26)_0%,rgba(10,10,13,0.95)_68%,#0a0a0d_100%)] z-0 transition-all duration-300"
  ></div>

  {/* Capa 2: Tipografía de gran escala REMBRANDT detrás del personaje */}
  <div
    class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center z-10 opacity-90"
  >
    <span
      class="text-[11px] sm:text-xs font-semibold uppercase tracking-[0.4em] text-accent mb-2 sm:mb-3"
    >
      Estudio de Diseño &bull; 3D Craft &bull; Rendimiento
    </span>
    <h1
      class="font-display text-[16vw] sm:text-[14vw] font-bold tracking-tighter text-paper leading-none text-center drop-shadow-2xl select-none"
    >
      REMBRANDT
    </h1>
    <p class="mt-2 text-xs sm:text-sm tracking-[0.3em] text-white/50 uppercase font-medium">
      Oscuridad para que la luz importe
    </p>
  </div>

  {/* Capa 3: Canvas 3D de Three.js */}
  <div class="relative z-20 w-full h-[88vh] flex items-center justify-center pointer-events-auto">
    <canvas id="three-hero-canvas" class="w-full h-full block cursor-grab active:cursor-grabbing"></canvas>

    {/* Spinner / Indicador de carga elegante */}
    <div
      id="hero-loading"
      class="pointer-events-none absolute inset-0 flex items-center justify-center transition-opacity duration-700 bg-[#0d0d0d]/85 backdrop-blur-sm z-30"
    >
      <div class="flex flex-col items-center gap-3">
        <div class="h-8 w-8 animate-spin rounded-full border-2 border-accent border-t-transparent"></div>
        <span class="text-xs tracking-widest uppercase text-white/60 font-mono">
          Cargando Escultura 3D...
        </span>
      </div>
    </div>
  </div>

  {/* Capa 4: Overlays flotantes y llamadas a la acción */}
  <div
    class="pointer-events-none absolute inset-0 z-30 flex flex-col justify-between p-6 sm:p-12"
  >
    <div class="flex justify-between items-start">
      <div class="flex items-center gap-2">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-xs uppercase tracking-widest text-white/70">Disponibles para proyectos</span>
      </div>
      <span class="text-xs tracking-widest text-accent font-mono hidden md:block">
        [ NEON VIOLET &bull; #8b5cf6 ]
      </span>
    </div>

    <div class="flex flex-col sm:flex-row justify-between items-end gap-6">
      <p class="max-w-sm text-sm text-white/70 leading-relaxed font-light">
        Rembrandt pintaba con penumbra para que la luz tuviera sentido. Diseñamos experiencias digitales donde cada línea de código y cada interacción se ganan su foco.
      </p>

      <div class="pointer-events-auto flex items-center gap-3">
        <a
          href="#contacto"
          class="btn-firma group relative inline-flex flex-col items-center justify-center rounded-full bg-paper px-7 py-3 text-xs font-semibold uppercase tracking-wider text-ink transition-all hover:bg-accent hover:text-white hover:scale-105 shadow-[0_0_25px_rgba(139,92,246,0.35)] overflow-hidden"
        >
          <span>Iniciar Proyecto</span>
          <svg class="firma-stroke absolute bottom-1 h-2.5 w-24 pointer-events-none" viewBox="0 0 320 60" aria-hidden="true">
            <path pathLength="1" d="M10 42 C 38 12, 65 52, 98 28 S 145 18, 180 38 C 215 52, 235 18, 265 25 C 290 30, 302 44, 314 28" />
          </svg>
        </a>
        <a
          href="#obras"
          class="rounded-full border border-white/20 bg-white/5 px-6 py-3 text-xs font-semibold uppercase tracking-wider text-white backdrop-blur-sm transition-all hover:border-white hover:bg-white/10"
        >
          Ver Obras &darr;
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const initHero3D = async () => {
    const container = document.getElementById('hero-3d');
    const canvas = document.getElementById('three-hero-canvas') as HTMLCanvasElement | null;
    const loaderEl = document.getElementById('hero-loading');
    const radialBg = document.getElementById('hero-radial-bg');

    if (!container || !canvas) return;

    // 1. Claroscuro Dinámico: la luz violeta se desplaza sutilmente con el cursor
    if (radialBg && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let targetX = 50, targetY = 45;
      let currX = 50, currY = 45;
      let isRafActive = false;

      const renderLight = () => {
        currX += (targetX - currX) * 0.08;
        currY += (targetY - currY) * 0.08;
        radialBg.style.background = `radial-gradient(circle 520px at ${currX.toFixed(2)}% ${currY.toFixed(2)}%, rgba(139,92,246,0.30) 0%, rgba(28,21,48,0.45) 45%, rgba(10,10,13,0.96) 75%, #0a0a0d 100%)`;

        if (Math.abs(targetX - currX) + Math.abs(targetY - currY) > 0.05) {
          requestAnimationFrame(renderLight);
        } else {
          isRafActive = false;
        }
      };

      const onHeroPointer = (e: MouseEvent | TouchEvent) => {
        const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
        const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
        const rect = container.getBoundingClientRect();
        targetX = Math.max(15, Math.min(85, ((clientX - rect.left) / rect.width) * 100));
        targetY = Math.max(15, Math.min(85, ((clientY - rect.top) / rect.height) * 100));

        if (!isRafActive) {
          isRafActive = true;
          requestAnimationFrame(renderLight);
        }
      };

      window.addEventListener('mousemove', onHeroPointer, { passive: true });
      window.addEventListener('touchmove', onHeroPointer, { passive: true });
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (loaderEl) loaderEl.remove();
      return;
    }

    const splineUrl = container.dataset.splineUrl;

    // Modo 1: Carga nativa de Spline si se proporciona splineUrl
    if (splineUrl) {
      try {
        const { Application } = await import('@splinetool/runtime');
        const app = new Application(canvas);
        await app.load(splineUrl);
        if (loaderEl) {
          loaderEl.classList.add('opacity-0');
          setTimeout(() => loaderEl.remove(), 700);
        }
        return;
      } catch (err) {
        console.warn('Error cargando Spline:', err);
      }
    }

    // Modo 2: Three.js nativo con modelo GLB articulado
    const THREE = await import('three');
    const { GLTFLoader } = await import('three/addons/loaders/GLTFLoader.js');

    const modelUrl = container.dataset.modelUrl || '/models/xbot.glb';

    // 1. Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      42,
      canvas.clientWidth / canvas.clientHeight,
      0.1,
      100
    );
    camera.position.set(0, 0.1, 2.3);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(canvas.clientWidth, canvas.clientHeight);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.35;

    // 2. Iluminación Claroscuro Rembrandt para alta visibilidad
    // Foco principal ámbar (#b45309)
    const keyLight = new THREE.DirectionalLight(0xb45309, 3.8);
    keyLight.position.set(3, 3, 3.5);
    scene.add(keyLight);

    // Luz frontal para resaltar facciones y rostro
    const frontLight = new THREE.DirectionalLight(0xfff8ee, 1.2);
    frontLight.position.set(0, 1.5, 3);
    scene.add(frontLight);

    // Contraluz / Rim light dorado (#d97706)
    const rimLight = new THREE.DirectionalLight(0xd97706, 2.8);
    rimLight.position.set(-2.5, 3.5, -2.5);
    scene.add(rimLight);

    // Luz puntual interactiva del cursor (destellos en tiempo real)
    const cursorLight = new THREE.PointLight(0xf59e0b, 3.5, 7);
    cursorLight.position.set(0, 0, 2.2);
    scene.add(cursorLight);

    // Luz ambiental
    const ambientLight = new THREE.AmbientLight(0x2a2420, 1.2);
    scene.add(ambientLight);

    // 3. Cargar y adaptar el modelo con el material Basalto / Mármol Negro de Rembrandt
    let sculptureGroup: any = null;
    let headBone: any = null;
    let neckBone: any = null;

    const loader = new GLTFLoader();

    loader.load(
      modelUrl,
      (gltf) => {
        const model = gltf.scene;

        // Material personalizado: Mármol Negro / Basalto pulido con reflejos especulares vivos
        const rembrandtMaterial = new THREE.MeshStandardMaterial({
          color: 0x17130f, // --color-ink
          roughness: 0.22,
          metalness: 0.25,
        });

        // Buscar huesos del cuello y cabeza
        model.traverse((child) => {
          if (child.name === 'mixamorig:Head' || child.name === 'Head') {
            headBone = child;
          }
          if (child.name === 'mixamorig:Neck' || child.name === 'Neck') {
            neckBone = child;
          }

          if ((child as any).isMesh) {
            const mesh = child as THREE.Mesh;
            mesh.material = rembrandtMaterial;
            mesh.castShadow = true;
            mesh.receiveShadow = true;
          }
        });

        model.updateMatrixWorld(true);

        if (headBone) {
          // Si es un modelo articulado (como Xbot o androide rigged):
          // Centrar la cámara directamente en el busto y cabeza para que sea grande e impactante
          const headPos = new THREE.Vector3();
          headBone.getWorldPosition(headPos);
          model.position.set(0, -headPos.y + 0.15, 0);
          model.scale.setScalar(1.25);
        } else {
          // Si es una escultura estática tradicional: centrado automático
          const box = new THREE.Box3().setFromObject(model);
          const center = box.getCenter(new THREE.Vector3());
          const size = box.getSize(new THREE.Vector3());
          const maxDim = Math.max(size.x, size.y, size.z);
          const targetScale = 2.2 / maxDim;
          model.scale.setScalar(targetScale);
          model.position.x = -center.x * targetScale;
          model.position.y = -center.y * targetScale - 0.15;
          model.position.z = -center.z * targetScale;
        }

        sculptureGroup = new THREE.Group();
        sculptureGroup.add(model);
        scene.add(sculptureGroup);

        // Desvanecer loader
        if (loaderEl) {
          loaderEl.classList.add('opacity-0');
          setTimeout(() => loaderEl.remove(), 700);
        }
      },
      undefined,
      (err) => {
        console.warn('Error al cargar busto 3D:', err);
        if (loaderEl) loaderEl.remove();
      }
    );

    // 4. Interacción con el cursor (Look At & Damping)
    let mouseX = 0;
    let mouseY = 0;
    let targetRotY = 0;
    let targetRotX = 0;

    const onPointerMove = (e: MouseEvent | TouchEvent) => {
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;

      const rect = container.getBoundingClientRect();
      const xNorm = ((clientX - rect.left) / rect.width) * 2 - 1;
      const yNorm = ((clientY - rect.top) / rect.height) * 2 - 1;

      mouseX = xNorm;
      mouseY = yNorm;

      targetRotY = mouseX * 0.45; // Rango de rotación horizontal
      targetRotX = mouseY * 0.25; // Rango de rotación vertical

      // Mover la luz puntual del cursor
      cursorLight.position.x = mouseX * 2.2;
      cursorLight.position.y = -mouseY * 1.8;

      // Mover sutilmente el fondo radial cálido
      if (radialBg) {
        const bgX = 50 + mouseX * 15;
        const bgY = 45 + mouseY * 15;
        radialBg.style.background = `radial-gradient(circle at ${bgX}% ${bgY}%, rgba(139,92,246,0.30) 0%, rgba(10,10,13,0.95) 68%, #0a0a0d 100%)`;
      }
    };

    window.addEventListener('mousemove', onPointerMove, { passive: true });
    window.addEventListener('touchmove', onPointerMove, { passive: true });

    // 5. Responsive Resize
    const onResize = () => {
      if (!canvas) return;
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    };

    window.addEventListener('resize', onResize);

    // 6. Animation Loop con Lerp suave
    const animate = () => {
      requestAnimationFrame(animate);

      if (headBone) {
        // Rotación exclusiva de la cabeza (Look At real)
        headBone.rotation.y += (targetRotY * 1.15 - headBone.rotation.y) * 0.075;
        headBone.rotation.x += (-targetRotX * 0.7 - headBone.rotation.x) * 0.075;

        // El cuello acompaña de forma sutil
        if (neckBone) {
          neckBone.rotation.y += (targetRotY * 0.25 - neckBone.rotation.y) * 0.075;
          neckBone.rotation.x += (-targetRotX * 0.18 - neckBone.rotation.x) * 0.075;
        }

        // El cuerpo permanece prácticamente estático (apenas 3% de balanceo natural)
        if (sculptureGroup) {
          sculptureGroup.rotation.y += (targetRotY * 0.03 - sculptureGroup.rotation.y) * 0.05;
        }
      } else if (sculptureGroup) {
        // Fallback para modelos sin esqueleto
        sculptureGroup.rotation.y += (targetRotY - sculptureGroup.rotation.y) * 0.055;
        sculptureGroup.rotation.x += (targetRotX - sculptureGroup.rotation.x) * 0.055;
      }

      renderer.render(scene, camera);
    };

    animate();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero3D);
  } else {
    initHero3D();
  }
</script>
