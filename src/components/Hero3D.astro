---
interface Props {
  splineUrl?: string;
  modelUrl?: string;
}

const {
  splineUrl = 'https://prod.spline.design/kZDDjO5HuC9GJUM2/scene.splinecode',
  modelUrl,
} = Astro.props;

const waUrl = 'https://wa.me/573147714202?text=Hola%20Rembrandt%20Studio%2C%20quiero%20cotizar%20un%20proyecto%20web';
---

<section
  id="hero-3d"
  class="relative min-h-[100vh] w-full overflow-hidden bg-[#0a0a0d] text-white flex items-center justify-center pt-28 pb-16 px-4 sm:px-8 select-none isolate"
  data-spline-url={splineUrl}
  data-model-url={modelUrl}
>
  {/* Capa 1: Fondo Chiaroscuro Rembrandt - Iluminación radial violeta dinámica */}
  <div
    id="hero-radial-bg"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_60%_35%,rgba(139,92,246,0.28)_0%,rgba(28,21,48,0.4)_40%,rgba(10,10,13,0.96)_75%,#0a0a0d_100%)] z-0 transition-all duration-300"
  ></div>

  {/* Capa 2: Canvas 3D interactivo en el centro/fondo */}
  <div class="absolute inset-0 z-10 flex items-center justify-center pointer-events-auto">
    <canvas id="three-hero-canvas" class="w-full h-full block cursor-grab active:cursor-grabbing opacity-90"></canvas>

    {/* Spinner de carga elegante */}
    <div
      id="hero-loading"
      class="pointer-events-none absolute inset-0 flex items-center justify-center transition-opacity duration-700 bg-[#0a0a0d]/85 backdrop-blur-sm z-30"
    >
      <div class="flex flex-col items-center gap-3">
        <div class="h-8 w-8 animate-spin rounded-full border-2 border-accent border-t-transparent"></div>
        <span class="text-xs tracking-widest uppercase text-white/60 font-mono">
          Cargando Escultura 3D...
        </span>
      </div>
    </div>
  </div>

  {/* Capa 3: Grid asimétrico inspirado en la referencia AgentAI */}
  <div class="relative z-20 mx-auto max-w-7xl w-full grid grid-cols-1 lg:grid-cols-12 gap-8 items-center pointer-events-none">
    {/* Columna Izquierda: Titular, CTAs y Micro-Métricas */}
    <div class="lg:col-span-7 flex flex-col items-start text-left pointer-events-auto">
      {/* Pill Badge */}
      <div class="inline-flex items-center gap-2 rounded-full border border-accent/40 bg-accent/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-widest text-accent mb-6 shadow-[0_0_15px_rgba(139,92,246,0.25)] backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-accent animate-pulse shadow-[0_0_8px_#8b5cf6]"></span>
        <span>Digital Craft &bull; Entrega en 24 a 48h</span>
      </div>

      {/* Titular Principal con Gradiente */}
      <h1 class="font-display text-4xl sm:text-6xl xl:text-7xl font-bold tracking-tight text-white leading-[1.08] text-balance">
        Tu Web de <br />
        <span class="bg-gradient-to-r from-violet-400 via-fuchsia-400 to-purple-600 bg-clip-text text-transparent drop-shadow-sm">
          Alto Impacto
        </span> <br />
        <span class="text-white">Lista en 24 a 48h.</span>
      </h1>

      {/* Subtítulo */}
      <p class="mt-6 text-sm sm:text-base text-white/70 max-w-xl leading-relaxed font-light">
        De la idea a producción en tiempo récord. Diseñamos experiencias web de alto calibre, 3D interactivo y velocidad extrema 100/100 que convierten visitas en clientes.
      </p>

      {/* Botones de Acción */}
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="#escalera"
          class="btn-firma group relative inline-flex flex-col items-center justify-center rounded-full bg-accent px-8 py-3.5 text-xs font-bold uppercase tracking-wider text-white shadow-[0_0_25px_rgba(139,92,246,0.4)] transition-all hover:bg-accent-strong hover:scale-105 overflow-hidden"
        >
          <span>Ver Planes y Precios &darr;</span>
          <svg class="firma-stroke absolute bottom-1 h-2 w-24 pointer-events-none" viewBox="0 0 320 60" aria-hidden="true">
            <path pathLength="1" d="M10 42 C 38 12, 65 52, 98 28 S 145 18, 180 38 C 215 52, 235 18, 265 25 C 290 30, 302 44, 314 28" />
          </svg>
        </a>

        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-6 py-3.5 text-xs font-semibold uppercase tracking-wider text-white backdrop-blur-xl transition-all hover:border-emerald-500/50 hover:bg-emerald-500/10"
        >
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>WhatsApp Directo &rarr;</span>
        </a>
      </div>

      {/* Micro-tarjetas de métricas (Igual a la fila de la referencia) */}
      <div class="mt-12 grid grid-cols-3 gap-3 w-full max-w-lg">
        <div class="rounded-xl border border-white/10 bg-[#121217]/80 p-3 sm:p-4 backdrop-blur-md">
          <span class="text-[10px] uppercase font-mono text-white/50 block">Velocidad</span>
          <span class="font-display text-xl sm:text-2xl font-bold text-accent block mt-1">100/100</span>
          <span class="text-[11px] text-white/60">Core Web Vitals</span>
        </div>

        <div class="rounded-xl border border-white/10 bg-[#121217]/80 p-3 sm:p-4 backdrop-blur-md">
          <span class="text-[10px] uppercase font-mono text-white/50 block">Entrega</span>
          <span class="font-display text-xl sm:text-2xl font-bold text-accent block mt-1">24–48h</span>
          <span class="text-[11px] text-white/60">Garantizada</span>
        </div>

        <div class="rounded-xl border border-white/10 bg-[#121217]/80 p-3 sm:p-4 backdrop-blur-md">
          <span class="text-[10px] uppercase font-mono text-white/50 block">Impacto</span>
          <span class="font-display text-xl sm:text-2xl font-bold text-accent block mt-1">+38%</span>
          <span class="text-[11px] text-white/60">Conversión</span>
        </div>
      </div>
    </div>

    {/* Espaciador central transparente para lucir el robot 3D */}
    <div class="hidden lg:block lg:col-span-1"></div>

    {/* Columna Derecha: Bento Stack Flotante (Como en la referencia) */}
    <div class="lg:col-span-4 flex flex-col gap-4 items-end pointer-events-auto mt-8 lg:mt-0">
      {/* Tarjeta Flotante 1: Obras de Autor */}
      <div class="w-full max-w-xs rounded-2xl border border-white/10 bg-[#121217]/85 p-5 backdrop-blur-xl shadow-2xl transition-all hover:border-accent/50 group">
        <div class="flex items-center justify-between mb-3">
          <span class="text-[10px] font-mono uppercase text-accent font-semibold tracking-wider">
            Rembrandt Studio
          </span>
          <span class="text-[10px] font-mono text-white/40">01/04</span>
        </div>
        <div class="h-28 rounded-xl bg-gradient-to-br from-violet-900/40 via-purple-950/20 to-black border border-white/10 flex items-center justify-center relative overflow-hidden mb-4">
          <span class="h-16 w-16 rounded-full bg-accent/20 blur-xl absolute"></span>
          <span class="font-display text-2xl font-bold tracking-tight text-white/90 group-hover:scale-105 transition-transform">
            3D Craft
          </span>
        </div>
        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-display text-2xl font-bold text-white block">25+ Obras</span>
            <span class="text-xs text-white/50">Lanzadas con éxito</span>
          </div>
          <span class="text-xs text-accent font-semibold group-hover:translate-x-1 transition-transform">
            Ver &rarr;
          </span>
        </div>
      </div>

      {/* Tarjeta Flotante 2: Calificación & Botón de Reserva */}
      <div class="w-full max-w-xs rounded-2xl border border-white/10 bg-[#121217]/85 p-5 backdrop-blur-xl shadow-2xl transition-all hover:border-white/20">
        <div class="flex items-center gap-1 text-amber-400 text-sm mb-2">
          ★★★★★
          <span class="ml-2 text-xs font-mono text-white/70 font-bold">5.0</span>
        </div>
        <h4 class="text-lg font-bold text-white">40+ Clientes</h4>
        <p class="text-xs text-white/60 mt-1">Empresas y marcas en Colombia, EE.UU. y Latinoamérica.</p>

        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 block w-full rounded-xl bg-gradient-to-r from-accent to-accent-strong py-2.5 text-center text-xs font-bold uppercase tracking-wider text-white shadow-lg shadow-accent/25 hover:opacity-95 transition-all"
        >
          Reservar Cupo Express &rarr;
        </a>
      </div>

      {/* Píldora social flotante */}
      <div class="flex items-center gap-2 rounded-full border border-white/10 bg-[#121217]/80 px-4 py-2 backdrop-blur-md text-xs text-white/60">
        <span class="text-[10px] uppercase font-mono tracking-wider text-white/40 mr-1">Canales:</span>
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">WhatsApp</a>
        <span class="text-white/20">&bull;</span>
        <a href="mailto:hola@rembrandt.studio" class="hover:text-accent transition-colors">Email</a>
        <span class="text-white/20">&bull;</span>
        <a href="https://github.com/fariddiaz" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">GitHub</a>
      </div>
    </div>
  </div>
</section>

<script>
  const initHero3D = async () => {
    const container = document.getElementById('hero-3d');
    const canvas = document.getElementById('three-hero-canvas') as HTMLCanvasElement | null;
    const loaderEl = document.getElementById('hero-loading');
    const radialBg = document.getElementById('hero-radial-bg');

    if (!container || !canvas) return;

    // 1. Claroscuro Dinámico: la luz violeta se desplaza sutilmente con el cursor
    if (radialBg && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let targetX = 60, targetY = 35;
      let currX = 60, currY = 35;
      let isRafActive = false;

      const renderLight = () => {
        currX += (targetX - currX) * 0.08;
        currY += (targetY - currY) * 0.08;
        radialBg.style.background = `radial-gradient(circle 580px at ${currX.toFixed(2)}% ${currY.toFixed(2)}%, rgba(139,92,246,0.30) 0%, rgba(28,21,48,0.45) 45%, rgba(10,10,13,0.96) 75%, #0a0a0d 100%)`;

        if (Math.abs(targetX - currX) + Math.abs(targetY - currY) > 0.05) {
          requestAnimationFrame(renderLight);
        } else {
          isRafActive = false;
        }
      };

      const onHeroPointer = (e: MouseEvent | TouchEvent) => {
        const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
        const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
        const rect = container.getBoundingClientRect();
        targetX = Math.max(15, Math.min(85, ((clientX - rect.left) / rect.width) * 100));
        targetY = Math.max(15, Math.min(85, ((clientY - rect.top) / rect.height) * 100));

        if (!isRafActive) {
          isRafActive = true;
          requestAnimationFrame(renderLight);
        }
      };

      window.addEventListener('mousemove', onHeroPointer, { passive: true });
      window.addEventListener('touchmove', onHeroPointer, { passive: true });
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (loaderEl) loaderEl.remove();
      return;
    }

    const splineUrl = container.dataset.splineUrl;

    // Modo 1: Carga nativa de Spline si se proporciona splineUrl
    if (splineUrl) {
      try {
        const { Application } = await import('@splinetool/runtime');
        const app = new Application(canvas);
        await app.load(splineUrl);
        if (loaderEl) {
          loaderEl.classList.add('opacity-0');
          setTimeout(() => loaderEl.remove(), 700);
        }
        return;
      } catch (err) {
        console.warn('Error cargando Spline:', err);
      }
    }

    // Modo 2: Three.js nativo como fallback
    const THREE = await import('three');
    const { GLTFLoader } = await import('three/addons/loaders/GLTFLoader.js');

    const modelUrl = container.dataset.modelUrl || '/models/xbot.glb';

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, canvas.clientWidth / canvas.clientHeight, 0.1, 100);
    camera.position.set(0, 0.1, 2.3);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(canvas.clientWidth, canvas.clientHeight);

    const keyLight = new THREE.DirectionalLight(0x8b5cf6, 3.8);
    keyLight.position.set(3.5, 4, 3);
    scene.add(keyLight);

    const ambientLight = new THREE.AmbientLight(0x1c1530, 1.2);
    scene.add(ambientLight);

    if (loaderEl) {
      loaderEl.classList.add('opacity-0');
      setTimeout(() => loaderEl.remove(), 700);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero3D);
  } else {
    initHero3D();
  }
</script>
