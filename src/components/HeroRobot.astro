---
// Robot 3D interactivo (Spline).
// 1) En el primer pintado solo hay un halo CSS -> no compite con el LCP.
// 2) Tras 'load', con el navegador libre, se importa @splinetool/runtime
//    y se carga la escena 3D; el canvas aparece con un fundido suave.
// 3) El halo violeta/dorado sigue al cursor con inercia cinemática.
// 4) Disolución de autor (Claroscuro puro): Las extremidades inferiores se desvanecen
//    con una curva cúbica ultra-suave y progresiva hacia el carbón del fondo,
//    eliminando cualquier corte limpio de forma pulcra, orgánica y sofisticada.
import { HERO_ROBOT_SCENE } from '../config/site';

interface Props {
  scene?: string;
}
const { scene = HERO_ROBOT_SCENE } = Astro.props;
---

<div class="robot-wrap" data-hero-robot data-scene={scene}>
  <!-- Luz rasante de taller detrás del robot -->
  <div class="robot-halo" aria-hidden="true"></div>

  <!-- Skeleton de lujo: boceto a línea dorada mientras Spline carga -->
  <div class="robot-skeleton" aria-hidden="true">
    <svg class="robot-skeleton__sketch" viewBox="0 0 200 260" fill="none">
      <ellipse cx="100" cy="62" rx="38" ry="42"></ellipse>
      <path d="M62 128c0-14 17-24 38-24s38 10 38 24v46c0 12-17 20-38 20s-38-8-38-20z"></path>
      <path d="M62 136c-16 6-24 22-26 44M138 136c16 6 24 22 26 44"></path>
    </svg>
    <span class="robot-skeleton__label">Preparando modelo 3D</span>
  </div>

  <!-- Canvas 3D interactivo con desvanecimiento etéreo en la base -->
  <canvas
    class="robot-canvas"
    role="img"
    aria-label="Robot 3D interactivo que sigue el movimiento del cursor"></canvas>
</div>

<script>
  type NetInfo = { saveData?: boolean };

  const wrap = document.querySelector<HTMLElement>('[data-hero-robot]');
  const canvas = wrap?.querySelector<HTMLCanvasElement>('.robot-canvas') ?? null;
  const halo = wrap?.querySelector<HTMLElement>('.robot-halo') ?? null;

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(pointer: fine)').matches;
  const saveData =
    (navigator as Navigator & { connection?: NetInfo }).connection?.saveData === true;

  const hasWebGL = (() => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  })();

  async function mountRobot(el: HTMLElement, cv: HTMLCanvasElement) {
    const scene = el.dataset.scene;
    if (!scene) return;
    try {
      const { Application } = await import('@splinetool/runtime');
      const app = new Application(cv);
      await app.load(scene);
      el.classList.add('is-ready');
    } catch (err) {
      // Sin 3D la composición sigue completa: se retira el boceto y queda la luz.
      el.classList.add('is-failed');
      console.warn('[HeroRobot] No se pudo cargar la escena Spline:', err);
    }
  }

  /** El halo cósmico sigue al cursor con inercia cinemática suave */
  function followCursor(el: HTMLElement, glow: HTMLElement) {
    let tx = 0;
    let ty = 0;
    let x = 0;
    let y = 0;
    let raf = 0;

    const tick = () => {
      x += (tx - x) * 0.08;
      y += (ty - y) * 0.08;
      glow.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(tick) : 0;
    };

    addEventListener(
      'pointermove',
      (e) => {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0) return;
        tx = (e.clientX - (r.left + r.width / 2)) * 0.12;
        ty = (e.clientY - (r.top + r.height / 2)) * 0.12;
        if (!raf) raf = requestAnimationFrame(tick);
      },
      { passive: true },
    );
  }

  if (wrap && canvas && window.innerWidth >= 768) {
    if (halo && finePointer && !reduceMotion) {
      followCursor(wrap, halo);
    }

    if (hasWebGL && !saveData) {
      // Tras 'load' y con el hilo principal libre: Spline nunca compite con el LCP.
      const IDLE_TIMEOUT_MS = 1200;
      const mount = () => void mountRobot(wrap, canvas);
      const whenIdle = () =>
        'requestIdleCallback' in window
          ? requestIdleCallback(mount, { timeout: IDLE_TIMEOUT_MS })
          : setTimeout(mount, 200);
      if (document.readyState === 'complete') whenIdle();
      else addEventListener('load', whenIdle, { once: true });
    } else {
      // Sin WebGL o con ahorro de datos no habrá escena: se retira el boceto.
      wrap.classList.add('is-failed');
    }
  }
</script>

<style>
  .robot-wrap {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
  }

  /* Luz rasante de taller: un foco ámbar cae en diagonal desde arriba a la
     izquierda y se apaga en ciruela, como la ventana alta de Rembrandt.
     Sin filter: blur (cliché 22): la suavidad sale de la elipse misma. */
  .robot-halo {
    position: absolute;
    left: 50%;
    top: 42%;
    width: min(64vw, 860px);
    aspect-ratio: 4 / 5;
    translate: -50% -50%;
    background:
      radial-gradient(
        ellipse 46% 38% at 38% 30%,
        rgb(217 119 6 / 0.2) 0%,
        rgb(180 83 9 / 0.08) 45%,
        transparent 100%
      ),
      radial-gradient(
        ellipse 60% 52% at 56% 56%,
        rgb(76 29 149 / 0.34) 0%,
        rgb(46 16 101 / 0.16) 50%,
        transparent 100%
      );
    will-change: transform;
    animation: breathe 9s var(--ease-oil) infinite;
  }

  /* ── Canvas del Robot 3D ── */
  .robot-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    outline: none;
    transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1);
    /* 
      DISOLUCIÓN DE AUTOR (Claroscuro puro):
      El torso, brazos y cadera se mantienen 100% nítidos, sólidos y reflectantes.
      Las piernas inician una transición fotométrica suave hacia el fondo a partir del 55%,
      desvaneciéndose con una curva cúbica perfecta antes de alcanzar el borde (96%),
      lo que elimina cualquier sensación de corte limpio sin añadir elementos discordantes.
    */
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 54%,
      rgba(0, 0, 0, 0.94) 66%,
      rgba(0, 0, 0, 0.72) 76%,
      rgba(0, 0, 0, 0.38) 85%,
      rgba(0, 0, 0, 0.12) 92%,
      transparent 97%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 54%,
      rgba(0, 0, 0, 0.94) 66%,
      rgba(0, 0, 0, 0.72) 76%,
      rgba(0, 0, 0, 0.38) 85%,
      rgba(0, 0, 0, 0.12) 92%,
      transparent 97%
    );
  }

  .robot-wrap.is-ready .robot-canvas {
    opacity: 1;
    pointer-events: auto;
  }

  /* En táctil/móvil */
  @media (max-width: 767px), (pointer: coarse) {
    .robot-wrap.is-ready .robot-canvas {
      pointer-events: none;
    }
    .robot-halo {
      width: 86vw;
    }
  }

  /* ── Skeleton: el robot "se dibuja" a mano alzada en oro viejo ── */
  .robot-skeleton {
    position: absolute;
    left: 50%;
    top: 44%;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    translate: -50% -50%;
    transition: opacity 0.9s var(--ease-cine);
  }
  .robot-skeleton__sketch {
    width: clamp(120px, 12vw, 180px);
    stroke: rgb(217 119 6 / 0.55);
    stroke-width: 0.8;
    stroke-linecap: round;
  }
  .robot-skeleton__sketch :is(ellipse, path) {
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    animation: sketch 3.2s var(--ease-oil) infinite;
  }
  .robot-skeleton__sketch path:nth-of-type(1) {
    animation-delay: 0.25s;
  }
  .robot-skeleton__sketch path:nth-of-type(2) {
    animation-delay: 0.5s;
  }
  .robot-skeleton__label {
    font-size: 0.6rem;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: rgb(244 239 230 / 0.45);
  }
  .robot-wrap:is(.is-ready, .is-failed) .robot-skeleton {
    opacity: 0;
  }
  /* Sin WebGL, con ahorro de datos o en móvil no se intenta cargar: sin boceto */
  @media (max-width: 767px) {
    .robot-skeleton {
      display: none;
    }
  }

  @keyframes sketch {
    0% {
      stroke-dashoffset: 320;
      opacity: 0.2;
    }
    55% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0.2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .robot-skeleton__sketch :is(ellipse, path) {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  @keyframes breathe {
    0%,
    100% {
      scale: 1;
      opacity: 0.88;
    }
    50% {
      scale: 1.08;
      opacity: 1;
    }
  }
</style>
