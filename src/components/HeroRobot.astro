---
// Robot 3D interactivo (Spline).
// 1) En el primer pintado solo hay un halo CSS -> no compite con el LCP.
// 2) Tras 'load', con el navegador libre, se importa @splinetool/runtime
//    y se carga la escena 3D; el canvas aparece con un fundido suave.
// 3) El halo violeta/dorado sigue al cursor con inercia cinemática.
// 4) Disolución de autor (Claroscuro puro): Las extremidades inferiores se desvanecen
//    con una curva cúbica ultra-suave y progresiva hacia el carbón del fondo,
//    eliminando cualquier corte limpio de forma pulcra, orgánica y sofisticada.
import { HERO_ROBOT_SCENE } from '../config/site';

interface Props {
  scene?: string;
}
const { scene = HERO_ROBOT_SCENE } = Astro.props;
---
<!-- data-hero-orb: initHeroScroll() (smooth-scroll.ts) aleja este bloque al hacer scroll -->
<div class="robot-wrap" data-hero-robot data-hero-orb data-scene={scene}>
  <!-- Halo ambiental cósmico en claroscuro de autor -->
  <div class="robot-halo" aria-hidden="true"></div>

  <!-- Canvas 3D interactivo con desvanecimiento etéreo en la base -->
  <canvas
    class="robot-canvas"
    role="img"
    aria-label="Robot 3D interactivo que sigue el movimiento del cursor"
  ></canvas>
</div>

<script>
  
  type NetInfo = { saveData?: boolean };

  const wrap = document.querySelector<HTMLElement>('[data-hero-robot]');
  const canvas = wrap?.querySelector<HTMLCanvasElement>('.robot-canvas') ?? null;
  const halo = wrap?.querySelector<HTMLElement>('.robot-halo') ?? null;

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(pointer: fine)').matches;
  const saveData = (navigator as Navigator & { connection?: NetInfo }).connection?.saveData === true;

  const hasWebGL = (() => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  })();

  

  async function mountRobot(el: HTMLElement, cv: HTMLCanvasElement) {
    const scene = el.dataset.scene;
    if (!scene) return;
    try {
      const { Application } = await import('@splinetool/runtime');
      const app = new Application(cv);
      await app.load(scene);
      el.classList.add('is-ready');
    } catch (err) {
      console.warn('[HeroRobot] No se pudo cargar la escena Spline:', err);
    }
  }

  /** El halo cósmico sigue al cursor con inercia cinemática suave */
  function followCursor(el: HTMLElement, glow: HTMLElement) {
    let tx = 0;
    let ty = 0;
    let x = 0;
    let y = 0;
    let raf = 0;

    const tick = () => {
      x += (tx - x) * 0.08;
      y += (ty - y) * 0.08;
      glow.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(tick) : 0;
    };

    addEventListener(
      'pointermove',
      (e) => {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0) return;
        tx = (e.clientX - (r.left + r.width / 2)) * 0.12;
        ty = (e.clientY - (r.top + r.height / 2)) * 0.12;
        if (!raf) raf = requestAnimationFrame(tick);
      },
      { passive: true },
    );
  }

  if (wrap && canvas && window.innerWidth >= 768) {
    if (halo && finePointer && !reduceMotion) {
      followCursor(wrap, halo);
    }

    if (hasWebGL && !saveData) {
      // En PC: montar de inmediato para máxima rapidez sin retrasos artificiales
      void mountRobot(wrap, canvas);
    }
  }
</script>

<style>
  .robot-wrap {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
  }

  /* Halo violeta y dorado detrás del robot en claroscuro */
  .robot-halo {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(52vw, 700px);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgb(139 92 246 / 0.42) 0%,
      rgb(225 29 72 / 0.18) 35%,
      rgb(245 158 11 / 0.09) 55%,
      transparent 72%
    );
    filter: blur(52px);
    will-change: transform;
    animation: breathe 7s ease-in-out infinite;
  }

  /* ── Canvas del Robot 3D ── */
  .robot-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    outline: none;
    transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1);
    /* 
      DISOLUCIÓN DE AUTOR (Claroscuro puro):
      El torso, brazos y cadera se mantienen 100% nítidos, sólidos y reflectantes.
      Las piernas inician una transición fotométrica suave hacia el fondo a partir del 55%,
      desvaneciéndose con una curva cúbica perfecta antes de alcanzar el borde (96%),
      lo que elimina cualquier sensación de corte limpio sin añadir elementos discordantes.
    */
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 54%,
      rgba(0, 0, 0, 0.94) 66%,
      rgba(0, 0, 0, 0.72) 76%,
      rgba(0, 0, 0, 0.38) 85%,
      rgba(0, 0, 0, 0.12) 92%,
      transparent 97%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 54%,
      rgba(0, 0, 0, 0.94) 66%,
      rgba(0, 0, 0, 0.72) 76%,
      rgba(0, 0, 0, 0.38) 85%,
      rgba(0, 0, 0, 0.12) 92%,
      transparent 97%
    );
  }

  .robot-wrap.is-ready .robot-canvas {
    opacity: 1;
    pointer-events: auto;
  }

  /* En táctil/móvil */
  @media (max-width: 767px), (pointer: coarse) {
    .robot-wrap.is-ready .robot-canvas {
      pointer-events: none;
    }
    .robot-halo {
      width: 86vw;
    }
  }

  @keyframes breathe {
    0%, 100% { scale: 1; opacity: 0.88; }
    50% { scale: 1.08; opacity: 1; }
  }
</style>
