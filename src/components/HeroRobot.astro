---
// Robot 3D interactivo (Spline) emergiendo de una Brecha / Portal Dimensional.
// 1) En el primer pintado hay un halo y la brecha CSS cósmica -> no compite con el LCP.
// 2) La brecha dimensional rodea al personaje en 360°:
//    - Capa posterior (z-1): pasa por DETRÁS de las piernas.
//    - Robot Canvas (z-2): el personaje 3D con máscara de disolución etérea en la base.
//    - Capa frontal (z-3): pasa por DELANTE de la línea de corte con niebla de disolución y chispas.
// 3) Elimina el corte plano de las piernas creando una transición dimensional orgánica.
import { HERO_ROBOT_SCENE } from '../config/site';

interface Props {
  scene?: string;
}
const { scene = HERO_ROBOT_SCENE } = Astro.props;
---
<!-- data-hero-orb: initHeroScroll() (smooth-scroll.ts) aleja este bloque al hacer scroll -->
<div class="robot-wrap" data-hero-robot data-hero-orb data-scene={scene}>
  <!-- Halo ambiental cósmico en claroscuro -->
  <div class="robot-halo" aria-hidden="true"></div>

  <!-- 1. BRECHA DIMENSIONAL: CAPA POSTERIOR (pasa por detrás del robot) -->
  <div class="dimension-rift dimension-rift--back" aria-hidden="true">
    <div class="rift-nebula"></div>
    <div class="rift-disk">
      <div class="rift-ring rift-ring--outer"></div>
      <div class="rift-ring rift-ring--plasma"></div>
      <div class="rift-ring rift-ring--corona"></div>
      <div class="rift-core"></div>
    </div>
  </div>

  <!-- 2. CANVAS DEL ROBOT 3D (con máscara que desmaterializa la base de las piernas) -->
  <canvas
    class="robot-canvas"
    role="img"
    aria-label="Robot 3D interactivo que sigue el movimiento del cursor emergiendo de una brecha dimensional"
  ></canvas>

  <!-- 3. BRECHA DIMENSIONAL: CAPA FRONTAL (pasa por delante de la línea de corte) -->
  <div class="dimension-rift dimension-rift--front" aria-hidden="true">
    <div class="rift-disk rift-disk--front">
      <!-- El arco frontal del anillo rodea la parte delantera de las piernas -->
      <div class="rift-ring rift-ring--plasma-front"></div>
      <div class="rift-ring rift-ring--corona-front"></div>
    </div>
    <!-- Bruma de disolución y chispas cósmicas que brotan de la línea de corte -->
    <div class="rift-dissolve-mist"></div>
    <div class="rift-cut-glow"></div>
    <div class="rift-sparks">
      <span class="spark s1"></span>
      <span class="spark s2"></span>
      <span class="spark s3"></span>
      <span class="spark s4"></span>
      <span class="spark s5"></span>
      <span class="spark s6"></span>
      <span class="spark s7"></span>
      <span class="spark s8"></span>
    </div>
  </div>
</div>

<script>
  type IdleFn = (cb: () => void, opts?: { timeout: number }) => number;
  type NetInfo = { saveData?: boolean };

  const wrap = document.querySelector<HTMLElement>('[data-hero-robot]');
  const canvas = wrap?.querySelector<HTMLCanvasElement>('.robot-canvas') ?? null;
  const halo = wrap?.querySelector<HTMLElement>('.robot-halo') ?? null;
  const riftBack = wrap?.querySelector<HTMLElement>('.dimension-rift--back') ?? null;
  const riftFront = wrap?.querySelector<HTMLElement>('.dimension-rift--front') ?? null;

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(pointer: fine)').matches;
  const saveData = (navigator as Navigator & { connection?: NetInfo }).connection?.saveData === true;

  const hasWebGL = (() => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  })();

  const idle: IdleFn =
    (window as unknown as { requestIdleCallback?: IdleFn }).requestIdleCallback ??
    ((cb) => window.setTimeout(cb, 120));

  async function mountRobot(el: HTMLElement, cv: HTMLCanvasElement) {
    const scene = el.dataset.scene;
    if (!scene) return;
    try {
      const { Application } = await import('@splinetool/runtime');
      const app = new Application(cv);
      await app.load(scene);
      el.classList.add('is-ready');
    } catch (err) {
      console.warn('[HeroRobot] No se pudo cargar la escena Spline:', err);
    }
  }

  /** El halo y la brecha dimensional siguen al cursor con inercia cinemática */
  function followCursor(
    el: HTMLElement,
    glow: HTMLElement,
    rBack: HTMLElement | null,
    rFront: HTMLElement | null,
  ) {
    let tx = 0;
    let ty = 0;
    let x = 0;
    let y = 0;
    let raf = 0;

    const tick = () => {
      x += (tx - x) * 0.08;
      y += (ty - y) * 0.08;
      glow.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
      const rx = (x * 0.22).toFixed(1);
      const ry = (y * 0.22).toFixed(1);
      if (rBack) {
        rBack.style.transform = `translate3d(calc(-50% + ${rx}px), ${ry}px, 0)`;
      }
      if (rFront) {
        rFront.style.transform = `translate3d(calc(-50% + ${rx}px), ${ry}px, 0)`;
      }
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(tick) : 0;
    };

    addEventListener(
      'pointermove',
      (e) => {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0) return;
        tx = (e.clientX - (r.left + r.width / 2)) * 0.12;
        ty = (e.clientY - (r.top + r.height / 2)) * 0.12;
        if (!raf) raf = requestAnimationFrame(tick);
      },
      { passive: true },
    );
  }

  if (wrap && canvas) {
    if (halo && finePointer && !reduceMotion) {
      followCursor(wrap, halo, riftBack, riftFront);
    }

    if (hasWebGL && !saveData) {
      const boot = () => idle(() => void mountRobot(wrap, canvas), { timeout: 2000 });
      if (document.readyState === 'complete') boot();
      else addEventListener('load', boot, { once: true });
    }
  }
</script>

<style>
  .robot-wrap {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
  }

  /* Halo violeta y dorado detrás del robot */
  .robot-halo {
    position: absolute;
    left: 50%;
    top: 45%;
    width: min(50vw, 680px);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgb(139 92 246 / 0.4) 0%,
      rgb(225 29 72 / 0.2) 35%,
      rgb(245 158 11 / 0.1) 55%,
      transparent 72%
    );
    filter: blur(48px);
    will-change: transform;
    animation: breathe 7s ease-in-out infinite;
  }

  /* ── ESTRUCTURA COMÚN DE LA BRECHA DIMENSIONAL ── */
  .dimension-rift {
    position: absolute;
    left: 50%;
    /* Posicionado exactamente a la altura de la base de las piernas (donde ocurre el corte) */
    bottom: 3.5%;
    width: min(88%, 560px);
    height: 190px;
    transform: translate3d(-50%, 0, 0);
    pointer-events: none;
  }

  /* Capa posterior: z-index 1 (pasa por detrás del canvas) */
  .dimension-rift--back {
    z-index: 1;
  }

  /* Capa frontal: z-index 3 (pasa por delante del canvas y de la línea de corte) */
  .dimension-rift--front {
    z-index: 3;
  }

  /* Resplandor nebular profundo bajo el portal */
  .rift-nebula {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 140%;
    height: 140%;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgba(139, 92, 246, 0.45) 0%,
      rgba(244, 63, 94, 0.2) 35%,
      rgba(251, 191, 36, 0.15) 55%,
      transparent 75%
    );
    filter: blur(40px);
    animation: nebula-breathe 8s ease-in-out infinite alternate;
  }

  /* Disco 3D inclinado en perspectiva cinemática */
  .rift-disk {
    position: absolute;
    inset: 0;
    transform: perspective(750px) rotateX(76deg);
    transform-style: preserve-3d;
  }

  /* El disco frontal solo muestra la mitad inferior (el arco que pasa por DELANTE del personaje) */
  .rift-disk--front {
    clip-path: polygon(0 48%, 100% 48%, 100% 100%, 0 100%);
  }

  /* El disco posterior muestra preferentemente la mitad superior (el arco que pasa por DETRÁS) */
  .dimension-rift--back .rift-disk {
    clip-path: polygon(0 0, 100% 0, 100% 55%, 0 55%);
  }

  /* Anillo exterior de órbita estelar */
  .rift-ring--outer {
    position: absolute;
    inset: -6%;
    border-radius: 50%;
    border: 1.5px dashed rgba(216, 180, 254, 0.45);
    box-shadow:
      0 0 25px rgba(139, 92, 246, 0.35),
      inset 0 0 20px rgba(251, 191, 36, 0.2);
    animation: rift-spin-slow 40s linear infinite;
  }

  /* Corrientes espirales de plasma cósmico (violeta, carmesí, oro de Rembrandt) */
  .rift-ring--plasma,
  .rift-ring--plasma-front {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      rgba(139, 92, 246, 0.95) 45deg,
      transparent 90deg,
      rgba(244, 63, 94, 0.85) 155deg,
      transparent 205deg,
      rgba(251, 191, 36, 0.95) 270deg,
      transparent 325deg
    );
    filter: blur(2px);
    animation: rift-spin 14s linear infinite;
  }

  /* Corona del horizonte de sucesos (luz intensa de singularidad) */
  .rift-ring--corona,
  .rift-ring--corona-front {
    position: absolute;
    inset: 16%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      transparent 24%,
      rgba(139, 92, 246, 0.35) 44%,
      rgba(251, 191, 36, 0.7) 66%,
      rgba(255, 255, 255, 0.95) 78%,
      transparent 88%
    );
    box-shadow:
      0 0 45px rgba(168, 85, 247, 0.85),
      0 0 80px rgba(251, 191, 36, 0.55);
    animation: corona-pulse 3.8s ease-in-out infinite alternate;
  }

  /* Núcleo oscuro de la brecha (de donde sale el robot) */
  .rift-core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 50%;
    height: 50%;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #03000a 65%,
      rgba(139, 92, 246, 0.5) 88%,
      transparent 100%
    );
    box-shadow: inset 0 0 25px #020008;
  }

  /* ── EFECTOS DE DISOLUCIÓN FRONTAL DIRECTAMENTE SOBRE LA LÍNEA DE CORTE ── */
  /* Niebla etérea que disuelve el corte seco de las piernas */
  .rift-dissolve-mist {
    position: absolute;
    left: 50%;
    top: 48%;
    width: 85%;
    height: 55px;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgba(139, 92, 246, 0.6) 0%,
      rgba(251, 191, 36, 0.3) 40%,
      rgba(244, 63, 94, 0.15) 60%,
      transparent 80%
    );
    filter: blur(14px);
    mix-blend-mode: screen;
    animation: mist-float 4.5s ease-in-out infinite alternate;
  }

  /* Resplandor lineal sutil exactamente sobre la cota de corte */
  .rift-cut-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 60%;
    height: 4px;
    translate: -50% -50%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(139, 92, 246, 0.7) 25%,
      rgba(255, 255, 255, 0.95) 50%,
      rgba(251, 191, 36, 0.7) 75%,
      transparent 100%
    );
    box-shadow:
      0 0 16px rgba(255, 255, 255, 0.9),
      0 0 32px rgba(168, 85, 247, 0.7);
    filter: blur(1.5px);
    border-radius: 999px;
  }

  /* ── Chispas estelares ascendentes desde el corte ── */
  .rift-sparks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .spark {
    position: absolute;
    bottom: 46%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 8px #fbbf24, 0 0 14px #a855f7;
    opacity: 0;
    animation: spark-rise 3.2s ease-out infinite;
  }

  .spark.s1 { left: 32%; animation-delay: 0s; --dx: -14px; }
  .spark.s2 { left: 40%; animation-delay: 0.5s; --dx: 10px; width: 4px; height: 4px; }
  .spark.s3 { left: 48%; animation-delay: 1.1s; --dx: -8px; }
  .spark.s4 { left: 54%; animation-delay: 1.7s; --dx: 14px; width: 3.5px; height: 3.5px; }
  .spark.s5 { left: 62%; animation-delay: 2.3s; --dx: -12px; }
  .spark.s6 { left: 44%; animation-delay: 2.8s; --dx: -18px; width: 2.5px; height: 2.5px; }
  .spark.s7 { left: 58%; animation-delay: 3.3s; --dx: 12px; }
  .spark.s8 { left: 66%; animation-delay: 0.8s; --dx: 20px; }

  /* ── Canvas del Robot 3D (Capa intermedia: z-index 2) ── */
  .robot-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    outline: none;
    z-index: 2;
    transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1);
    /* 
      MÁSCARA DE DESMATERIALIZACIÓN:
      El robot se mantiene 100% nítido y opaco en torso y cadera (0% a 78%).
      Al aproximarse a la brecha (78% a 96%), la base de las piernas se disuelve 
      de forma degradada hacia el centro del portal cósmico, eliminando cualquier corte limpio.
    */
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 78%, rgba(0, 0, 0, 0.85) 86%, rgba(0, 0, 0, 0.25) 94%, transparent 98%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 78%, rgba(0, 0, 0, 0.85) 86%, rgba(0, 0, 0, 0.25) 94%, transparent 98%);
  }

  .robot-wrap.is-ready .robot-canvas {
    opacity: 1;
    pointer-events: auto;
  }

  /* En táctil/móvil */
  @media (max-width: 767px), (pointer: coarse) {
    .robot-wrap.is-ready .robot-canvas {
      pointer-events: none;
    }
    .robot-halo {
      width: 86vw;
    }
    .dimension-rift {
      width: min(94%, 420px);
      height: 150px;
      bottom: 2%;
    }
  }

  @keyframes breathe {
    0%, 100% { scale: 1; opacity: 0.88; }
    50% { scale: 1.08; opacity: 1; }
  }

  @keyframes nebula-breathe {
    0%, 100% { transform: scale(1); opacity: 0.85; }
    50% { transform: scale(1.12); opacity: 1; }
  }

  @keyframes rift-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes rift-spin-slow {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }

  @keyframes corona-pulse {
    0% { transform: scale(0.96); opacity: 0.82; }
    100% { transform: scale(1.04); opacity: 1; }
  }

  @keyframes mist-float {
    0% { transform: translate(-50%, -50%) scale(0.95); opacity: 0.8; }
    100% { transform: translate(-50%, -50%) scale(1.05); opacity: 1; }
  }

  @keyframes spark-rise {
    0% {
      transform: translate3d(0, 0, 0) scale(0.4);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    80% {
      opacity: 0.8;
    }
    100% {
      transform: translate3d(var(--dx, 10px), -100px, 0) scale(1.1);
      opacity: 0;
    }
  }
</style>
