---
import { waLink, waSections } from '../config/site';

const wa = waSections.proceso;
const steps = [
  {
    title: '1. Nos escribes por WhatsApp',
    text: 'Nos cuentas qué vendes, a quién te diriges y qué estilo buscas. Con eso es suficiente para iniciar tu proyecto sin formularios engorrosos ni reuniones interminables.',
  },
  {
    title: '2. Diseñamos y afinamos contigo',
    text: 'Te presentamos la propuesta visual en tiempo récord (3 a 5 días para planes express). Hacemos los ajustes necesarios contigo para que tu marca se vea impecable.',
  },
  {
    title: '3. Lanzamiento y ventas en vivo',
    text: 'Publicamos tu sitio en tu dominio propio, optimizado para celulares y Google, con el botón de WhatsApp configurado para recibir clientes desde el primer minuto.',
  },
];
---
<section
  id="proceso"
  class="relative isolate py-20 md:py-28"
  data-wa-label={wa.label}
  data-wa-message={wa.message}
>
  <!-- Fondo en claroscuro: Lección de Anatomía (1632), viñeta radial + duotono violeta/carbón -->
  <div class="art-bg pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <img src="/art/anatomy.jpg" alt="" loading="lazy" decoding="async" draggable="false" style="opacity:0.09" />
  </div>
  <div class="mx-auto grid w-[min(1240px,calc(100%-2.5rem))] gap-14 md:grid-cols-[0.9fr_1.1fr] md:items-start">
    <div>
      <div class="inline-flex items-center gap-2 rounded-full bg-violet/10 px-3.5 py-1 text-xs font-medium uppercase tracking-[0.14em] text-violet-200 ring-1 ring-violet/30">
        Metodología ágil y sin fricción
      </div>
      <h2 class="mt-4 text-[clamp(2.2rem,4.4vw,4rem)] leading-[1.02]">
        Tres pasos directos, sin reuniones eternas.
      </h2>
      <p class="mt-4 max-w-[28rem] text-lg text-mute">
        Hacemos que lanzar la página web de tu negocio sea rápido, claro y sin complicaciones técnicas.
      </p>
      <a
        href={waLink(wa.message)}
        target="_blank"
        rel="noopener"
        class="btn btn-light mt-8"
        data-magnetic
        data-cursor="WHATSAPP"
      >
        Dar el primer paso
      </a>
    </div>

    <ol class="divide-y divide-white/10 border-y border-white/10">
      {steps.map((s) => (
        <li class="py-7">
          <h3 class="text-xl md:text-2xl font-sans font-semibold text-light">{s.title}</h3>
          <p class="mt-2.5 max-w-[34rem] text-sm md:text-base leading-relaxed text-mute">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .art-bg {
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 50%, #000 0%, transparent 100%);
    mask-image: radial-gradient(ellipse 60% 55% at 50% 50%, #000 0%, transparent 100%);
  }
  .art-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(140%) brightness(80%);
    mix-blend-mode: screen;
  }
  /* Duotono: tiñe las luces de violeta, las sombras quedan en carbón */
  .art-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-violet);
    mix-blend-mode: color;
    opacity: 0.35;
  }
</style>
