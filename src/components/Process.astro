---
import { waLink, waSections } from '../config/site';

const wa = waSections.proceso;
const steps = [
  {
    title: 'Primer Contacto & Diagnóstico Rápido',
    titleShort: 'Contacto y diagnóstico',
    text: 'Nos cuentas qué vendes, a quién y qué estilo buscas. Con eso arrancamos, sin formularios engorrosos ni reuniones eternas.',
    short: 'Cuéntanos qué vendes y a quién. Sin formularios ni reuniones eternas.',
  },
  {
    title: 'Diseño Editorial de Autor & Afinamiento',
    titleShort: 'Diseño y ajustes',
    text: 'Propuesta visual en tiempo récord (4–6 días hábiles en planes express) y ajustes contigo hasta que tu marca luzca impecable.',
    short: 'Propuesta visual en 4–6 días hábiles (planes express) y ajustes contigo.',
  },
  {
    title: 'Lanzamiento Oficial & Ventas en Vivo',
    titleShort: 'Lanzamiento y ventas',
    text: 'Publicamos en tu dominio, optimizado para celular y Google, con WhatsApp listo para recibir clientes desde el primer minuto.',
    short: 'Publicamos en tu dominio, optimizada para celular, Google y WhatsApp.',
  },
];
---
<section
  id="proceso"
  class="relative isolate py-20 md:py-28"
  data-wa-label={wa.label}
  data-wa-message={wa.message}
>
  <!-- Fondo en claroscuro: Lección de Anatomía (1632), viñeta radial + duotono violeta/carbón -->
  <div class="art-bg pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <img src="/art/anatomy.jpg" alt="" loading="lazy" decoding="async" draggable="false" style="opacity:0.09" />
  </div>
  <div class="mx-auto grid w-[min(1240px,calc(100%-2.5rem))] gap-14 md:grid-cols-[0.9fr_1.1fr] md:items-start max-md:gap-10">
    <div>
      <p class="text-xs uppercase tracking-[0.22em] text-mute font-medium">
        Metodología Ágil
      </p>
      <h2 class="mt-4 text-[clamp(2.2rem,4.4vw,4rem)] leading-[1.02]">
        Tres pasos directos, sin reuniones eternas.
      </h2>
      <p class="mt-4 max-w-[28rem] text-lg text-mute max-sm:mt-3 max-sm:text-base">
        <span class="max-sm:hidden">Lanza la web de tu negocio rápido, claro y sin complicaciones técnicas.</span>
        <span class="sm:hidden">Tu web lista rápido, sin complicaciones técnicas.</span>
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4 max-sm:gap-3.5">
        <a
          href="/proceso"
          class="btn btn-light btn-float max-sm:text-sm"
          data-magnetic
        >
          <span class="radar" aria-hidden="true"></span>
          Conocer proceso a fondo
        </a>
        <a
          href={waLink(wa.message)}
          target="_blank"
          rel="noopener"
          class="btn btn-ghost max-sm:text-sm"
          data-magnetic
          data-cursor="WHATSAPP"
        >
          <span class="radar radar-emerald" aria-hidden="true"></span>
          Dar el primer paso
        </a>
      </div>
    </div>

    <ol class="divide-y divide-white/10 border-y border-white/10">
      {steps.map((s, si) => (
        <li class="py-7 max-sm:py-5">
          <h3 class="flex items-baseline gap-3 text-xl md:text-2xl font-sans font-semibold text-light max-sm:text-lg max-sm:leading-snug">
            <span class="font-display text-sm text-gold/80 tabular-nums" aria-hidden="true">0{si + 1}</span>
            <span class="max-sm:hidden">{s.title}</span><span class="sm:hidden">{s.titleShort}</span>
          </h3>
          <p class="mt-2.5 max-w-[34rem] text-sm md:text-base leading-relaxed text-mute max-sm:mt-2"><span class="max-sm:hidden">{s.text}</span><span class="sm:hidden">{s.short}</span></p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .art-bg {
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 50%, #000 0%, transparent 100%);
    mask-image: radial-gradient(ellipse 60% 55% at 50% 50%, #000 0%, transparent 100%);
  }
  .art-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(140%) brightness(80%);
    mix-blend-mode: screen;
  }
  /* Duotono: tiñe las luces de violeta, las sombras quedan en carbón */
  .art-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-violet);
    mix-blend-mode: color;
    opacity: 0.35;
  }
</style>
