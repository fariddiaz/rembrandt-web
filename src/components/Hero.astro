---
// Hero con storytelling dimensional.
// Estructura: #hero es una "pista" más alta que el viewport y .hero-stage queda
// fija (sticky) mientras se recorre. Así el efecto de tensión 3D no usa pin-spacer
// de GSAP y la altura está reservada en CSS desde el primer pintado (CLS = 0).
// - PC: HeroDesktop (robot Spline + marco) y coreografía en hero-cinematic.ts.
// - Móvil o movimiento reducido: pista de altura normal, sin tensión.
// El copy (h1, CTAs, métricas) es único y compartido por ambas experiencias.
import HeroDesktop from './HeroDesktop.astro';
import { plans, waSections } from '../config/site';

const wa = waSections.hero;
const fromPrice = plans[0]?.priceUsd ?? '$249 USD';
---

<section
  id="hero"
  class="hero-track relative"
  data-wa-label={wa.label}
  data-wa-message={wa.message}
>
  <div class="hero-stage relative isolate overflow-hidden" data-hero-stage>
    <!-- Foco de luz en el escenario (no en el lienzo que se escala): al inclinarse
         la escena no aparece ningún rectángulo, solo se mueve el contenido. -->
    <div class="spotlight pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

    <div
      class="hero-canvas relative flex min-h-svh items-center pt-28 pb-16 max-sm:pb-24 md:pt-36 md:pb-20"
      data-hero-canvas
    >
      <HeroDesktop />

      <div
        class="hero-copy-layer pointer-events-none relative mx-auto w-[min(1240px,calc(100%-2.5rem))] max-sm:w-[min(1240px,calc(100%-2rem))]"
        data-hero-copy
      >
        <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr]">
          <!-- Columna izquierda: mensaje comercial -->
          <div class="pointer-events-auto max-w-[42rem]">
            <h1
              class="hero-title font-display text-[clamp(2.5rem,5.6vw,5.2rem)] leading-[0.98] max-sm:text-[clamp(2.3rem,9vw,2.9rem)]"
            >
              <span class="line"><span>Tu página web profesional,</span></span>
              <span class="line"><span>rápida y diseñada</span></span>
              <span class="line"><span class="text-gold">para vender.</span></span>
            </h1>

            <p
              class="hero-copy mt-7 max-w-[34rem] text-[clamp(1.05rem,1.35vw,1.22rem)] leading-relaxed text-mute max-sm:mt-5 max-sm:text-[0.98rem] max-sm:leading-[1.6]"
            >
              <span class="max-sm:hidden"
                >Diseño de autor e ingeniería digital. Webs express en 4 a 6 días hábiles y
                proyectos con 3D interactivo para marcas que quieren destacar y convertir visitas en
                clientes.</span
              >
              <span class="sm:hidden"
                >Webs express en <strong class="font-semibold text-light">4 a 6 días hábiles</strong
                > y proyectos 3D para marcas que quieren vender.</span
              >
            </p>

            <div class="hero-cta mt-9 flex flex-wrap items-center gap-4 max-sm:mt-7 max-sm:gap-3">
              <a
                href="/planes"
                class="btn btn-light btn-float max-sm:text-sm"
                data-magnetic
                data-cursor="PLANES"
              >
                <span class="radar" aria-hidden="true"></span>
                Ver planes y precios
              </a>
              <a href="/contacto" class="btn btn-ghost max-sm:text-sm" data-magnetic>
                Cotizar proyecto
              </a>
            </div>

            <dl
              class="hero-cta mt-10 grid max-w-[36rem] grid-cols-3 gap-3 max-sm:mt-8 max-sm:gap-2"
            >
              <div
                class="hero-metric-card glass flex flex-col items-center justify-center rounded-lg p-3.5 text-center max-sm:p-2.5"
              >
                <dt class="sr-only">Entrega</dt>
                <dd
                  class="font-display text-xl leading-none text-light md:text-2xl max-sm:text-base"
                >
                  4 a 6 días
                </dd>
                <dd
                  class="mt-1.5 text-xs text-mute max-sm:mt-1 max-sm:text-[0.68rem] max-sm:leading-tight"
                >
                  Entrega garantizada
                </dd>
              </div>
              <div
                class="hero-metric-card glass flex flex-col items-center justify-center rounded-lg p-3.5 text-center max-sm:p-2.5"
                style="animation-delay: 1.6s;"
              >
                <dt class="sr-only">Velocidad</dt>
                <dd
                  class="font-display text-xl leading-none text-light md:text-2xl max-sm:text-base"
                >
                  0.7 s
                </dd>
                <dd
                  class="mt-1.5 text-xs text-mute max-sm:mt-1 max-sm:text-[0.68rem] max-sm:leading-tight"
                >
                  Tiempo de carga
                </dd>
              </div>
              <div
                class="hero-metric-card glass flex flex-col items-center justify-center rounded-lg p-3.5 text-center max-sm:p-2.5"
                style="animation-delay: 3.2s;"
              >
                <dt class="sr-only">Precio</dt>
                <dd
                  class="font-display text-xl leading-none text-light md:text-2xl max-sm:text-base"
                >
                  Desde {fromPrice.split(' ')[0]}
                </dd>
                <dd
                  class="mt-1.5 text-xs text-mute max-sm:mt-1 max-sm:text-[0.68rem] max-sm:leading-tight"
                >
                  Sin letra chica
                </dd>
              </div>
            </dl>
          </div>

          <!-- Columna derecha: espacio libre para el robot -->
          <div class="hidden min-h-[380px] lg:block" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <!-- Velo de cierre a pantalla completa, fuera del lienzo 3D: cubre también al
         robot y nunca dibuja un borde, porque no se escala con la escena. -->
    <span class="hero-dim pointer-events-none absolute inset-0" data-hero-dim aria-hidden="true"
    ></span>
  </div>
</section>

<script>
  import { initHeroCinematic } from '../scripts/hero-cinematic';
  initHeroCinematic();
</script>

<style>
  /* Pista de tensión: solo PC y con movimiento permitido. La altura extra
     (85svh) es el recorrido en el que la escena se enmarca antes de liberarse. */
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .hero-track {
      height: 185svh;
    }
    .hero-stage {
      position: sticky;
      top: 0;
      height: 100svh;
      perspective: 1400px;
      perspective-origin: 50% 40%;
    }
    .hero-canvas {
      height: 100%;
      transform-origin: 50% 42%;
      transform-style: preserve-3d;
      will-change: transform;
    }
  }

  /* Se funde hacia el carbón desde los bordes: sin aristas visibles */
  .hero-dim {
    background: radial-gradient(
      ellipse 85% 80% at 50% 45%,
      rgb(7 6 9 / 0.85) 0%,
      var(--color-carbon) 100%
    );
    opacity: 0;
  }

  .hero-title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .hero-title .line > span {
    display: inline-block;
    animation: rise 1.2s var(--ease-cine) both;
  }
  .hero-title .line:nth-child(2) > span {
    animation-delay: 0.08s;
  }
  .hero-title .line:nth-child(3) > span {
    animation-delay: 0.16s;
  }

  .hero-copy {
    animation: rise 1.2s var(--ease-cine) 0.22s both;
  }
  .hero-cta {
    animation: rise 1.2s var(--ease-cine) 0.32s both;
  }

  .hero-metric-card {
    will-change: transform;
    animation: metric-float 4.8s ease-in-out infinite;
  }
  .hero-metric-card dd {
    margin: 0;
  }

  @keyframes metric-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.4rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-metric-card {
      animation: none;
    }
  }
</style>
