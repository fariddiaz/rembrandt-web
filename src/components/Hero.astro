---
import HeroRobot from './HeroRobot.astro';
import { plans, waSections } from '../config/site';

const wa = waSections.hero;
const fromPrice = plans[0]?.priceUsd ?? '$249 USD';
---
<section
  id="hero"
  class="relative isolate flex min-h-[92svh] items-center overflow-hidden pt-28 pb-12 md:pt-36 md:pb-16"
  data-wa-label={wa.label}
  data-wa-message={wa.message}
>
  <!-- Foco de luz de fondo -->
  <div class="spotlight absolute inset-0 -z-10"></div>

  <!-- Robot 3D interactivo (Spline): exclusivo para PC, 100% omitido en móvil -->
  <div class="hidden md:block absolute inset-y-0 left-[42%] right-[-4%] top-0 h-auto -z-10">
    <HeroRobot />
  </div>

  <div class="pointer-events-none mx-auto w-[min(1240px,calc(100%-2.5rem))] max-sm:w-[min(1240px,calc(100%-2rem))]">
    <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr]">
      
      <!-- Columna Izquierda: Mensaje Comercial de Alto Impacto -->
      <div class="pointer-events-auto max-w-[42rem]">
        
        <!-- Título H1 principal con tipografía equilibrada y legible -->
        <h1 class="hero-title font-display text-[clamp(2.5rem,5.6vw,5.2rem)] leading-[0.98] max-sm:text-[clamp(2.3rem,9vw,2.9rem)]">
          <span class="line"><span>Tu página web profesional,</span></span>
          <span class="line"><span>rápida y diseñada</span></span>
          <span class="line"><span class="bg-gradient-to-r from-violet-300 via-light to-violet-400 bg-clip-text text-transparent">para vender.</span></span>
        </h1>

        <!-- Subtítulo formal, claro para todo público emprendedor -->
        <p class="hero-copy mt-7 max-w-[34rem] text-[clamp(1.05rem,1.35vw,1.22rem)] leading-relaxed text-mute max-sm:mt-5 max-sm:text-[0.95rem] max-sm:leading-[1.6]">
          Diseño de autor e ingeniería digital. Webs express en 4–6 días hábiles y proyectos con 3D interactivo para marcas que quieren destacar y convertir visitas en clientes.
        </p>

        <!-- Botones de Acción (CTAs) -->
        <div class="hero-cta mt-9 flex flex-wrap items-center gap-4 max-sm:mt-8 max-sm:gap-3.5">
          <a
            href="/planes"
            class="btn btn-light btn-float max-sm:text-sm"
            data-magnetic
            data-cursor="PLANES"
          >
            Ver planes y precios
          </a>
          <a
            href="/contacto"
            class="btn btn-ghost max-sm:text-sm"
            data-magnetic
          >
            Cotizar proyecto
          </a>
        </div>

        <!-- Métricas Rápidas en Mini Bento Cards con texto centrado y levitación orgánica -->
        <div class="hero-cta mt-10 grid max-w-[36rem] grid-cols-3 gap-3 max-sm:mt-9 max-sm:gap-2">
          <div class="hero-metric-card glass flex flex-col items-center justify-center rounded-2xl p-3.5 text-center backdrop-blur-md max-sm:p-2.5" style="animation-delay: 0s;">
            <p class="font-display text-xl leading-none text-light md:text-2xl max-sm:text-base">4–6 días</p>
            <p class="mt-1.5 text-xs text-mute max-sm:mt-1 max-sm:text-[0.68rem] max-sm:leading-tight">Entrega garantizada</p>
          </div>
          <div class="hero-metric-card glass flex flex-col items-center justify-center rounded-2xl p-3.5 text-center backdrop-blur-md max-sm:p-2.5" style="animation-delay: 1.6s;">
            <p class="font-display text-xl leading-none text-light md:text-2xl max-sm:text-base">0.7s</p>
            <p class="mt-1.5 text-xs text-mute max-sm:mt-1 max-sm:text-[0.68rem] max-sm:leading-tight">Tiempo de carga</p>
          </div>
          <div class="hero-metric-card glass flex flex-col items-center justify-center rounded-2xl p-3.5 text-center backdrop-blur-md max-sm:p-2.5" style="animation-delay: 3.2s;">
            <p class="font-display text-xl leading-none text-light md:text-2xl max-sm:text-base">Desde {fromPrice.split(' ')[0]}</p>
            <p class="mt-1.5 text-xs text-mute max-sm:mt-1 max-sm:text-[0.68rem] max-sm:leading-tight">Sin letra chica</p>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Libre para apreciar el Robot 3D Spline interactivo -->
      <div class="hidden lg:block min-h-[380px]" aria-hidden="true"></div>

    </div>
  </div>
</section>

<style>
  .hero-title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .hero-title .line > span {
    display: inline-block;
    animation: rise 1.2s var(--ease-cine) both;
  }
  .hero-title .line:nth-child(2) > span { animation-delay: 0.08s; }
  .hero-title .line:nth-child(3) > span { animation-delay: 0.16s; }

  .hero-copy {
    animation: rise 1.2s var(--ease-cine) 0.22s both;
  }
  .hero-cta {
    animation: rise 1.2s var(--ease-cine) 0.32s both;
  }

  /* Levitación continua, suave y orgánica para las métricas */
  .hero-metric-card {
    will-change: transform;
    animation: metric-float 4.8s ease-in-out infinite;
  }

  @keyframes metric-float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.4rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
