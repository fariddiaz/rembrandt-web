---
import { carePlan, waSections } from '../config/site';

const wa = waSections.cuidado;
---
<section
  id="cuidado"
  class="relative py-16 md:py-24"
  data-wa-label={wa.label}
  data-wa-message={wa.message}
>
  <div class="glass mx-auto grid w-[min(1240px,calc(100%-2.5rem))] items-center gap-10 rounded-[2rem] p-8 md:grid-cols-[1.2fr_1.1fr_auto] md:p-12 border border-white/10 shadow-2xl">
    <div>
      <p class="text-xs uppercase tracking-[0.2em] text-mute font-medium">
        Tranquilidad Total
      </p>
      <h2 class="mt-3 text-[clamp(2rem,3.4vw,2.8rem)] leading-tight text-light">
        {carePlan.name}
      </h2>
      <p class="mt-2 text-sm md:text-base text-mute">
        Nosotros cuidamos el funcionamiento técnico de tu web cada mes para que tú solo te ocupes de atender a tus clientes y vender.
      </p>
    </div>

    <ul class="space-y-3 text-sm text-light/90">
      {carePlan.features.map((f) => (
        <li class="flex gap-3 leading-snug">
          <span class="mt-1 size-1.5 shrink-0 rounded-full bg-violet-400" aria-hidden="true" />
          <span>{f}</span>
        </li>
      ))}
    </ul>

    <div class="md:text-right">
      <p class="font-display text-4xl md:text-5xl leading-none text-light whitespace-nowrap">
        Desde $15<span class="font-sans text-base text-mute"> USD/mes</span>
      </p>
      <p class="text-xs text-mute mt-1 font-sans">O pago único a demanda</p>
      <a
        href="/planes"
        class="btn btn-ghost mt-5 !py-3 !px-6 text-sm"
        data-magnetic="0.3"
      >
        Ver Paquetes de Cuidado
      </a>
    </div>
  </div>
</section>
