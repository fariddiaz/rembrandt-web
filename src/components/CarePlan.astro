---
import { carePlan, waLink, waSections } from '../config/site';
const wa = waSections.cuidado;
---
<section
  id="cuidado"
  class="py-[10vh]"
  data-wa-label={wa.label}
  data-wa-message={wa.message}
>
  <div class="glass mx-auto grid w-[min(1180px,calc(100%-2.5rem))] items-center gap-10 rounded-[2rem] p-8 md:grid-cols-[1fr_auto_auto] md:p-12">
    <div>
      <h2 class="text-[clamp(2rem,3.8vw,3rem)] leading-none">{carePlan.name}</h2>
      <p class="mt-3 max-w-[30rem] text-mute">Nosotros cuidamos tu web cada mes para que tú solo te ocupes de vender.</p>
    </div>
    <ul class="space-y-2 text-[0.98rem]">
      {carePlan.features.map((f) => (
        <li class="flex gap-3"><span class="mt-[0.5em] size-1.5 shrink-0 rounded-full bg-violet" aria-hidden="true" />{f}</li>
      ))}
    </ul>
    <div class="md:text-right">
      <p class="font-display text-5xl leading-none">{carePlan.priceUsd}<span class="font-sans text-lg text-mute">{carePlan.unit}</span></p>
      <a
        href={waLink(carePlan.message)}
        target="_blank"
        rel="noopener"
        class="btn btn-ghost mt-6"
        data-magnetic="0.3"
        data-cursor="WHATSAPP"
      >
        {carePlan.cta}
      </a>
    </div>
  </div>
</section>
