---
// Banner de Gestión de Consentimiento de Cookies (Ley 1581 de 2012 & RGPD).
// Distingue cookies técnicas esenciales de cookies analíticas opcionales.
// Permite aceptar y rechazar con facilidad equivalente, sin patrones oscuros.
---
<aside
  id="cookie-consent-banner"
  class="fixed bottom-4 left-4 right-4 z-[9990] mx-auto hidden max-w-xl rounded-2xl border border-white/15 bg-carbon/95 p-5 shadow-2xl backdrop-blur-2xl transition-all duration-300 md:bottom-6 md:left-6 md:right-auto"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-desc"
  aria-modal="false"
>
  <div class="flex flex-col gap-4">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="size-2 rounded-full bg-amber-400"></span>
        <h2 id="cookie-title" class="text-xs font-semibold uppercase tracking-wider text-light">
          Privacidad & Preferencias de Cookies
        </h2>
      </div>
      <button
        type="button"
        id="cookie-close-btn"
        class="text-mute hover:text-light transition-colors text-xs p-1"
        aria-label="Cerrar banner de cookies"
      >
        Cerrar
      </button>
    </div>

    <p id="cookie-desc" class="text-xs leading-relaxed text-mute">
      Utilizamos cookies técnicas necesarias para el funcionamiento del sitio y, con tu autorización, cookies analíticas anónimas para evaluar el rendimiento de la web. Puedes aceptar o rechazar las cookies no esenciales con un solo clic. Consulta nuestra{' '}
      <a href="/politica-de-privacidad" class="text-light underline underline-offset-2 hover:text-amber-200 transition-colors">
        Política de Privacidad
      </a>.
    </p>

    <div class="flex flex-wrap items-center gap-2.5 pt-1">
      <button
        type="button"
        id="cookie-accept-all"
        class="rounded-xl border border-amber-400/40 bg-white/10 px-4 py-2 text-xs font-medium text-light hover:bg-white/20 transition-all focus:outline-none focus:ring-2 focus:ring-amber-300 cursor-pointer"
      >
        Aceptar todas
      </button>

      <button
        type="button"
        id="cookie-reject-all"
        class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-xs font-medium text-mute hover:text-light hover:bg-white/10 transition-all focus:outline-none focus:ring-2 focus:ring-white/20 cursor-pointer"
      >
        Rechazar no esenciales
      </button>

      <a
        href="/politica-de-privacidad#cookies"
        class="ml-auto text-[0.72rem] text-mute/80 hover:text-light transition-colors underline"
      >
        Más información
      </a>
    </div>
  </div>
</aside>

<script>
  function initCookieConsent() {
    const banner = document.getElementById('cookie-consent-banner');
    const acceptBtn = document.getElementById('cookie-accept-all');
    const rejectBtn = document.getElementById('cookie-reject-all');
    const closeBtn = document.getElementById('cookie-close-btn');

    if (!banner) return;

    const STORAGE_KEY = 'rs_cookie_consent';
    const consent = localStorage.getItem(STORAGE_KEY);

    // Si aún no ha decidido, mostrar banner tras breve pausa para no interferir con LCP
    if (!consent) {
      setTimeout(() => {
        banner.classList.remove('hidden');
      }, 1200);
    }

    const setConsent = (status: 'accepted' | 'rejected') => {
      localStorage.setItem(STORAGE_KEY, status);
      banner.classList.add('hidden');

      // Actualizar Google Consent Mode si gtag está disponible
      if (typeof window !== 'undefined' && (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag) {
        (window as unknown as { gtag: (...args: unknown[]) => void }).gtag('consent', 'update', {
          analytics_storage: status === 'accepted' ? 'granted' : 'denied',
        });
      }

      // Despachar evento personalizado para componentes que escuchen cambios
      window.dispatchEvent(new CustomEvent('rs:cookie-consent', { detail: { status } }));
    };

    acceptBtn?.addEventListener('click', () => setConsent('accepted'));
    rejectBtn?.addEventListener('click', () => setConsent('rejected'));
    closeBtn?.addEventListener('click', () => setConsent('rejected'));

    // Escuchar botón externo de "Preferencias de cookies" (ej: desde el footer)
    window.addEventListener('rs:open-cookie-banner', () => {
      banner.classList.remove('hidden');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCookieConsent);
  } else {
    initCookieConsent();
  }
</script>
