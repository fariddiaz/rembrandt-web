---
import Logo from './Logo.astro';
import { waLink, waSections } from '../config/site';

const wa = waSections.showcase;

const logos = [
  { file: 'leymar.svg', name: 'Eventos Leymar' },
  { file: 'astro.svg', name: 'Astro' },
  { file: 'tailwind.svg', name: 'Tailwind CSS' },
  { file: 'nextjs.svg', name: 'Next.js' },
  { file: 'spline.svg', name: 'Spline 3D' },
  { file: 'typescript.svg', name: 'TypeScript' },
  { file: 'stripe.svg', name: 'Stripe' },
];
---
<section
  class="relative pt-6 pb-6 md:pt-10 md:pb-20 overflow-hidden"
  aria-label="Acerca del estudio"
  data-wa-label={wa.label}
  data-wa-message={wa.message}
>
  <div class="mx-auto w-[min(1240px,calc(100%-2.5rem))]">
    
    <!-- Frase Declarativa de Impacto (Estilo AgentAI) -->
    <div class="mb-16 max-w-4xl max-md:mb-10">
      <p class="text-[clamp(1.75rem,3.4vw,2.9rem)] font-light leading-[1.2] text-light max-sm:text-[1.4rem] max-sm:leading-[1.28]">
        <span class="max-sm:hidden">Diseñamos y programamos <span class="font-normal text-violet-300">soluciones web</span> centradas en las personas, para que cada <span class="font-normal text-rose-300">página convierta</span> visitas en clientes y ventas.</span>
        <span class="sm:hidden">Webs <span class="font-normal text-violet-300">de autor</span> que <span class="font-normal text-rose-300">convierten</span> visitas en clientes.</span>
      </p>
    </div>

    <!-- Bento Grid Showcase -->
    <div class="grid gap-6 md:grid-cols-12">
      
      <!-- Bento Card 1: Ubicación & Disponibilidad Global (7 cols) -->
      <div class="glass relative flex flex-col justify-between overflow-hidden rounded-[2rem] p-7 md:col-span-7 md:p-10 max-md:rounded-3xl max-sm:p-6">
        <!-- Iluminación cenital claroscuro -->
        <div class="absolute -right-16 -top-16 size-72 rounded-full bg-white/[0.03] blur-3xl" aria-hidden="true"></div>

        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-mute font-medium">
            Estudio Web de Autor
          </p>
          <h3 class="mt-4 text-[clamp(1.5rem,2.4vw,2rem)] leading-tight text-light max-sm:text-[1.4rem]">
            Estudio digital con alcance global <span class="text-mute font-sans text-lg max-sm:text-sm">· Colombia, EE.UU. y Latinoamérica</span>
          </h3>
          <p class="mt-2 max-w-md text-sm text-mute max-sm:mt-2.5 max-sm:text-xs max-sm:leading-relaxed">
            <span class="max-sm:hidden">100% en línea, por WhatsApp y videollamada. </span>Tu web express, lista en 4–6 días hábiles.
          </p>
          <a
            href={waLink('Hola Rembrandt Studio, quiero iniciar un proyecto web para mi negocio.')}
            target="_blank"
            rel="noopener"
            class="btn btn-light btn-float mt-6 !py-2.5 !px-5 text-sm"
            data-magnetic="0.3"
            data-cursor="PROYECTO"
          >
            <span class="radar" aria-hidden="true"></span>
            Iniciar Proyecto
          </a>
        </div>

        <!-- Preview visual inferior en tarjeta oscura con iluminación suave -->
        <div class="mt-8 overflow-hidden rounded-xl border border-white/10 bg-carbon-2/80 p-5 shadow-inner max-sm:p-4">
          <div class="flex items-center justify-between text-xs text-mute">
            <span class="flex items-center gap-2">
              <span class="radar radar-emerald !size-2" aria-hidden="true"></span>
              En desarrollo en tiempo real
            </span>
            <span class="rounded bg-white/5 px-2 py-0.5">Astro + Tailwind + 3D</span>
          </div>
          <div class="mt-4 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <Logo variant="mark-color" class="h-8 w-auto max-sm:h-7" />
              <div>
                <p class="font-display text-lg text-light max-sm:text-base">Tu Marca Aquí</p>
                <p class="text-xs text-mute max-sm:text-[0.7rem]">Diseño de autor sin plantillas genéricas</p>
              </div>
            </div>
            <span class="float-pulse is-fast shrink-0 rounded-md border border-[#d4af37]/25 bg-white/5 px-2.5 py-1 text-xs font-medium text-light">
              Entrega 4–6 días
            </span>
          </div>
        </div>
      </div>

      <!-- Bento Columna Derecha (5 cols) -->
      <div class="flex flex-col gap-6 md:col-span-5">
        
        <!-- Bento Card 2: Calidad e Ingeniería Verificada (Sin datos inflados) -->
        <div class="glass glass-sheen relative overflow-hidden rounded-[2rem] p-7 md:p-8 max-md:rounded-3xl max-sm:p-6">
          <p class="text-xs font-medium uppercase tracking-[0.14em] text-violet-300">
            Ingeniería & Calidad de Código
          </p>
          <p class="mt-4 font-display text-[clamp(2.4rem,3.8vw,3.4rem)] leading-none text-light">
            100%
          </p>
          <p class="mt-2 text-sm font-medium text-light">
            Código propio, sin plantillas pesadas
          </p>
          <p class="mt-2 text-xs leading-relaxed text-mute">
            Carga en menos de 1 segundo<span class="max-sm:hidden">, arquitectura moderna (Astro + Tailwind)</span> y entrega en el plazo acordado.
          </p>
        </div>

        <!-- Bento Card 3: Testimonio con cita y foto de Leidys Lascarro -->
        <div class="glass relative flex flex-col justify-between overflow-hidden rounded-[2rem] p-7 md:p-8 max-md:rounded-3xl max-sm:p-6">
          <div class="text-violet-400 text-2xl font-serif leading-none">“</div>
          <p class="mt-2 text-sm leading-relaxed text-light/90 max-sm:text-xs">
            El rediseño de nuestra web elevó el estatus de la marca ante parejas internacionales y aumentó notablemente las solicitudes de cotización directa por WhatsApp.<span class="max-sm:hidden"> Una inversión que marcó un antes y un después para Eventos Leymar.</span>
          </p>
          <div class="mt-5 flex items-center gap-3 border-t border-white/10 pt-4">
            <img
              src="/preview-assets/leidys-lascarro.jpg"
              alt="Leidys Lascarro, directora y fundadora de Eventos Leymar"
              width="40"
              height="40"
              loading="lazy"
              decoding="async"
              class="size-10 shrink-0 rounded-full object-cover ring-1 ring-white/15"
            />
            <div>
              <p class="text-xs font-semibold text-light">Leidys Lascarro</p>
              <p class="text-[0.7rem] text-mute">Directora & Fundadora · Eventos Leymar</p>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- Marquee infinito de logos de confianza (derecha → izquierda) -->
    <div class="mt-12 border-y border-white/10 py-6 max-sm:mt-8 max-sm:py-5">
      <p class="text-center text-xs font-medium uppercase tracking-[0.18em] text-mute/80">
        Tecnologías y marcas detrás de cada desarrollo
      </p>
      <div class="logo-marquee mt-6 overflow-hidden" aria-label="Marcas y tecnologías">
        <div class="logo-track flex w-max items-center">
          {[0, 1].map((copy) => (
            <ul class="flex shrink-0 items-center gap-14 pr-14 md:gap-20 md:pr-20" aria-hidden={copy === 1 ? 'true' : undefined}>
              {logos.map((l) => (
                <li class="shrink-0 flex items-center justify-center">
                  <img
                    src={`/logos/${l.file}`}
                    alt={copy === 0 ? l.name : ''}
                    width="150"
                    height="38"
                    loading="lazy"
                    decoding="async"
                    class:list={[
                      'w-auto transition-opacity opacity-80 hover:opacity-100',
                      l.file === 'leymar.svg' ? 'h-9 md:h-10' : 'h-6 md:h-7',
                    ]}
                  />
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </div>

    <!-- Puente Editorial de Alta Gama entre Marquee y Planes -->
    <div class="mt-8 flex items-center justify-center gap-3 max-sm:mt-6" aria-hidden="true">
      <div class="h-px w-8 sm:w-16 bg-gradient-to-r from-transparent to-violet-400/40"></div>
      <div class="glass float-pulse is-slow flex items-center gap-2 rounded-full border border-violet/20 px-3.5 py-1 text-[0.68rem] tracking-[0.2em] uppercase text-violet-300/90 shadow-[0_0_20px_-5px_rgba(139,92,246,0.25)]">
        <span class="radar radar-violet !size-1.5"></span>
        <span>Ingeniería Web de Autor · Precios Cerrados</span>
      </div>
      <div class="h-px w-8 sm:w-16 bg-gradient-to-l from-transparent to-violet-400/40"></div>
    </div>

  </div>
</section>

<style>
  .logo-marquee {
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }
  .logo-track {
    animation: marquee-scroll 28s linear infinite;
  }
  .logo-marquee:hover .logo-track {
    animation-play-state: paused;
  }
  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-track { animation: none; }
  }
</style>
