---
import { waLink, waSections } from '../config/site';
const wa = waSections.showcase;

const logos = [
  { file: 'leymar.svg', name: 'Eventos Leymar' },
  { file: 'lumina.svg', name: 'Lumina' },
  { file: 'aura.svg', name: 'Aura' },
  { file: 'zenith.svg', name: 'Zenith' },
  { file: 'orion.svg', name: 'Orion' },
  { file: 'vanguard.svg', name: 'Vanguard' },
];
---
<section class="relative py-16 md:py-24 overflow-hidden" aria-label="Acerca del estudio">
  <div class="mx-auto w-[min(1240px,calc(100%-2.5rem))]">
    
    <!-- Frase Declarativa de Impacto (Estilo AgentAI) -->
    <div class="mb-16 max-w-4xl">
      <p class="text-[clamp(1.75rem,3.4vw,2.9rem)] font-light leading-[1.2] text-light">
        Diseñamos y programamos <span class="font-normal text-violet-300">soluciones web</span> con las personas en el centro, asegurando que cada <span class="font-normal text-rose-300">página web convierta</span> visitas en clientes reales y ventas inmediatas.
      </p>
    </div>

    <!-- Bento Grid Showcase (Adaptado de la referencia visual) -->
    <div class="grid gap-6 md:grid-cols-12">
      
      <!-- Bento Card 1: Ubicación & Disponibilidad Global (7 cols) -->
      <div class="glass relative flex flex-col justify-between overflow-hidden rounded-[2rem] p-7 md:col-span-7 md:p-10">
        <!-- Glow ambiental de fondo -->
        <div class="absolute -right-16 -top-16 size-72 rounded-full bg-violet/20 blur-3xl" aria-hidden="true"></div>

        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-white/5 px-3.5 py-1 text-xs text-rose-300 ring-1 ring-white/10">
            <span class="size-1.5 rounded-full bg-rose-500 shadow-[0_0_8px_#f43f5e]" aria-hidden="true"></span>
            Disponible para proyectos en todo el mundo
          </div>
          <h3 class="mt-4 text-[clamp(1.5rem,2.4vw,2rem)] leading-tight text-light">
            Estudio Digital con Alcance Global <span class="text-mute font-sans text-lg">· Proyectos en Colombia, EE.UU. y Latinoamérica</span>
          </h3>
          <p class="mt-2 max-w-md text-sm text-mute">
            Coordinamos contigo 100% en línea por WhatsApp y videollamada para entregar tu web express en 24 a 48 horas sin fricción.
          </p>
          <a
            href={waLink('Hola Rembrandt Studio, quiero iniciar un proyecto web para mi negocio.')}
            target="_blank"
            rel="noopener"
            class="btn btn-light mt-6 !py-2.5 !px-5 text-sm"
            data-magnetic="0.3"
            data-cursor="PROYECTO"
          >
            Iniciar Proyecto
          </a>
        </div>

        <!-- Preview visual inferior en tarjeta oscura con iluminación suave -->
        <div class="mt-8 overflow-hidden rounded-xl border border-white/10 bg-carbon-2/80 p-5 shadow-inner">
          <div class="flex items-center justify-between text-xs text-mute">
            <span class="flex items-center gap-2">
              <span class="size-2 rounded-full bg-emerald-400"></span>
              En desarrollo en tiempo real
            </span>
            <span class="rounded bg-white/5 px-2 py-0.5">Astro + Tailwind + 3D</span>
          </div>
          <div class="mt-4 flex items-center justify-between gap-4">
            <div>
              <p class="font-display text-lg text-light">Tu Marca Aquí</p>
              <p class="text-xs text-mute">Diseño a la medida sin plantillas genéricas</p>
            </div>
            <span class="rounded-full bg-violet/20 px-3 py-1 text-xs font-semibold text-violet-300 ring-1 ring-violet/40">
              Entrega 24-48h
            </span>
          </div>
        </div>
      </div>

      <!-- Bento Columna Derecha (5 cols) -->
      <div class="flex flex-col gap-6 md:col-span-5">
        
        <!-- Bento Card 2: Rating & Confianza -->
        <div class="glass relative overflow-hidden rounded-[2rem] p-7 md:p-8">
          <p class="text-xs font-medium uppercase tracking-[0.14em] text-mute">
            Confianza respaldada por resultados reales
          </p>
          <p class="mt-4 font-display text-[clamp(2.5rem,4vw,3.6rem)] leading-none text-light">
            120+
          </p>
          <div class="mt-2 flex items-center gap-2">
            <div class="flex text-amber-400 text-sm">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </div>
            <span class="text-xs text-mute">Calificación 5.0 en Google y testimonios</span>
          </div>
          <p class="mt-3 text-xs text-mute">
            Entregamos desde páginas web express en 24h hasta tiendas y proyectos 3D con máxima puntualidad.
          </p>
        </div>

        <!-- Bento Card 3: Testimonio con cita y foto -->
        <div class="glass relative flex flex-col justify-between overflow-hidden rounded-[2rem] p-7 md:p-8">
          <div class="text-violet-400 text-2xl font-serif leading-none">“</div>
          <p class="mt-2 text-sm leading-relaxed text-light/90">
            El rediseño de nuestra web elevó el estatus de la marca ante parejas internacionales y aumentó notablemente las solicitudes de cotización directa por WhatsApp. Una inversión que marcó un antes y un después para Eventos Leymar.
          </p>
          <div class="mt-5 flex items-center gap-3 border-t border-white/10 pt-4">
            <img
              src="/preview-assets/leidys-lascarro.jpg"
              alt="Leidys Lascarro, directora y fundadora de Eventos Leymar"
              width="40"
              height="40"
              loading="lazy"
              decoding="async"
              class="size-10 shrink-0 rounded-full object-cover ring-1 ring-white/15"
            />
            <div>
              <p class="text-xs font-semibold text-light">Leidys Lascarro</p>
              <p class="text-[0.7rem] text-mute">Directora & Fundadora · Eventos Leymar</p>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- Marquee infinito de logos de confianza (derecha → izquierda) -->
    <div class="mt-16 border-y border-white/10 py-7">
      <p class="text-center text-xs font-medium uppercase tracking-[0.18em] text-mute/80">
        Marcas y negocios que impulsan su presencia digital con Rembrandt
      </p>
      <div class="logo-marquee mt-6 overflow-hidden" aria-label="Marcas cliente">
        <div class="logo-track flex w-max items-center">
          {[0, 1].map((copy) => (
            <ul class="flex shrink-0 items-center gap-16 pr-16 md:gap-24 md:pr-24" aria-hidden={copy === 1 ? 'true' : undefined}>
              {logos.map((l) => (
                <li class="shrink-0">
                  <img src={`/logos/${l.file}`} alt={copy === 0 ? l.name : ''} width="160" height="40" loading="lazy" decoding="async" class="h-8 w-auto opacity-60 md:h-9" />
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .logo-marquee {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
  }
  .logo-track {
    animation: marquee 32s linear infinite;
  }
  .logo-marquee:hover .logo-track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-track { animation: none; }
  }
  @keyframes marquee {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }
</style>
