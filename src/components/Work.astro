---
// Casos de estudio con preview real: cada caso muestra el sitio en vivo dentro
// de la tarjeta (LiveWindow) y se abre a tamaño completo en PreviewDialog.
// Datos en src/config/site.ts (caseStudies); lógica en work-preview.ts.
import LiveWindow from './work/LiveWindow.astro';
import PreviewDialog from './work/PreviewDialog.astro';
import { caseStudies, waLink, waSections } from '../config/site';

const wa = waSections.trabajo;
const domainOf = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
};

const steps = [
  { key: 'challenge', label: 'El reto' },
  { key: 'solution', label: 'Lo que construimos' },
  { key: 'impact', label: 'El resultado' },
] as const;
---

<section
  id="trabajo"
  class="relative isolate py-20 md:py-32"
  data-wa-label={wa.label}
  data-wa-message={wa.message}
>
  <!-- Fondo en claroscuro: Filósofo en Meditación (1632) bajo veladura ciruela -->
  <div class="art-bg pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <img src="/art/philosopher.webp" alt="" loading="lazy" decoding="async" draggable="false" />
  </div>

  <div class="mx-auto w-[min(1240px,calc(100%-2.5rem))]">
    <header class="mb-20 grid gap-6 md:grid-cols-[1.1fr_1fr] md:items-end max-md:mb-14">
      <div>
        <p class="text-xs font-medium tracking-[0.22em] text-mute uppercase">Casos de estudio</p>
        <h2 class="mt-4 text-[clamp(2.4rem,5vw,4.4rem)] leading-[1.02]">Sitios reales, en vivo.</h2>
      </div>
      <p class="max-w-[32rem] text-lg leading-relaxed text-mute max-sm:text-base">
        <span class="max-sm:hidden"
          >Nada de capturas: cada proyecto se muestra funcionando. Pasa el cursor para recorrerlo y
          haz clic para navegarlo como lo haría un cliente.</span
        >
        <span class="sm:hidden">Cada proyecto se muestra funcionando. Toca para navegarlo.</span>
      </p>
    </header>

    <ol class="grid gap-24 md:gap-32 max-sm:gap-20">
      {
        caseStudies.map((c, i) => {
          const liveUrl = c.liveUrl || c.url;
          const domain = liveUrl ? domainOf(liveUrl) : c.client;
          const copy = (key: (typeof steps)[number]['key']) => ({
            full: c[key],
            short: c.short?.[key],
          });

          return (
            <li>
              <article
                class="grid gap-10 lg:grid-cols-[1.3fr_1fr] lg:items-center lg:gap-16"
                aria-labelledby={`case-${c.id}`}
              >
                <div class:list={[i % 2 === 1 && 'lg:order-2']}>
                  {c.url && liveUrl ? (
                    <LiveWindow
                      url={c.url}
                      liveUrl={liveUrl}
                      client={c.client}
                      sector={c.sector}
                      domain={domain}
                      tint={c.tint}
                    />
                  ) : (
                    <div class="case-poster" style={`--t1:${c.tint[0]};--t2:${c.tint[1]}`}>
                      <span class="font-display text-[clamp(2rem,4.2vw,3.6rem)] leading-[0.98]">
                        {c.client}
                      </span>
                      <span class="mt-2 text-sm text-light/60">{c.sector}</span>
                    </div>
                  )}
                </div>

                <div class="flex flex-col">
                  <p class="text-xs font-medium tracking-[0.2em] text-gold uppercase">{c.sector}</p>
                  <h3
                    id={`case-${c.id}`}
                    class="mt-2 text-[clamp(1.9rem,3.2vw,2.8rem)] leading-[1.05] text-light"
                  >
                    {c.client}
                  </h3>

                  <dl class="mt-8 max-sm:mt-6">
                    {steps.map(({ key, label }, si) => {
                      const text = copy(key);
                      return (
                        <div class="case-step">
                          <dt class="case-step__label">
                            <span class="case-step__num">0{si + 1}</span>
                            {label}
                          </dt>
                          <dd class:list={['case-step__text', key === 'impact' && 'text-light']}>
                            {text.short ? (
                              <>
                                <span class="max-sm:hidden">{text.full}</span>
                                <span class="sm:hidden">{text.short}</span>
                              </>
                            ) : (
                              text.full
                            )}
                          </dd>
                        </div>
                      );
                    })}
                  </dl>

                  {c.metrics.length > 0 && (
                    <dl class="mt-8 grid grid-cols-2 gap-6" aria-label="Resultados">
                      {c.metrics.map((m) => (
                        <div class="case-metric">
                          <dt class="mt-2 text-xs tracking-[0.12em] text-mute uppercase">
                            {m.label}
                          </dt>
                          <dd class="font-display text-[clamp(2rem,3vw,2.6rem)] leading-none text-light">
                            {m.value}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  )}

                  <div class="mt-9 flex flex-wrap items-center gap-3 max-sm:flex-col max-sm:items-stretch">
                    {c.url ? (
                      <>
                        <button
                          type="button"
                          class="btn btn-light !px-5 !py-2.5 text-sm max-sm:justify-center"
                          data-preview={c.url}
                          data-preview-title={c.client}
                          data-preview-live={liveUrl}
                          data-magnetic="0.3"
                          data-cursor="EXPLORAR"
                        >
                          Explorar el sitio
                        </button>
                        <a
                          href={liveUrl}
                          target="_blank"
                          rel="noopener"
                          class="btn btn-ghost !px-5 !py-2.5 text-sm max-sm:justify-center"
                          data-magnetic="0.3"
                          data-cursor="VISITAR"
                        >
                          Visitar en vivo <span aria-hidden="true">↗</span>
                        </a>
                      </>
                    ) : (
                      <a
                        href={waLink(
                          `Hola, vi el caso de ${c.client} y quiero algo parecido para mi marca.`,
                        )}
                        target="_blank"
                        rel="noopener"
                        class="btn btn-ghost !px-5 !py-2.5 text-sm max-sm:justify-center"
                        data-magnetic="0.3"
                        data-cursor="WHATSAPP"
                      >
                        Quiero un proyecto similar
                      </a>
                    )}
                  </div>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>
  </div>

  <PreviewDialog />
</section>

<script>
  import { initWorkPreview } from '../scripts/work-preview';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWorkPreview, { once: true });
  } else {
    initWorkPreview();
  }
</script>

<style>
  .art-bg {
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 50%, #000 0%, transparent 100%);
    mask-image: radial-gradient(ellipse 60% 55% at 50% 50%, #000 0%, transparent 100%);
  }
  .art-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.16;
    filter: saturate(0.8) brightness(0.8);
  }
  .art-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-plum-ink);
    mix-blend-mode: multiply;
    opacity: 0.45;
  }

  .case-poster {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 16 / 10;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid rgb(244 239 230 / 0.08);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(
        60% 70% at 22% 20%,
        color-mix(in srgb, var(--t1) 28%, transparent),
        transparent 72%
      ),
      linear-gradient(160deg, var(--color-carbon-3), var(--color-carbon));
  }

  /* Ficha editorial: tres pasos numerados separados por filetes */
  .case-step {
    display: grid;
    gap: 0.4rem;
    padding: 1.1rem 0;
    border-top: 1px solid rgb(244 239 230 / 0.08);
  }
  .case-step:last-child {
    border-bottom: 1px solid rgb(244 239 230 / 0.08);
  }
  .case-step__label {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(244 239 230 / 0.55);
  }
  .case-step__num {
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0;
    color: var(--color-gold);
  }
  .case-step__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-mute);
  }

  /* dt va primero en el DOM (HTML válido); visualmente la cifra queda arriba */
  .case-metric {
    display: flex;
    flex-direction: column-reverse;
    padding-top: 0.9rem;
    border-top: 1px solid rgb(217 119 6 / 0.45);
  }
  .case-metric dd {
    margin: 0;
  }
</style>
