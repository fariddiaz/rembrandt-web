---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/#servicios`, label: 'Servicios' },
  { href: `${base}/#proceso`, label: 'Proceso' },
  { href: `${base}/#contacto`, label: 'Contacto' },
];
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-5">
    <a href={import.meta.env.BASE_URL} class="font-display text-xl font-semibold tracking-tight">Rembrandt</a>
    <nav aria-label="Principal">
      <ul class="flex flex-wrap items-center gap-6 text-sm">
        {
          links.map((link) => (
            <li>
              <a class="text-muted transition-colors hover:text-ink" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="rounded-md bg-ink px-4 py-2 text-paper transition-colors hover:bg-accent-strong"
            href={`${base}/#contacto`}
          >
            Hablemos
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
