---
import Logo from './Logo.astro';
import { waLink, waSections } from '../config/site';

const links = [
  { href: '#hero', label: 'Inicio' },
  { href: '#planes', label: 'Planes' },
  { href: '#trabajo', label: 'Portafolio' },
  { href: '#proceso', label: 'Proceso' },
  { href: '#contacto', label: 'Contacto' },
];
---
<header class="fixed inset-x-0 top-0 z-50">
  <nav
    class="glass mx-auto mt-4 flex w-[min(1240px,calc(100%-2rem))] items-center justify-between rounded-full py-2 pr-2.5 pl-4 sm:pl-6 border border-white/10 shadow-2xl backdrop-blur-xl"
    aria-label="Principal"
  >
    <!-- Logo Oficial de Marca: Isotipo R con degradado + Logotipo Rembrandt + Badge Studio -->
    <a href="#hero" class="flex items-center gap-2.5 sm:gap-3 group py-1" aria-label="Rembrandt Studio, inicio">
      <Logo variant="mark-color" class="h-7 sm:h-8 w-auto transition-transform duration-300 group-hover:scale-105" />
      <Logo variant="wordmark" class="h-4 sm:h-4.5 w-auto text-light transition-opacity duration-300 group-hover:opacity-90" />
      <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 text-[0.68rem] font-medium tracking-wider text-mute uppercase font-sans">Studio</span>
    </a>

    <!-- Menú Cápsula Centrado -->
    <ul class="hidden items-center gap-7 text-[0.92rem] text-mute md:flex">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="transition-colors hover:text-light"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA Universal de Cotización (dirige a la sección de contacto multicanal) -->
    <a
      href="#contacto"
      class="btn btn-light !py-2.5 !px-5 text-sm"
      data-magnetic="0.3"
    >
      Iniciar Proyecto
    </a>
  </nav>
</header>
