---
import { waLink, waSections } from '../config/site';
const links = [
  { href: '#planes', label: 'Planes' },
  { href: '#trabajo', label: 'Trabajo' },
  { href: '#proceso', label: 'Proceso' },
  { href: '#cuidado', label: 'Plan Cuidado' },
];
---
<header class="fixed inset-x-0 top-0 z-50">
  <nav
    class="glass mx-auto mt-4 flex w-[min(1180px,calc(100%-2rem))] items-center justify-between rounded-full py-2.5 pr-2.5 pl-5 md:pl-6"
    aria-label="Principal"
  >
    <a href="#hero" class="flex items-baseline gap-1.5" aria-label="Rembrandt Studio, inicio">
      <span class="font-display text-[1.35rem] leading-none">Rembrandt</span>
      <span class="text-mute text-sm">Studio</span>
    </a>
    <ul class="hidden items-center gap-8 text-[0.95rem] text-mute md:flex">
      {links.map((l) => (
        <li><a href={l.href} class="transition-colors hover:text-light">{l.label}</a></li>
      ))}
    </ul>
    <a
      href={waLink(waSections.contacto.message)}
      target="_blank"
      rel="noopener"
      class="btn btn-light !py-3 !px-5 text-sm"
      data-magnetic="0.3"
      data-cursor="WHATSAPP"
    >
      Cotizar<span class="hidden sm:inline">&nbsp;por WhatsApp</span>
    </a>
  </nav>
</header>
