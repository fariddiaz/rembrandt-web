---
interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'dark' } = Astro.props;
const isDark = theme === 'dark';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/#obras`, label: 'Obras' },
  { href: `${base}/#servicios`, label: 'Servicios' },
  { href: `${base}/#escalera`, label: 'Planes' },
  { href: `${base}/#proceso`, label: 'Proceso' },
];
---

<header
  class="border-b border-white/10 bg-[#0a0a0d]/90 text-white transition-colors sticky top-0 z-40 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-4">
    <a
      href={import.meta.env.BASE_URL}
      class="font-display text-xl font-bold tracking-tight transition-colors hover:text-accent flex items-center gap-2 group"
    >
      <span class="inline-block h-2 w-2 rounded-full bg-accent shadow-[0_0_8px_#8b5cf6]"></span>
      <span class="text-white group-hover:text-accent transition-colors">Rembrandt</span>
    </a>
    <nav aria-label="Principal">
      <ul class="flex flex-wrap items-center gap-4 sm:gap-6 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                class="text-white/70 transition-colors hover:text-white"
                href={link.href}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="rounded-full border border-accent/40 bg-accent/10 px-3 py-1 text-xs text-accent font-medium hover:bg-accent hover:text-white transition-all hidden sm:inline-block shadow-[0_0_12px_rgba(139,92,246,0.2)]"
            href={`${base}/express`}
          >
            Express 24–48h ⚡
          </a>
        </li>
        <li>
          <a
            class="group relative inline-flex flex-col items-center justify-center rounded-full bg-paper px-5 py-2 text-ink text-xs uppercase tracking-wider font-semibold transition-all hover:bg-accent hover:text-white shadow-sm overflow-hidden"
            href={`${base}/#contacto`}
          >
            <span>Iniciar Proyecto</span>
            <svg class="firma-stroke absolute bottom-0.5 h-1.5 w-16 pointer-events-none" viewBox="0 0 320 60" aria-hidden="true">
              <path pathLength="1" d="M10 42 C 38 12, 65 52, 98 28 S 145 18, 180 38 C 215 52, 235 18, 265 25 C 290 30, 302 44, 314 28" />
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
