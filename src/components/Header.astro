---
interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;
const isDark = theme === 'dark';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/#obras`, label: 'Obras' },
  { href: `${base}/#servicios`, label: 'Servicios' },
  { href: `${base}/#escalera`, label: 'Planes' },
  { href: `${base}/#proceso`, label: 'Proceso' },
];
---

<header
  class={isDark
    ? 'border-b border-white/10 bg-[#0a0a0d] text-white transition-colors sticky top-0 z-50 backdrop-blur-md bg-opacity-90'
    : 'border-b border-line bg-paper text-ink transition-colors sticky top-0 z-50 backdrop-blur-md bg-opacity-90'}
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-4">
    <a
      href={import.meta.env.BASE_URL}
      class="font-display text-xl font-bold tracking-tight transition-colors hover:text-accent flex items-center gap-2"
    >
      <span class="inline-block h-2 w-2 rounded-full bg-accent"></span>
      Rembrandt
    </a>
    <nav aria-label="Principal">
      <ul class="flex flex-wrap items-center gap-5 sm:gap-6 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                class={isDark
                  ? 'text-white/70 transition-colors hover:text-white'
                  : 'text-muted transition-colors hover:text-ink'}
                href={link.href}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="rounded-full border border-accent/40 bg-accent/10 px-3 py-1 text-xs text-accent font-medium hover:bg-accent hover:text-white transition-all hidden sm:inline-block"
            href={`${base}/#escalera`}
          >
            Express 7d &rarr;
          </a>
        </li>
        <li>
          <a
            class={isDark
              ? 'rounded-md bg-white px-4 py-2 text-ink text-xs uppercase tracking-wider font-semibold transition-all hover:bg-accent hover:text-white'
              : 'rounded-md bg-ink px-4 py-2 text-paper text-xs uppercase tracking-wider font-semibold transition-all hover:bg-accent'}
            href={`${base}/#contacto`}
          >
            Iniciar Proyecto
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
