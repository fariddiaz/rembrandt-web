---
import Logo from './Logo.astro';

interface Props {
  activePath?: string;
}

const currentPath = Astro.props.activePath ?? (Astro.url.pathname.replace(/\/$/, '') || '/');

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/planes', label: 'Planes' },
  { href: '/portafolio', label: 'Portafolio' },
  { href: '/proceso', label: 'Proceso' },
  { href: '/contacto', label: 'Contacto' },
];

const isLinkActive = (href: string) => {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href);
};
---
<header class="fixed inset-x-0 top-0 z-50">
  <nav
    class="glass mx-auto mt-4 flex w-[min(1240px,calc(100%-2rem))] items-center justify-between rounded-full py-2 pr-2.5 pl-4 sm:pl-6 border border-white/10 shadow-2xl backdrop-blur-xl"
    aria-label="Principal"
  >
    <!-- Logo Oficial de Marca: Isotipo R con degradado + Logotipo Rembrandt + Badge Studio -->
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 group py-1" aria-label="Rembrandt Studio, inicio">
      <Logo variant="mark-color" class="h-7 sm:h-8 w-auto transition-transform duration-300 group-hover:scale-105" />
      <Logo variant="wordmark" class="h-4 sm:h-4.5 w-auto text-light transition-opacity duration-300 group-hover:opacity-90" />
      <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 text-[0.68rem] font-medium tracking-wider text-mute uppercase font-sans">Studio</span>
    </a>

    <!-- Menú Centrado Multi-Página -->
    <ul class="hidden items-center gap-2 text-[0.92rem] md:flex">
      {links.map((l) => {
        const active = isLinkActive(l.href);
        return (
          <li>
            <a
              href={l.href}
              class:list={[
                'rounded-full px-4 py-1.5 transition-all duration-200',
                active
                  ? 'border border-white/15 bg-white/10 font-medium text-light shadow-sm'
                  : 'text-mute hover:text-light hover:bg-white/[0.04]',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- CTA Universal hacia la página de Contacto -->
    <div class="flex items-center gap-2">
      <a
        href="/contacto"
        class="btn btn-light !py-2.5 !px-5 text-sm hidden sm:inline-flex"
        data-magnetic="0.3"
      >
        Iniciar Proyecto
      </a>

      <!-- Botón móvil toggle con micro-interacción de autor -->
      <button
        type="button"
        class="md:hidden flex size-9 items-center justify-center rounded-full border border-white/10 bg-white/5 text-light hover:bg-white/10 active:scale-95 transition-all"
        aria-label="Abrir menú de navegación"
        id="mobile-menu-toggle"
      >
        <svg class="size-4 transition-transform duration-300" id="burger-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Menú desplegable móvil en Liquid Glass de Alta Fidelidad -->
  <div
    id="mobile-menu"
    class="glass mx-auto mt-2 hidden w-[min(1240px,calc(100%-1.75rem))] flex-col gap-1.5 rounded-2xl p-4 border border-white/15 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.9)] backdrop-blur-2xl md:hidden"
  >
    {links.map((l) => {
      const active = isLinkActive(l.href);
      return (
        <a
          href={l.href}
          class:list={[
            'group flex items-center justify-between rounded-xl px-4 py-3 text-sm transition-all',
            active
              ? 'border border-amber-400/30 bg-amber-400/10 font-semibold text-light shadow-sm'
              : 'text-mute hover:bg-white/5 hover:text-light',
          ]}
        >
          <span class="font-medium text-base text-light group-hover:text-amber-200 transition-colors">
            {l.label}
          </span>
          <span class="text-[0.7rem] uppercase tracking-wider text-mute font-mono">
            {l.href === '/' && '1633'}
            {l.href === '/planes' && '1653'}
            {l.href === '/portafolio' && '1669'}
            {l.href === '/proceso' && '1632'}
            {l.href === '/contacto' && '1667'}
          </span>
        </a>
      );
    })}

    <div class="mt-3 border-t border-white/10 pt-3 flex flex-col gap-2">
      <a
        href="/contacto"
        class="btn btn-light btn-float w-full justify-center text-center text-sm"
      >
        Iniciar Proyecto
      </a>
      <a
        href="https://wa.me/573147714202"
        target="_blank"
        rel="noopener"
        class="flex items-center justify-center gap-2 rounded-full border border-white/10 bg-white/5 py-2.5 text-xs font-medium text-mute hover:text-light transition-all"
      >
        <span class="size-1.5 rounded-full bg-emerald-400"></span>
        <span>WhatsApp Directo · +57 314 771 4202</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('burger-icon');

  if (toggle && menu && icon) {
    toggle.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        menu.classList.add('flex');
        icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />';
        toggle.setAttribute('aria-expanded', 'true');
      } else {
        menu.classList.add('hidden');
        menu.classList.remove('flex');
        icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />';
        toggle.setAttribute('aria-expanded', 'false');
      }
    });

    // Cerrar el menú si se hace click en un enlace
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        menu.classList.remove('flex');
        icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />';
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
