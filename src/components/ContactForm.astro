---
import { CONTACT_EMAIL } from '../config/site';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const graciasUrl = `${base}/gracias`;

const fieldClass =
  'w-full rounded-xl border border-white/10 bg-carbon-2/80 px-4 py-3 text-sm text-light placeholder:text-mute/40 focus:border-violet focus:outline-none focus:ring-1 focus:ring-violet/50 transition-colors';
const labelClass = 'mb-1.5 block text-xs font-semibold uppercase tracking-wider text-light/80';
---

<div class="relative">
  <form
    action="https://api.web3forms.com/submit"
    method="POST"
    data-contact-form
    data-success-url={graciasUrl}
    class="space-y-4"
  >
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="Nuevo proyecto web desde Rembrandt Studio" />
    <input type="hidden" name="from_name" value="Rembrandt Studio Web" />
    <input
      type="checkbox"
      name="botcheck"
      class="hidden"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class={labelClass} for="name">Tu Nombre *</label>
        <input
          class={fieldClass}
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          placeholder="Ej: David Smith / Carlos Gómez"
          required
        />
      </div>
      <div>
        <label class={labelClass} for="email">Tu Correo Electrónico *</label>
        <input
          class={fieldClass}
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="tu@empresa.com"
          required
        />
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class={labelClass} for="plan">Tipo de Proyecto</label>
        <select class={fieldClass} id="plan" name="plan">
          <option value="Landing Express ($249 USD / ~$990.000 COP)">Landing Express 3–5 días ($249 USD / ~$990.000 COP)</option>
          <option value="Web Multi-Sección ($399 USD / ~$1.590.000 COP)">Web Corporativa Multi-Sección ($399 USD / ~$1.590.000 COP)</option>
          <option value="Catálogo / Tienda Ágil ($590 USD / ~$2.390.000 COP)">Catálogo & Tienda Ágil ($590 USD / ~$2.390.000 COP)</option>
          <option value="Obra Signature / 3D Craft (A medida)">Proyecto a Medida & 3D Craft (A convenir)</option>
          <option value="Plan Cuidado ($19 USD/mes)">Mantenimiento / Plan Cuidado ($19 USD/mes)</option>
        </select>
      </div>
      <div>
        <label class={labelClass} for="budget">Presupuesto Estimado</label>
        <select class={fieldClass} id="budget" name="budget">
          <option value="Desde $249 USD / ~$1.0M COP">Desde $249 USD (~$1M COP)</option>
          <option value="$399 - $590 USD / ~$1.6M - $2.4M COP">$399 - $590 USD (~$1.6M - $2.4M COP)</option>
          <option value="$1,000 - $2,500+ USD">$1,000 - $2,500+ USD</option>
          <option value="Por definir">Prefiero evaluarlo en la propuesta</option>
        </select>
      </div>
    </div>

    <div>
      <label class={labelClass} for="message">Cuéntanos sobre tu idea o negocio *</label>
      <textarea
        class={fieldClass}
        id="message"
        name="message"
        rows="4"
        placeholder="¿A qué se dedica tu marca? ¿Tienes una web actual o empiezas desde cero? Cuéntanos cualquier detalle relevante..."
        required
      ></textarea>
    </div>

    <div class="flex items-start gap-2.5 pt-1">
      <input
        class="mt-1 size-4 rounded border-white/20 bg-carbon text-violet focus:ring-violet"
        id="consent"
        name="consent"
        type="checkbox"
        value="Acepto la política de privacidad"
        required
      />
      <label class="text-xs text-mute leading-relaxed" for="consent">
        Acepto que Rembrandt Studio me contacte para enviarme la propuesta.
        <a class="underline hover:text-light transition-colors" href={`${base}/privacidad`}>Política de privacidad</a>.
      </label>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 pt-3">
      <button
        class="btn btn-light !py-3 !px-7 text-sm font-semibold cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
        type="submit"
        data-magnetic="0.2"
      >
        <span>Enviar propuesta</span>
        <span aria-hidden="true">→</span>
      </button>

      <span class="text-xs text-mute flex items-center gap-1.5">
        <span class="size-1.5 rounded-full bg-emerald-400"></span>
        Respuesta garantizada en &lt; 2h
      </span>
    </div>

    <p data-form-status role="status" aria-live="polite" class="min-h-5 text-xs text-mute pt-1"></p>
  </form>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!status || !button) return;

      const accessKeyInput = form.querySelector<HTMLInputElement>('input[name="access_key"]');
      const hasKey = !!accessKeyInput?.value;

      button.disabled = true;
      const originalText = button.innerHTML;
      button.textContent = 'Enviando...';
      status.textContent = '';

      if (!hasKey) {
        // Modo fallback: si no hay key de Web3Forms configurada en producción,
        // crea el enlace mailto directo con los datos para no perder jamás un prospecto
        const formData = new FormData(form);
        const name = formData.get('name') || '';
        const email = formData.get('email') || '';
        const plan = formData.get('plan') || '';
        const message = formData.get('message') || '';
        
        const mailSubject = encodeURIComponent(`Nuevo proyecto web - ${name}`);
        const mailBody = encodeURIComponent(
          `Nombre: ${name}\nEmail: ${email}\nPlan de interés: ${plan}\n\nDetalles:\n${message}`
        );
        
        window.location.href = `mailto:contacto@rembrandtstudio.co?subject=${mailSubject}&body=${mailBody}`;
        status.textContent = 'Redirigiendo a tu cliente de correo...';
        button.disabled = false;
        button.innerHTML = originalText;
        return;
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await response.json();

        if (response.ok && result.success) {
          const successUrl = form.getAttribute('data-success-url') || '/gracias';
          window.location.assign(successUrl);
          return;
        }

        status.textContent = 'No se pudo enviar. Escríbenos directamente a contacto@rembrandtstudio.co';
      } catch {
        status.textContent = 'Error de conexión. Escríbenos directamente a contacto@rembrandtstudio.co';
      }

      button.disabled = false;
      button.innerHTML = originalText;
    });
  }
</script>
