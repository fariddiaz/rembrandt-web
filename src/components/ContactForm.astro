---
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const showKeyWarning = import.meta.env.DEV && !accessKey;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const graciasUrl = `${base}/gracias`;

const fieldClass =
  'w-full rounded-lg border border-white/10 bg-[#16161d] px-4 py-3 text-white placeholder:text-white/40 focus:border-accent focus:outline-none transition-colors';
const labelClass = 'mb-2 block text-xs font-semibold uppercase tracking-wider text-white/70';
---

<div>
  {
    showKeyWarning && (
      <p class="mb-4 rounded-md border border-accent/30 bg-accent/10 px-4 py-3 text-sm">
        Falta <code>PUBLIC_WEB3FORMS_KEY</code> en <code>.env</code>. El formulario no enviará
        mensajes hasta configurarla.
      </p>
    )
  }

  <form action="https://api.web3forms.com/submit" method="POST" data-contact-form data-success-url={graciasUrl} class="space-y-5">
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="Nuevo mensaje desde la web" />
    <input type="hidden" name="from_name" value="Web Rembrandt" />
    <input
      type="checkbox"
      name="botcheck"
      class="hidden"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label class={labelClass} for="name">Nombre</label>
        <input
          class={fieldClass}
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          placeholder="Tu nombre"
          required
        />
      </div>
      <div>
        <label class={labelClass} for="email">Email corporativo</label>
        <input
          class={fieldClass}
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="tu@empresa.com"
          required
        />
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label class={labelClass} for="company">Empresa / Proyecto</label>
        <input
          class={fieldClass}
          id="company"
          name="company"
          type="text"
          autocomplete="organization"
          placeholder="Nombre de tu empresa o marca"
        />
      </div>
      <div>
        <label class={labelClass} for="plan">Tipo de Proyecto</label>
        <select class={fieldClass} id="plan" name="plan">
          <option value="Landing Express ($249 USD / ~$990.000 COP)">Landing Express 3-5 días ($249 USD / ~$990.000 COP)</option>
          <option value="Web Multi-Sección ($399 USD / ~$1.590.000 COP)">Web Corporativa Multi-Sección ($399 USD / ~$1.590.000 COP)</option>
          <option value="Catálogo / Tienda Ágil ($590 USD / ~$2.390.000 COP)">Catálogo & Tienda Ágil ($590 USD / ~$2.390.000 COP)</option>
          <option value="Obra Signature / 3D Craft (A medida)">Obra Signature / 3D Craft (A medida)</option>
          <option value="Plan Cuidado ($19 USD/mes)">Mantenimiento / Plan Cuidado ($19 USD/mes)</option>
        </select>
      </div>
    </div>

    <div>
      <label class={labelClass} for="message">Mensaje</label>
      <textarea
        class={fieldClass}
        id="message"
        name="message"
        rows="5"
        placeholder="Cuéntanos qué necesitas"
        required></textarea>
    </div>

    <div class="flex items-start gap-3">
      <input
        class="mt-1 size-4 rounded border-line text-accent focus:ring-accent"
        id="consent"
        name="consent"
        type="checkbox"
        value="Acepto la política de privacidad"
        required
      />
      <label class="text-xs text-white/60" for="consent">
        He leído y acepto la
        <a class="underline hover:text-white" href={`${base}/privacidad`}>política de privacidad</a>.
      </label>
    </div>

    <div class="flex flex-wrap items-center gap-4 pt-2">
      <button
        class="inline-flex items-center justify-center rounded-lg bg-accent px-7 py-3.5 text-xs font-bold uppercase tracking-wider text-white transition-all hover:bg-accent-strong shadow-lg shadow-accent/25 disabled:cursor-not-allowed disabled:opacity-60"
        type="submit"
      >
        Enviar mensaje
      </button>

      <a
        href="https://wa.me/573147714202?text=Hola%20Rembrandt%20Studio%2C%20quiero%20cotizar%20un%20proyecto"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-6 py-3.5 text-xs font-semibold uppercase tracking-wider text-emerald-400 hover:bg-emerald-500/20 transition-all"
      >
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>WhatsApp directo</span>
      </a>
    </div>

    <p data-form-status role="status" aria-live="polite" class="min-h-6 text-sm text-white/70"></p>
  </form>
</div>

<script>
  const form = document.querySelector('[data-contact-form]');

  if (form instanceof HTMLFormElement) {
    const status = form.querySelector('[data-form-status]');
    const button = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!(status instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) {
        return;
      }

      button.disabled = true;
      button.textContent = 'Enviando...';
      status.textContent = '';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await response.json();

        if (response.ok && result.success) {
          const successUrl = form.getAttribute('data-success-url') || '/gracias';
          window.location.assign(successUrl);
          return;
        }

        status.textContent = 'No se pudo enviar. Inténtalo de nuevo o escríbenos por email.';
      } catch {
        status.textContent = 'No se pudo enviar. Revisa tu conexión e inténtalo de nuevo.';
      }

      button.disabled = false;
      button.textContent = 'Enviar mensaje';
    });
  }
</script>
