---
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || '644b5b46-ac1d-456b-ba02-eab88e67c3ae';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const graciasUrl = `${base}/gracias`;

const fieldClass =
  'w-full rounded-xl border border-white/10 bg-carbon-2/80 px-4 py-3 text-sm text-light max-sm:py-3.5 max-sm:text-base placeholder:text-mute/40 focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400/50 transition-colors';
const labelClass = 'mb-1.5 block text-xs font-semibold uppercase tracking-wider text-light/80';
---

<div class="relative">
  <form
    action="https://api.web3forms.com/submit"
    method="POST"
    data-contact-form
    data-success-url={graciasUrl}
    class="space-y-4"
  >
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="Nuevo proyecto web desde Rembrandt Studio" />
    <input type="hidden" name="from_name" value="Rembrandt Studio Web" />

    {/* Campo trampa Honeypot anti-spam */}
    <input
      type="checkbox"
      name="botcheck"
      class="hidden"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class={labelClass} for="name">Tu Nombre *</label>
        <input
          class={fieldClass}
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          placeholder="Ej: David Smith / Carlos Gómez"
          required
          minlength="2"
          maxlength="80"
        />
      </div>
      <div>
        <label class={labelClass} for="email">Tu Correo Electrónico *</label>
        <input
          class={fieldClass}
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="tu@empresa.com"
          required
        />
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class={labelClass} for="plan">Plan o Solución de Interés</label>
        <select class={fieldClass} id="plan" name="plan">
          <option value="express">Página Web Express (4–6 días · $249 USD / ~$990.000 COP)</option>
          <option value="empresarial"
            >Web Corporativa & Autoridad (8–12 días · $399 USD / ~$1.590.000 COP)</option
          >
          <option value="automatizacion" selected
            >Web + Auto WhatsApp 24/7 (12–15 días · $490 USD / ~$1.950.000 COP)</option
          >
          <option value="tienda-agil"
            >Catálogo & Tienda Ágil (15–20 días · $590 USD / ~$2.390.000 COP)</option
          >
          <option value="signature-3d">Obra Signature & 3D Craft (A medida · Desde $950 USD)</option
          >
          <option value="mantenimiento"
            >Paquetes de Mantenimiento Mensual (Desde $15 USD/mes)</option
          >
          <option value="a-demanda">Soporte Técnico a Demanda (Pago Único sin mensualidades)</option
          >
        </select>
      </div>
      <div>
        <label class={labelClass} for="budget">Presupuesto Estimado</label>
        <select class={fieldClass} id="budget" name="budget">
          <option value="$249 - $399 USD">$249 - $399 USD (~$1M - $1.6M COP)</option>
          <option value="$490 - $590 USD" selected>$490 - $590 USD (~$1.9M - $2.4M COP)</option>
          <option value="$950 - $2,500+ USD">$950 - $2,500+ USD</option>
          <option value="Por definir">Prefiero evaluarlo en la propuesta</option>
        </select>
      </div>
    </div>

    <div>
      <label class={labelClass} for="message">Cuéntanos sobre tu idea o negocio *</label>
      <textarea
        class={fieldClass}
        id="message"
        name="message"
        rows="4"
        placeholder="¿A qué se dedica tu marca? ¿Tienes una web actual o empiezas desde cero? Cuéntanos cualquier detalle relevante..."
        required
        minlength="10"
        maxlength="2000"></textarea>
    </div>

    <div class="flex items-start gap-2.5 pt-1">
      <input
        class="mt-1 size-4 rounded border-white/20 bg-carbon text-amber-400 focus:ring-amber-400 cursor-pointer"
        id="consent"
        name="consent"
        type="checkbox"
        value="Acepto la política de privacidad"
        required
      />
      <label class="text-xs text-mute leading-relaxed" for="consent">
        Acepto que Rembrandt Studio me contacte para enviarme la propuesta solicitada.
        <a
          class="underline hover:text-amber-200 transition-colors"
          href="/politica-de-privacidad"
          target="_blank"
        >
          Política de Privacidad
        </a>.
      </label>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 pt-3">
      <div class="flex flex-wrap items-center gap-3 max-sm:w-full">
        <button
          class="btn btn-light btn-float !py-3 !px-7 text-sm font-semibold max-sm:w-full max-sm:justify-center max-sm:!py-3.5 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
          type="submit"
          data-magnetic="0.2"
        >
          <span>Enviar solicitud por correo</span>
          <span aria-hidden="true">&rarr;</span>
        </button>

        <button
          type="button"
          data-wa-submit
          class="inline-flex items-center justify-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-5 py-3 text-sm font-semibold text-emerald-300 transition-all hover:border-emerald-500/50 hover:bg-emerald-500/20 max-sm:w-full cursor-pointer"
        >
          <svg class="size-4 shrink-0 fill-current" viewBox="0 0 24 24">
            <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"
            ></path>
          </svg>
          <span>O enviar directo a WhatsApp</span>
        </button>
      </div>

      <span class="text-xs text-mute flex items-center gap-1.5">
        <span class="size-1.5 rounded-full bg-emerald-400"></span>
        Respuesta garantizada en &lt; 2h
      </span>
    </div>

    <div
      data-form-status
      role="status"
      aria-live="polite"
      class="hidden rounded-xl border p-3.5 text-xs transition-all"
    >
    </div>
  </form>
</div>

<script>
  function initForm() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form) return;

    // Preseleccionar plan si viene por URL (ej: /contacto?plan=express)
    const urlParams = new URLSearchParams(window.location.search);
    const planParam = urlParams.get('plan');
    if (planParam) {
      const select = form.querySelector<HTMLSelectElement>('#plan');
      if (select) {
        const matchingOption = Array.from(select.options).find(
          (opt) => opt.value.toLowerCase() === planParam.toLowerCase(),
        );
        if (matchingOption) {
          select.value = matchingOption.value;
        }
      }
    }

    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const waButton = form.querySelector<HTMLButtonElement>('[data-wa-submit]');

    if (waButton) {
      waButton.addEventListener('click', () => {
        const name = (form.querySelector<HTMLInputElement>('#name')?.value || '').trim();
        const email = (form.querySelector<HTMLInputElement>('#email')?.value || '').trim();
        const planSelect = form.querySelector<HTMLSelectElement>('#plan');
        const planText = planSelect?.options[planSelect.selectedIndex]?.text || '';
        const budget = form.querySelector<HTMLSelectElement>('#budget')?.value || '';
        const message = (form.querySelector<HTMLTextAreaElement>('#message')?.value || '').trim();

        if (!name) {
          showStatus('Por favor ingresa al menos tu nombre antes de abrir WhatsApp.', true);
          form.querySelector<HTMLInputElement>('#name')?.focus();
          return;
        }

        let waText = 'Hola Rembrandt Studio, mi nombre es *' + name + '*';
        if (email) waText += ' (' + email + ')';
        if (planText) waText += '.\n\nMe interesa el plan: *' + planText + '*';
        if (budget) waText += '\nPresupuesto estimado: *' + budget + '*';
        if (message) waText += '\n\nDetalles del proyecto:\n' + message;

        window.open('https://wa.me/573147714202?text=' + encodeURIComponent(waText), '_blank');
      });
    }
    let lastSubmitTime = 0;

    const showStatus = (message: string, isError: boolean) => {
      if (!status) return;
      status.classList.remove(
        'hidden',
        'border-rose-500/20',
        'bg-rose-500/10',
        'text-rose-300',
        'border-emerald-500/20',
        'bg-emerald-500/10',
        'text-emerald-300',
      );
      if (isError) {
        status.classList.add('border-rose-500/20', 'bg-rose-500/10', 'text-rose-300');
      } else {
        status.classList.add('border-emerald-500/20', 'bg-emerald-500/10', 'text-emerald-300');
      }
      status.textContent = message;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!status || !button) return;

      // Prevención de envíos repetidos accidentales (Throttling de 4 segundos)
      const now = Date.now();
      if (now - lastSubmitTime < 4000) {
        showStatus('Por favor espera unos segundos antes de enviar nuevamente.', true);
        return;
      }
      lastSubmitTime = now;

      // Validación de email en cliente
      const emailInput = form.querySelector<HTMLInputElement>('#email');
      const email = emailInput?.value.trim() ?? '';
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        showStatus('Por favor ingresa un correo electrónico válido.', true);
        emailInput?.focus();
        return;
      }

      const accessKeyInput = form.querySelector<HTMLInputElement>('input[name="access_key"]');
      const hasKey = !!accessKeyInput?.value;

      button.disabled = true;
      const originalText = button.innerHTML;
      button.innerHTML = '<span>Enviando propuesta...</span>';
      status.classList.add('hidden');

      if (!hasKey) {
        // Fallback seguro si la clave Web3Forms no está configurada en desarrollo local:
        // canaliza a mailto para garantizar cero pérdida de prospectos
        const formData = new FormData(form);
        const name = formData.get('name') || '';
        const plan = formData.get('plan') || '';
        const message = formData.get('message') || '';

        const mailSubject = encodeURIComponent(`Nuevo proyecto web - ${name}`);
        const mailBody = encodeURIComponent(
          `Nombre: ${name}\nEmail: ${email}\nPlan seleccionado: ${plan}\n\nDetalles del proyecto:\n${message}`,
        );

        window.location.href = `mailto:hola@rembrandtstudio.co?subject=${mailSubject}&body=${mailBody}`;
        showStatus('Redirigiendo a tu cliente de correo corporativo...', false);
        button.disabled = false;
        button.innerHTML = originalText;
        return;
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await response.json();

        if (response.ok && result.success) {
          const successUrl = form.getAttribute('data-success-url') || '/gracias';
          window.location.assign(successUrl);
          return;
        }

        showStatus(
          result.message ||
            'No se pudo enviar. Puedes escribirnos directamente a hola@rembrandtstudio.co o al WhatsApp oficial.',
          true,
        );
      } catch {
        showStatus(
          'Error de conexión. Escríbenos directamente a hola@rembrandtstudio.co o al WhatsApp +57 314 771 4202.',
          true,
        );
      }

      button.disabled = false;
      button.innerHTML = originalText;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initForm);
  } else {
    initForm();
  }
</script>
