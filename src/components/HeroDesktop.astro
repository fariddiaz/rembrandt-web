---
// Capa visual del hero en PC (>= 768px): robot 3D de Spline, cuadro de lienzo
// y guía "Desliza". El cuadro es un passe-partout fino: filete ámbar casi
// transparente con cuatro esquinas de visor, inset respecto al viewport para
// que nunca coincida con el borde de la pantalla (eso lo hacía parecer una caja).
// La coreografía vive en src/scripts/hero-cinematic.ts; el copy (h1, CTAs)
// es compartido y está en Hero.astro. En móvil esta capa no se renderiza
// (display: none): en móvil el hero es solo tipográfico.
import HeroRobot from './HeroRobot.astro';
---

<div class="hero-desktop pointer-events-none absolute inset-0 hidden md:block" aria-hidden="true">
  <!-- Robot: a la derecha, en su propia capa de profundidad -->
  <div
    class="hero-robot-layer pointer-events-none lg:pointer-events-auto absolute inset-y-0 right-[-4%] left-[42%]"
    data-hero-robot-layer
  >
    <HeroRobot />
  </div>

  <!-- Cuadro de lienzo: aparece con la tensión de scroll y se retira antes de la salida -->
  <span class="hero-frame" data-hero-frame>
    <span class="hero-frame__corner hero-frame__corner--tl"></span>
    <span class="hero-frame__corner hero-frame__corner--tr"></span>
    <span class="hero-frame__corner hero-frame__corner--bl"></span>
    <span class="hero-frame__corner hero-frame__corner--br"></span>
  </span>

  <!-- Guía de scroll: línea que se llena, sin flechas que rebotan -->
  <div class="hero-cue" data-hero-cue>
    <span class="hero-cue__label">Desliza</span>
    <span class="hero-cue__track"><span class="hero-cue__fill"></span></span>
  </div>
</div>

<style>
  /* Sin esto la capa aplanaría el z/rotateY del robot en el plano del lienzo */
  .hero-desktop,
  .hero-robot-layer {
    transform-style: preserve-3d;
  }
  .hero-robot-layer {
    will-change: transform;
  }

  /* Passe-partout: filete de 1px muy tenue + esquinas de visor más presentes */
  .hero-frame {
    position: absolute;
    inset: clamp(5.5rem, 11vh, 7.5rem) clamp(1.5rem, 4vw, 4rem) clamp(1.5rem, 5vh, 3rem);
    border: 1px solid rgb(217 119 6 / 0.14);
    opacity: 0;
    will-change: opacity;
  }
  .hero-frame__corner {
    position: absolute;
    width: 1.75rem;
    height: 1.75rem;
    border-color: rgb(217 119 6 / 0.7);
    border-style: solid;
    border-width: 0;
  }
  .hero-frame__corner--tl {
    top: -1px;
    left: -1px;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .hero-frame__corner--tr {
    top: -1px;
    right: -1px;
    border-top-width: 1px;
    border-right-width: 1px;
  }
  .hero-frame__corner--bl {
    bottom: -1px;
    left: -1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }
  .hero-frame__corner--br {
    bottom: -1px;
    right: -1px;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }

  .hero-cue {
    position: absolute;
    left: 50%;
    bottom: 2.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    translate: -50% 0;
  }
  .hero-cue__label {
    font-size: 0.62rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgb(244 239 230 / 0.5);
  }
  .hero-cue__track {
    position: relative;
    width: 1px;
    height: 3.25rem;
    overflow: hidden;
    background: rgb(244 239 230 / 0.12);
  }
  .hero-cue__fill {
    position: absolute;
    inset: 0;
    background: var(--color-gold);
    animation: cue-fill 2.8s var(--ease-oil) infinite;
  }
  @keyframes cue-fill {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    50.01% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cue__fill {
      animation: none;
      transform: scaleY(1);
    }
  }
</style>
