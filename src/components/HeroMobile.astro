---
// Capa visual del hero en móvil (< 768px): sustituye al robot de Spline.
// Un "lienzo de bolsillo" con tres planos de profundidad (fragmento de óleo,
// boceto dorado del robot, marco) que reaccionan a la inclinación del
// teléfono o, sin giroscopio, al arrastre del dedo. Cero WebGL, cero JS de
// terceros: el óleo es una variante AVIF ya usada por el sitio.
// Lógica en src/scripts/hero-mobile.ts.
import { artVariant } from '../config/art';

const PAINTING = '/art/nightwatch.jpg';
---

<figure class="hero-mobile mt-10 md:hidden" data-hero-mobile>
  <div class="hm-card" data-hm-card>
    <picture class="hm-layer hm-layer--paint">
      <source srcset={artVariant(PAINTING, 'avif')} type="image/avif" />
      <source srcset={artVariant(PAINTING, 'webp')} type="image/webp" />
      <img src={PAINTING} alt="" loading="lazy" decoding="async" draggable="false" />
    </picture>

    <span class="hm-light" aria-hidden="true"></span>

    <svg class="hm-layer hm-robot" viewBox="0 0 240 300" fill="none" aria-hidden="true">
      <ellipse cx="120" cy="80" rx="44" ry="52"></ellipse>
      <path d="M86 74c22-12 46-12 68 0"></path>
      <path d="M108 131v13M132 131v13"></path>
      <path d="M58 182c0-24 28-38 62-38s62 14 62 38v68c0 18-28 30-62 30s-62-12-62-30z"></path>
      <path d="M120 152v42"></path>
      <path d="M58 188c-18 8-28 30-30 62M182 188c18 8 28 30 30 62"></path>
    </svg>

    <span class="hm-frame" aria-hidden="true"></span>
  </div>

  <figcaption class="hm-caption">
    <span>Robot de autor sobre La Ronda de Noche, 1642</span>
    <button type="button" class="hm-motion hidden" data-hm-permission>Activar movimiento</button>
  </figcaption>
</figure>

<script>
  import { initHeroMobile } from '../scripts/hero-mobile';
  initHeroMobile();
</script>

<style>
  .hero-mobile {
    margin-inline: 0;
  }

  .hm-card {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-carbon-2);
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.6s var(--ease-cine);
    touch-action: pan-y;
  }
  .hm-card.is-live {
    transition: none;
  }

  /* Cada plano se desplaza según su profundidad (--d) y la inclinación (--px/--py) */
  .hm-layer {
    position: absolute;
    inset: -8%;
    transform: translate3d(
      calc(var(--px, 0) * var(--d, 0) * 1px),
      calc(var(--py, 0) * var(--d, 0) * 1px),
      0
    );
  }
  .hm-layer--paint {
    --d: -10;
  }
  .hm-layer--paint img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 45%;
    filter: saturate(0.85) brightness(0.55);
  }

  /* Veladura ciruela + foco ámbar: el claroscuro de la composición */
  .hm-light {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 62% 30%, rgb(217 119 6 / 0.22), transparent 70%),
      linear-gradient(180deg, rgb(46 16 101 / 0.35) 0%, rgb(7 6 9 / 0.85) 100%);
  }

  .hm-robot {
    --d: 14;
    inset: 12% 14% 4%;
    stroke: rgb(244 239 230 / 0.82);
    stroke-width: 1;
    stroke-linecap: round;
  }
  .hm-robot :is(ellipse, path) {
    stroke-dasharray: 340;
    stroke-dashoffset: 340;
  }
  .hero-mobile.is-visible .hm-robot :is(ellipse, path) {
    animation: hm-draw 2.4s var(--ease-oil) forwards;
  }
  .hero-mobile.is-visible .hm-robot path:nth-of-type(2) {
    animation-delay: 0.2s;
  }
  .hero-mobile.is-visible .hm-robot path:nth-of-type(4) {
    animation-delay: 0.35s;
  }
  .hero-mobile.is-visible .hm-robot path:nth-of-type(n + 5) {
    animation-delay: 0.5s;
  }

  .hm-frame {
    --d: 6;
    position: absolute;
    inset: 0.6rem;
    border: 1px solid rgb(217 119 6 / 0.5);
    border-radius: var(--radius-sm);
    transform: translate3d(
      calc(var(--px, 0) * var(--d) * 1px),
      calc(var(--py, 0) * var(--d) * 1px),
      0
    );
  }

  .hm-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.8rem;
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(244 239 230 / 0.5);
  }
  .hm-motion {
    flex-shrink: 0;
    min-height: 44px;
    padding-inline: 0.25rem;
    color: var(--color-gold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  @keyframes hm-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hm-card,
    .hm-layer,
    .hm-frame {
      transform: none !important;
    }
    .hm-robot :is(ellipse, path) {
      stroke-dashoffset: 0;
      animation: none !important;
    }
  }
</style>
