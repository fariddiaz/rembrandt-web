---
import { carePlan, plans, waLink, waSections } from '../config/site';

const wa = waSections.planes;
---
<section
  id="planes"
  class="relative py-20 md:py-32"
  data-wa-label={wa.label}
  data-wa-message={wa.message}
>
  <div class="mx-auto w-[min(1240px,calc(100%-2.5rem))]">
    
    <!-- Encabezado de la Sección -->
    <div class="mb-16 grid gap-6 md:grid-cols-[1.2fr_1fr] md:items-end">
      <div>
        <p class="text-xs uppercase tracking-[0.22em] text-mute font-medium">
          Inversión & Retorno
        </p>
        <h2 class="mt-4 text-[clamp(2.4rem,5vw,4.4rem)] leading-[1.02]">
          Planes claros, precios cerrados.
        </h2>
      </div>
      <p class="max-w-[32rem] text-lg leading-relaxed text-mute">
        Sin sorpresas ni cobros ocultos. Elige el plan que mejor se adapte a tu etapa actual y escríbenos por WhatsApp o mediante nuestro formulario para coordinar los detalles.
      </p>
    </div>

    <!-- Lista de Tarjetas que se apilan dinámicamente al hacer scroll (Stack Effect) -->
    <ol class="stack" aria-label="Planes disponibles">
      {plans.map((plan, i) => (
        <li class="stack-card" style={`--i:${i}`}>
          <article
            class:list={[
              'glass grid gap-10 rounded-[2rem] p-7 md:grid-cols-[1.1fr_1fr] md:p-12',
              plan.featured && 'is-featured',
            ]}
            aria-labelledby={`plan-${plan.id}`}
          >
            <div class="flex flex-col">
              {plan.featured && (
                <div class="mb-4">
                  <span class="rounded-md border border-white/20 bg-white/10 px-3 py-0.5 text-xs font-medium text-light backdrop-blur-md">
                    Más elegido por empresas
                  </span>
                </div>
              )}

              <h3 id={`plan-${plan.id}`} class="text-[clamp(1.9rem,3.6vw,3rem)] leading-[1.02] text-light">
                {plan.name}
              </h3>
              
              <p class="mt-3 text-xs tracking-wider uppercase text-violet-300/90 font-medium">
                {plan.badge}
              </p>
              
              <p class="mt-5 max-w-[30rem] text-base md:text-lg leading-relaxed text-mute">
                {plan.audience}
              </p>
              
              <p class="mt-auto flex items-center gap-2 pt-8 text-xs md:text-sm text-light/80">
                <span class="size-2 rounded-full bg-emerald-400" aria-hidden="true" />
                {plan.delivery}
              </p>
            </div>

            <div class="flex flex-col justify-between">
              <div>
                <p class="font-display text-[clamp(2.4rem,4.2vw,3.8rem)] leading-none text-light whitespace-nowrap">
                  {plan.priceUsd}
                </p>
                {plan.priceCop && (
                  <p class="mt-2 text-sm text-mute">{plan.priceCop}</p>
                )}
                
                <ul class="mt-8 space-y-3.5 border-t border-white/10 pt-8 text-sm md:text-base text-light/90">
                  {plan.features.map((f) => (
                    <li class="flex gap-3 leading-snug">
                      <span class="mt-[0.5em] size-1.5 shrink-0 rounded-full bg-violet-400" aria-hidden="true" />
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-10 flex flex-wrap items-center gap-4">
                <a
                  href={waLink(plan.message)}
                  target="_blank"
                  rel="noopener"
                  class:list={[
                    'btn !py-3.5 !px-8 text-sm md:text-base',
                    plan.featured ? 'btn-light' : 'btn-ghost',
                  ]}
                  data-magnetic="0.3"
                >
                  {plan.cta}
                </a>
                <a
                  href="/contacto"
                  class="text-xs text-mute hover:text-light transition-colors underline underline-offset-4"
                >
                  O cotizar por formulario →
                </a>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ol>

    <!-- Plan Cuidado: Resumen destacado para después del lanzamiento -->
    <aside
      class="glass mt-14 flex flex-col gap-6 rounded-[2rem] p-7 md:flex-row md:items-center md:justify-between md:p-10 border border-violet/20"
      aria-label={carePlan.name}
    >
      <div class="max-w-2xl">
        <p class="text-xs uppercase tracking-[0.2em] text-mute font-medium">
          Servicio Opcional Post-Lanzamiento
        </p>
        <h3 class="mt-2 text-[clamp(1.5rem,2.4vw,2rem)] leading-tight text-light">
          {carePlan.name} · <span class="text-mute font-sans text-lg">{carePlan.subtitle}</span>
        </h3>
        <p class="mt-2 text-sm text-mute">
          Hosting premium, certificado SSL, copias de seguridad continuas y soporte directo por WhatsApp para cambios de fotos y textos cada mes. Tu web siempre al 100%.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-6">
        <div>
          <p class="font-display text-4xl leading-none text-light whitespace-nowrap">
            {carePlan.priceUsd}<span class="font-sans text-base text-mute">{carePlan.unit}</span>
          </p>
          <p class="text-xs text-mute mt-1">Sin contratos forzados</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/planes"
            class="btn btn-ghost !py-3 !px-6"
            data-magnetic="0.3"
          >
            Ver Paquetes de Mantenimiento
          </a>
          <a
            href="/contacto"
            class="text-xs text-mute hover:text-light transition-colors underline underline-offset-4"
          >
            Formulario
          </a>
        </div>
      </div>
    </aside>

  </div>
</section>

<style>
  .stack {
    display: grid;
    gap: 8vh;
    padding-bottom: 8vh;
  }
  .is-featured {
    box-shadow:
      inset 0 1px 0 rgb(252 251 254 / 0.08),
      0 0 0 1px rgb(139 92 246 / 0.4),
      0 50px 120px -40px rgb(124 58 237 / 0.7);
  }
</style>
