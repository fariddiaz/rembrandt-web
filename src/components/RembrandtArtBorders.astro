---
// Marco artístico lateral: pinturas de Rembrandt en los bordes del viewport.
// Puramente decorativo: fijo, sin eventos de puntero y bajo el contenido (main es z-[2], footer es z-[10]).
// Cada página cuenta con sus propias obras maestras exclusivas:
// 0: Inicio -> Tormenta en el Mar de Galilea · 1633 / La Ronda de Noche · 1642
// 1: Planes -> Aristóteles con el busto de Homero · 1653 / El Molino · 1645
// 2: Portafolio -> El Retorno del Hijo Pródigo · 1669 / Lección de Anatomía · 1632
// 3: Proceso -> Filósofo en Meditación · 1632 / El Sacrificio de Isaac · 1635
// 4: Contacto -> La Novia Judía · 1667 / Autorretrato con dos círculos · 1665

interface Artwork {
  src: string;
  caption: string;
}

const left: Artwork[] = [
  { src: '/art/storm.jpg', caption: 'Tormenta en el Mar de Galilea · 1633' },
  { src: '/art/aristotle.jpg', caption: 'Aristóteles con el busto de Homero · 1653' },
  { src: '/art/prodigalson.jpg', caption: 'El Retorno del Hijo Pródigo · 1669' },
  { src: '/art/philosopher.jpg', caption: 'Filósofo en Meditación · 1632' },
  { src: '/art/jewishbride.jpg', caption: 'La Novia Judía · 1667' },
];

const right: Artwork[] = [
  { src: '/art/nightwatch.jpg', caption: 'La Ronda de Noche · 1642' },
  { src: '/art/mill.jpg', caption: 'El Molino · 1645' },
  { src: '/art/anatomy.jpg', caption: 'Lección de Anatomía · 1632' },
  { src: '/art/isaac.jpg', caption: 'El Sacrificio de Isaac · 1635' },
  { src: '/art/selfportrait.jpg', caption: 'Autorretrato con dos círculos · 1665' },
];

const sides = [
  { side: 'left', works: left },
  { side: 'right', works: right },
] as const;

// Detección en tiempo de compilación / render SSR para evitar cualquier parpadeo
const pathname = Astro.url.pathname.toLowerCase().replace(/\/$/, '') || '/';
let initialIndex = 0;
if (pathname.startsWith('/planes')) {
  initialIndex = 1;
} else if (pathname.startsWith('/portafolio')) {
  initialIndex = 2;
} else if (pathname.startsWith('/proceso')) {
  initialIndex = 3;
} else if (pathname.startsWith('/contacto')) {
  initialIndex = 4;
}
---
<div class="art-frame pointer-events-none fixed inset-0 z-0 hidden select-none xl:block" aria-hidden="true" data-art-borders>
  {sides.map(({ side, works }) => (
    <div class={`art-border art-border--${side}`}>
      <div class="art-parallax" data-art-parallax>
        {works.map((w, i) => (
          <img
            src={w.src}
            alt=""
            loading={i === initialIndex ? 'eager' : 'lazy'}
            decoding="async"
            draggable="false"
            class:list={['art-img', i === initialIndex && 'is-active']}
            data-art-state={i}
          />
        ))}
      </div>
    </div>
  ))}
</div>

<!-- Rótulos verticales de autor: capa independiente a z-30 para nitidez permanente en todas las páginas -->
<div class="art-captions-layer pointer-events-none fixed inset-0 z-30 hidden select-none xl:block" aria-hidden="true" data-art-captions>
  {sides.map(({ side, works }) => (
    <div class={`art-caption-col art-caption-col--${side}`}>
      {works.map((w, i) => (
        <span
          class:list={['art-caption', `art-caption--${side}`, i === initialIndex && 'is-active']}
          data-art-state={i}
        >
          {w.caption}
        </span>
      ))}
    </div>
  ))}
</div>

<script>
  function initArtBorders() {
    const root = document.querySelector<HTMLElement>('[data-art-borders]');
    const captionsRoot = document.querySelector<HTMLElement>('[data-art-captions]');
    if (!root && !captionsRoot) return;

    const layers = root?.querySelectorAll<HTMLElement>('[data-art-parallax]') ?? [];
    const items = document.querySelectorAll<HTMLElement>('[data-art-state]');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Detección estricta y limpia según la página actual
    const path = window.location.pathname.toLowerCase().replace(/\/$/, '') || '/';
    let targetState = 0;
    if (path.includes('/planes')) {
      targetState = 1;
    } else if (path.includes('/portafolio')) {
      targetState = 2;
    } else if (path.includes('/proceso')) {
      targetState = 3;
    } else if (path.includes('/contacto')) {
      targetState = 4;
    }

    // Activar exactamente las obras de la ventana correspondiente
    items.forEach((el) => {
      el.classList.toggle('is-active', Number(el.dataset.artState) === targetState);
    });

    let raf = 0;

    const update = () => {
      raf = 0;

      // Ocultar rótulos cuando el footer entra al área inferior, pero únicamente si el usuario ha hecho scroll
      // Esto evita que páginas con poco contenido (como portafolio en pantallas altas) oculten sus rótulos de entrada
      const footer = document.querySelector('footer');
      if (footer && captionsRoot) {
        const fRect = footer.getBoundingClientRect();
        const hasScrolledDown = window.scrollY > 150;
        const footerOverlapsBottom = fRect.top < (window.innerHeight - 80);
        const shouldFade = hasScrolledDown && footerOverlapsBottom;
        captionsRoot.classList.toggle('at-footer', shouldFade);
      }

      if (!reduceMotion && root) {
        const max = document.documentElement.scrollHeight - window.innerHeight || 1;
        const shift = (window.scrollY / max - 0.5) * -8;
        layers.forEach((l) => (l.style.transform = `translate3d(0, ${shift.toFixed(2)}%, 0)`));
      }
    };

    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArtBorders);
  } else {
    initArtBorders();
  }
</script>

<style>
  .art-border {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(220px, 20vw, 380px);
    overflow: hidden;
    pointer-events: none;
  }
  .art-border--left {
    left: 0;
  }
  .art-border--right {
    right: 0;
  }

  /* Capa con margen extra arriba/abajo para que el parallax nunca muestre bordes */
  .art-parallax {
    position: absolute;
    inset: -6% 0;
    /* La máscara aísla la capa: el modo screen se aplica al grupo completo contra el carbón */
    mix-blend-mode: screen;
    will-change: transform;
  }

  .art-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(140%) brightness(80%);
    opacity: 0;
    transition: opacity 1.2s var(--ease-cine);
  }
  .art-img.is-active {
    opacity: 0.16;
  }

  /* Viñeta: se disuelve hacia el centro y también arriba/abajo, fundiéndose en el carbón */
  .art-border--left .art-parallax {
    -webkit-mask-image:
      linear-gradient(to right, #000 0%, transparent 80%),
      linear-gradient(to bottom, transparent 0%, #000 18%, #000 72%, transparent 92%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, #000 0%, transparent 80%),
      linear-gradient(to bottom, transparent 0%, #000 18%, #000 72%, transparent 92%);
    mask-composite: intersect;
  }
  .art-border--right .art-parallax {
    -webkit-mask-image:
      linear-gradient(to left, #000 0%, transparent 80%),
      linear-gradient(to bottom, transparent 0%, #000 18%, #000 72%, transparent 92%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to left, #000 0%, transparent 80%),
      linear-gradient(to bottom, transparent 0%, #000 18%, #000 72%, transparent 92%);
    mask-composite: intersect;
  }

  /* Tinte ámbar/dorado de claroscuro sutil sobre el duotono */
  .art-parallax::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #d4af37;
    mix-blend-mode: color;
    opacity: 0.05;
  }

  /* Columnas de rótulos verticales en los márgenes extremos */
  .art-caption-col {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3.5rem;
    pointer-events: none;
  }
  .art-caption-col--left {
    left: 0;
  }
  .art-caption-col--right {
    right: 0;
  }

  /* Textos verticales de autor originales: impecables, permanentes y elegantes */
  .art-caption {
    position: absolute;
    bottom: 3.5rem;
    writing-mode: vertical-rl;
    font-size: 0.65rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-family: var(--font-sans);
    font-weight: 500;
    color: rgba(247, 237, 219, 0.65);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95);
    opacity: 0;
    white-space: nowrap;
    transition: opacity 0.6s var(--ease-cine);
    pointer-events: none;
  }
  .art-caption.is-active {
    opacity: 1;
  }
  .art-caption--left {
    left: 1.15rem;
    transform: rotate(180deg);
  }
  .art-caption--right {
    right: 1.15rem;
  }

  /* Al llegar al footer tras haber scrolleado, los textos se desvanecen con máxima pulcritud */
  :global([data-art-captions].at-footer) .art-caption {
    opacity: 0 !important;
    transition: opacity 0.35s ease;
  }
</style>
