---
// Marco artístico lateral: pinturas de Rembrandt en los bordes del viewport.
// Puramente decorativo: fijo, sin eventos de puntero y bajo el contenido (main es z-[2]).
---
<div class="pointer-events-none fixed inset-0 z-0 hidden select-none xl:block" aria-hidden="true">
  <div class="art-border art-border--left">
    <img src="/art/storm.jpg" alt="" loading="lazy" decoding="async" draggable="false" />
    <span class="art-caption art-caption--left">Rembrandt · 1633</span>
  </div>
  <div class="art-border art-border--right">
    <img src="/art/nightwatch.jpg" alt="" loading="lazy" decoding="async" draggable="false" />
    <span class="art-caption art-caption--right">De Nachtwacht · 1642</span>
  </div>
</div>

<style>
  .art-border {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(220px, 20vw, 380px);
    pointer-events: none;
  }
  .art-border--left {
    left: 0;
  }
  .art-border--right {
    right: 0;
  }

  .art-border img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(140%) brightness(80%);
    mix-blend-mode: screen;
    opacity: 0.16;
  }
  .art-border--left img {
    -webkit-mask-image: linear-gradient(to right, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0) 80%);
    mask-image: linear-gradient(to right, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0) 80%);
  }
  .art-border--right img {
    -webkit-mask-image: linear-gradient(to left, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0) 80%);
    mask-image: linear-gradient(to left, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0) 80%);
  }

  /* Tinte violeta sutil sobre el duotono, con la misma viñeta */
  .art-border::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-violet);
    mix-blend-mode: color;
    opacity: 0.08;
  }
  .art-border--left::after {
    -webkit-mask-image: linear-gradient(to right, #000 0%, transparent 80%);
    mask-image: linear-gradient(to right, #000 0%, transparent 80%);
  }
  .art-border--right::after {
    -webkit-mask-image: linear-gradient(to left, #000 0%, transparent 80%);
    mask-image: linear-gradient(to left, #000 0%, transparent 80%);
  }

  .art-caption {
    position: absolute;
    bottom: 2.5rem;
    writing-mode: vertical-rl;
    font-size: 0.62rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-light);
    opacity: 0.18;
    white-space: nowrap;
  }
  .art-caption--left {
    left: 1.1rem;
    transform: rotate(180deg);
  }
  .art-caption--right {
    right: 1.1rem;
  }
</style>
