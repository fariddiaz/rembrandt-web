---
// Claroscuro dinámico: obras de Rembrandt en los márgenes del viewport.
// Decorativo (aria-hidden), fijo y bajo el contenido (main z-[2], footer z-[10]).
// PC (>= 1280px): 4 obras por lado que se relevan con el scroll; cada relevo
//   "enciende" el cuadro como una lámpara de taller y un barrido de luz ámbar
//   lo recorre. Las capas siguen al puntero con paralaje sutil.
// Móvil y tablet: telón de 4 obras a pantalla completa bajo el contenido.
// Lógica en src/scripts/art-borders.ts; catálogo en src/config/art.ts.
import { artForPath, artVariant, type Artwork } from '../config/art';

const currentArt = artForPath(Astro.url.pathname);

const sides = [
  { side: 'left', works: currentArt.left },
  { side: 'right', works: currentArt.right },
] as const;

// Móvil: alterna lados para mezclar retratos y escenas en el mismo telón.
const mobileWorks: Artwork[] = [
  currentArt.left[0],
  currentArt.right[0],
  currentArt.left[2],
  currentArt.right[2],
];
---

<div
  class="art-frame pointer-events-none fixed inset-0 z-0 hidden select-none xl:block"
  aria-hidden="true"
  data-art-borders
>
  {
    sides.map(({ side, works }) => (
      <div class={`art-border art-border--${side}`}>
        <div class="art-parallax" data-art-parallax={side}>
          {works.map((w, i) => (
            <picture>
              <source srcset={artVariant(w.src, 'avif')} type="image/avif" />
              <source srcset={artVariant(w.src, 'webp')} type="image/webp" />
              <img
                src={w.src}
                alt=""
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                draggable="false"
                class:list={['art-img', i === 0 && 'is-active']}
                style={w.focus ? `object-position: ${w.focus}` : undefined}
                data-art-state={i}
              />
            </picture>
          ))}
          <span class="art-sweep" data-art-sweep />
        </div>
      </div>
    ))
  }
</div>

<!-- Rótulos en capa hermana sobre <main> (z-[15]) para que los fondos no los tapen -->
<div
  class="pointer-events-none fixed inset-0 z-[15] hidden select-none xl:block"
  aria-hidden="true"
  data-art-captions
>
  {
    sides.map(({ side, works }) => (
      <div class={`art-caption-col art-caption-col--${side}`}>
        {works.map((w, i) => (
          <span
            class:list={['art-caption', `art-caption--${side}`, i === 0 && 'is-active']}
            data-art-state={i}
          >
            <span class="art-caption__title">{w.title}</span>
            <span class="art-caption__year">Rembrandt · {w.year}</span>
          </span>
        ))}
      </div>
    ))
  }
</div>

<!-- Móvil y tablet (< 1280px): telón ambiental con 4 obras que se relevan al scroll -->
<div
  class="art-mobile-backdrop pointer-events-none fixed inset-0 z-0 select-none xl:hidden"
  aria-hidden="true"
  data-art-mobile-backdrop
>
  {
    mobileWorks.map((w, i) => (
      <picture>
        <source srcset={artVariant(w.src, 'avif')} type="image/avif" />
        <source srcset={artVariant(w.src, 'webp')} type="image/webp" />
        <img
          src={w.src}
          alt=""
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          draggable="false"
          class:list={['art-mobile-img', i === 0 && 'is-active']}
          style={w.focus ? `object-position: ${w.focus}` : undefined}
          data-art-mobile-state={i}
        />
      </picture>
    ))
  }
</div>

<div
  class="pointer-events-none fixed inset-0 z-0 select-none xl:hidden"
  aria-hidden="true"
  data-art-mobile-captions
>
  {
    mobileWorks.map((w, i) => (
      <span class:list={['art-caption-mobile', i === 0 && 'is-active']} data-art-mobile-state={i}>
        {w.title} · {w.year}
      </span>
    ))
  }
</div>

<script>
  import { initArtBorders } from '../scripts/art-borders';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArtBorders, { once: true });
  } else {
    initArtBorders();
  }
</script>

<style>
  /* ── PC: márgenes de óleo ─────────────────────────────────────── */
  .art-border {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(240px, 22vw, 420px);
    overflow: hidden;
  }
  .art-border--left {
    left: 0;
  }
  .art-border--right {
    right: 0;
  }

  /* Margen extra para que el paralaje (scroll + puntero) nunca muestre bordes */
  .art-parallax {
    position: absolute;
    inset: -7% -4%;
    will-change: transform;
  }

  /* Óleo a color, apenas apagado, que se "enciende" al relevarse */
  .art-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    filter: saturate(0.85) contrast(1.06) brightness(0.32);
    transform: scale(1.06);
    transition:
      opacity var(--duration-slow) var(--ease-oil),
      filter 1.6s var(--ease-oil),
      transform 2.4s var(--ease-cine);
  }
  .art-img.is-active {
    opacity: 0.4;
    filter: saturate(0.85) contrast(1.06) brightness(0.88);
    transform: scale(1);
  }

  /* Veladura ciruela: hunde las sombras del cuadro en la penumbra de la marca */
  .art-parallax::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-plum-ink);
    mix-blend-mode: multiply;
    opacity: 0.35;
  }

  /* Barrido de luz: banda ámbar diagonal que cruza el cuadro en cada relevo */
  .art-sweep {
    position: absolute;
    inset: -20% -40%;
    z-index: 1;
    background: linear-gradient(
      115deg,
      transparent 38%,
      rgb(217 119 6 / 0.16) 48%,
      rgb(244 239 230 / 0.1) 50%,
      rgb(217 119 6 / 0.16) 52%,
      transparent 62%
    );
    mix-blend-mode: screen;
    opacity: 0;
    transform: translate3d(-60%, 0, 0);
  }

  /* Disolución hacia el centro y hacia arriba/abajo, fundida en el carbón */
  .art-border--left .art-parallax,
  .art-border--right .art-parallax {
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  .art-border--left .art-parallax {
    -webkit-mask-image:
      linear-gradient(to right, #000 0%, rgb(0 0 0 / 0.75) 40%, transparent 88%),
      linear-gradient(to bottom, transparent 2%, #000 20%, #000 74%, transparent 94%);
    mask-image:
      linear-gradient(to right, #000 0%, rgb(0 0 0 / 0.75) 40%, transparent 88%),
      linear-gradient(to bottom, transparent 2%, #000 20%, #000 74%, transparent 94%);
  }
  .art-border--right .art-parallax {
    -webkit-mask-image:
      linear-gradient(to left, #000 0%, rgb(0 0 0 / 0.75) 40%, transparent 88%),
      linear-gradient(to bottom, transparent 2%, #000 20%, #000 74%, transparent 94%);
    mask-image:
      linear-gradient(to left, #000 0%, rgb(0 0 0 / 0.75) 40%, transparent 88%),
      linear-gradient(to bottom, transparent 2%, #000 20%, #000 74%, transparent 94%);
  }

  /* ── Rótulos de autor (PC) ────────────────────────────────────── */
  .art-caption-col {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(240px, 22vw, 420px);
  }
  .art-caption-col--left {
    left: 0;
  }
  .art-caption-col--right {
    right: 0;
  }

  .art-caption {
    position: absolute;
    bottom: 3.5rem;
    display: flex;
    gap: 0.9rem;
    align-items: center;
    writing-mode: vertical-rl;
    white-space: nowrap;
    opacity: 0;
    transform: translate3d(0, 0.75rem, 0);
    transition:
      opacity 0.9s var(--ease-cine),
      transform 0.9s var(--ease-cine);
  }
  .art-caption.is-active {
    opacity: 1;
    transform: none;
    transition-delay: 0.35s;
  }
  .art-caption--left {
    left: 1.15rem;
    transform: rotate(180deg) translate3d(0, 0.75rem, 0);
  }
  .art-caption--left.is-active {
    transform: rotate(180deg);
  }
  .art-caption--right {
    right: 1.15rem;
  }
  .art-caption__title {
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: rgb(244 239 230 / 0.62);
  }
  .art-caption__year {
    font-size: 0.6rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgb(217 119 6 / 0.75);
  }

  :global([data-art-captions].at-footer) .art-caption {
    opacity: 0 !important;
    transition: opacity 0.35s ease;
  }

  /* ── Móvil y tablet: telón ────────────────────────────────────── */
  .art-mobile-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    filter: saturate(0.8) brightness(0.32);
    transform: scale(1.05);
    -webkit-mask-image: radial-gradient(
      90% 62% at 50% 36%,
      #000 0%,
      rgb(0 0 0 / 0.6) 45%,
      transparent 90%
    );
    mask-image: radial-gradient(90% 62% at 50% 36%, #000 0%, rgb(0 0 0 / 0.6) 45%, transparent 90%);
    transition:
      opacity var(--duration-slow) var(--ease-oil),
      filter 1.6s var(--ease-oil),
      transform 2.4s var(--ease-cine);
  }
  .art-mobile-img.is-active {
    opacity: 0.24;
    filter: saturate(0.8) brightness(0.85);
    transform: scale(1);
  }
  .art-mobile-backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-plum-ink);
    mix-blend-mode: multiply;
    opacity: 0.4;
  }

  /* Rótulo móvil: vertical, sobre la barra inferior y bajo el contenido */
  .art-caption-mobile {
    position: fixed;
    bottom: 6.5rem;
    right: 0.7rem;
    writing-mode: vertical-rl;
    font-size: 0.58rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgb(244 239 230 / 0.42);
    opacity: 0;
    transition: opacity 0.8s var(--ease-cine);
  }
  .art-caption-mobile.is-active {
    opacity: 1;
  }

  :global([data-art-mobile-captions].at-footer) .art-caption-mobile {
    opacity: 0 !important;
    transition: opacity 0.35s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .art-img,
    .art-mobile-img {
      transform: none;
    }
    .art-sweep {
      display: none;
    }
  }
</style>
